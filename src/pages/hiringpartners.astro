<style>
	* {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	body {
		font-family: "Outfit", "Inter", sans-serif;
		background-color: #ffffff;
		color: #1e293b;
	}

	/* ─────────────────────────────────────────
	   HERO
	───────────────────────────────────────── */
	.hp-hero {
		padding: 64px 40px 40px;
		text-align: center;
		background: #ffffff;
	}

	.hp-title {
		font-size: clamp(2.4rem, 5vw, 3.6rem);
		font-weight: 900;
		color: #0f172a;
		font-family: "Outfit", sans-serif;
		line-height: 1.1;
		margin-bottom: 16px;
	}

	.hp-subtitle {
		font-size: 1.05rem;
		color: #475569;
		font-family: "Outfit", sans-serif;
		font-weight: 400;
	}

	/* ─────────────────────────────────────────
	   LOGO GRID
	───────────────────────────────────────── */
	.hp-grid-section {
		background: #f1f5f9;
		padding: 48px 60px 80px;
	}

	.hp-grid {
		max-width: 1080px;
		margin: 0 auto;
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 16px;
	}

	.hp-card {
		background: #ffffff;
		border-radius: 12px;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 36px 28px;
		min-height: 120px;
		transition: box-shadow 0.25s ease, transform 0.2s ease;
	}

	.hp-card:hover {
		box-shadow: 0 6px 24px rgba(0, 0, 0, 0.08);
		transform: translateY(-2px);
	}

	.hp-card img {
		max-width: 160px;
		max-height: 60px;
		width: 100%;
		height: auto;
		object-fit: contain;
		display: block;
		filter: grayscale(0%);
		transition: filter 0.2s ease;
	}

	/* ─────────────────────────────────────────
	   RESPONSIVE
	───────────────────────────────────────── */
	@media (max-width: 1024px) {
		.hp-grid-section {
			padding: 40px 32px 64px;
		}

		.hp-grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}

	@media (max-width: 768px) {
		.hp-grid {
			grid-template-columns: repeat(2, 1fr);
		}

		.hp-hero {
			padding: 48px 24px 32px;
		}

		.hp-grid-section {
			padding: 32px 20px 48px;
		}
	}

	@media (max-width: 480px) {
		.hp-grid {
			grid-template-columns: repeat(2, 1fr);
			gap: 12px;
		}

		.hp-card {
			padding: 24px 16px;
			min-height: 90px;
		}
	}
</style>
