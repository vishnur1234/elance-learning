		<!-- Script for Scroll Parallax Morphing -->
		<script>
			const wrapper = document.querySelector(
				".morphing-wrapper",
			) as HTMLElement;
			const placeholder = document.querySelector(
				".video-placeholder",
			) as HTMLElement;
			const target = document.querySelector(
				".expanded-video-target",
			) as HTMLElement;
			const video = document.querySelector(
				".video-circle-wrapper",
			) as HTMLElement;
			const iframe = document.querySelector(
				".youtube-circle-iframe",
			) as HTMLElement;
			const leftCol = document.querySelector(".hero-left") as HTMLElement;

			function updateMorph() {
				if (!wrapper || !placeholder || !target || !video || !iframe)
					return;

				if (window.innerWidth <= 992) {
					// Reset inline styling layout for responsive/mobile/tablet
					video.style.position = "relative";
					video.style.left = "";
					video.style.top = "";
					video.style.width = "";
					video.style.height = "";
					video.style.borderRadius = "";
					video.style.transform = "none";
					iframe.style.width = "";
					iframe.style.height = "";
					if (leftCol) {
						leftCol.style.opacity = "";
						leftCol.style.transform = "";
						leftCol.style.visibility = "";
					}
					return;
				}

				// Enable absolute positioning relative to morphing-wrapper
				video.style.position = "absolute";

				const wrapperRect = wrapper.getBoundingClientRect();
				const placeholderRect = placeholder.getBoundingClientRect();
				const targetRect = target.getBoundingClientRect();

				// Absolute Start offset values inside wrapper
				const startLeft = placeholderRect.left - wrapperRect.left;
				const startTop = placeholderRect.top - wrapperRect.top;
				const startWidth = placeholderRect.offsetWidth;
				const startHeight = placeholderRect.offsetHeight;

				// Absolute End offset values inside wrapper
				const endLeft = targetRect.left - wrapperRect.left;
				const endTop = targetRect.top - wrapperRect.top;
				const endWidth = targetRect.offsetWidth;
				const endHeight = targetRect.offsetHeight;

				// Calculate progress purely based on viewport rect offsets to be 100% device & scroll container independent
				const currentScroll = -wrapperRect.top;
				const totalScroll = targetRect.top - 140 + currentScroll;

				let progress = 0;
				if (totalScroll > 0) {
					progress = currentScroll / totalScroll;
				}
				if (progress < 0) progress = 0;
				if (progress > 1) progress = 1;

				// 1. Interpolate left, top, width, height coordinate bounds
				const currentLeft =
					startLeft + (endLeft - startLeft) * progress;
				const currentTop = startTop + (endTop - startTop) * progress;
				const currentWidth =
					startWidth + (endWidth - startWidth) * progress;
				const currentHeight =
					startHeight + (endHeight - startHeight) * progress;

				video.style.left = `${currentLeft}px`;
				video.style.top = `${currentTop}px`;
				video.style.width = `${currentWidth}px`;
				video.style.height = `${currentHeight}px`;

				// 2. Morph border radius: keep it as a capsule/pill (height / 2) for longer, transitioning to 32px near the end
				const currentCapsuleRadius = currentHeight / 2;
				const endRadius = 32; // target corner radius (32px)
				const radiusProgress = Math.pow(progress, 2.5); // non-linear transition to keep it capsule-like longer
				const currentRadius =
					currentCapsuleRadius +
					(endRadius - currentCapsuleRadius) * radiusProgress;

				// Set border radius on container and directly on iframe to ensure browser clipping handles iframe content correctly
				video.style.borderRadius = `${currentRadius}px`;
				iframe.style.borderRadius = `${currentRadius}px`;

				// 3. Keep the video centered and cropping like object-fit: cover for a 16:9 ratio to avoid any black bars
				const containerRatio = currentWidth / currentHeight;
				const targetRatio = 16 / 9;
				if (containerRatio > targetRatio) {
					iframe.style.width = "100%";
					iframe.style.height = `${(containerRatio / targetRatio) * 100}%`;
				} else {
					iframe.style.width = `${(targetRatio / containerRatio) * 100}%`;
					iframe.style.height = "100%";
				}
			}

			let ticking = false;
			function onScroll() {
				if (!ticking) {
					window.requestAnimationFrame(() => {
						updateMorph();
						ticking = false;
					});
					ticking = true;
				}
			}

			// Listen to window scrolling, resizing, and loading
			window.addEventListener("scroll", onScroll, { passive: true });
			window.addEventListener("resize", onScroll, { passive: true });
			window.addEventListener("load", updateMorph);

			// Call updateMorph on page load
			updateMorph();
			window.addEventListener("DOMContentLoaded", updateMorph);
			setTimeout(updateMorph, 200);
		</script>

