---
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Transform your career with CMA USA | Elance</title>
		<meta
			name="description"
			content="Elance – Gold CMA Course Provider. Transform your career with CMA USA. HOCK International partner, IMA authorized, 25000+ students globally."
		/>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,600&family=Outfit:wght@300;400;500;600;700;800;900&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<Nav />

		<!-- ===================== TOP BANNER ===================== -->
		<div class="enrollment-banner">
			<div class="banner-badge">Enrollment closes soon</div>
		</div>

		<!-- ===================== CMA HERO – STICKY SCROLL ===================== -->
		<section class="cma-hero-section">
			<div class="cma-hero-inner">

				<!-- LEFT: Sticky content -->
				<div class="cma-hero-left">
					<h1 class="cma-hero-title">
						Transform your<br />
						career and lead the<br />
						finance world with<br />
						<span class="text-blue">CMA USA.</span>
					</h1>

					<!-- Badges row -->
					<div class="cma-badges-row">
						<img
							src="/src/Assets/CMA-gold-1-e1762840636945.png"
							alt="Gold CMA Course Provider – IMA"
							class="cma-badge-img gold-badge"
						/>
						<img
							src="/src/Assets/courses/Hock.png"
							alt="HOCK International"
							class="cma-badge-img hock-badge"
						/>
						<img
							src="/src/Assets/aswathi-CMA.jpg"
							alt="IMA"
							class="cma-badge-img ima-badge"
							style="display:none"
						/>
					</div>

					<!-- IMA logo separate row -->
					<div class="cma-ima-row">
						<img
							src="/src/Assets/courses/Silver-CMA.png"
							alt="IMA Authorized Partner"
							class="ima-logo"
						/>
					</div>

					<!-- Trusted by students -->
					<div class="student-proof">
						<p class="proof-label">
							TRUSTED BY OVER <span class="highlight-blue">25000</span><br />
							STUDENTS GLOBALLY FOR EXCELLENCE!
						</p>
						<div class="avatar-stack">
							<img src="/src/Assets/Ajsal-E.webp" alt="Student" class="avatar-img" />
							<img src="/src/Assets/Anuradha.webp" alt="Student" class="avatar-img" />
							<img src="/src/Assets/Bijini-Koshi.webp" alt="Student" class="avatar-img" />
							<img src="/src/Assets/Jishana-T.webp" alt="Student" class="avatar-img" />
							<img src="/src/Assets/Kashinath.webp" alt="Student" class="avatar-img" />
							<img src="/src/Assets/Thanha-Kadeeja-K.webp" alt="Student" class="avatar-img" />
						</div>
					</div>

					<!-- Corporate logos -->
					<div class="corporate-logos-row">
						<span class="corp-logo-text corp-ey-logo">e.</span>
						<img src="/src/Assets/pwc.png" alt="PwC" class="corp-logo" />
						<span class="corp-logo-text infosys-text">Infosys</span>
						<span class="corp-logo-text kpmg-text">KPMG</span>
						<img src="/src/Assets/deloitte.png" alt="Deloitte" class="corp-logo" />
					</div>
				</div>

				<!-- RIGHT: Hero Visual -->
				<div class="cma-hero-right">
					<div class="cma-img-frame circle-frame">
						<iframe
							src="https://www.youtube.com/embed/fSmpRKXSJS0?autoplay=1&mute=1&loop=1&playlist=fSmpRKXSJS0&start=5"
							title="CMA USA – Elance"
							frameborder="0"
							allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
							allowfullscreen
							class="scroll-iframe"
						></iframe>
					</div>
				</div>

			</div>
		</section>

		<!-- ===================== STATS SECTION ===================== -->
		<section class="cma-stats-section">
			<div class="cma-stats-container">
				<div class="cma-stat-card">
					<span class="cma-stat-num">5</span>
					<span class="cma-stat-label">Years</span>
				</div>
				<div class="cma-stat-divider"></div>
				<div class="cma-stat-card">
					<span class="cma-stat-num">49</span>
					<span class="cma-stat-label">World Ranks</span>
				</div>
				<div class="cma-stat-divider"></div>
				<div class="cma-stat-card">
					<span class="cma-stat-num">76</span>
					<span class="cma-stat-label">National<br/>Ranks</span>
				</div>
				<div class="cma-stat-divider"></div>
				<div class="cma-stat-card">
					<span class="cma-stat-num">5000+</span>
					<span class="cma-stat-label">Affiliates</span>
				</div>
				<div class="cma-stat-divider"></div>
				<div class="cma-stat-card">
					<span class="cma-stat-num">25,000</span>
					<span class="cma-stat-label">Students</span>
				</div>
			</div>
		</section>

		<!-- ===================== BE THE PROFESSIONAL SECTION ===================== -->
		<section class="professional-section">
			<div class="professional-container">
				<div class="pro-left">
					<h2 class="pro-title">
						Be the <span class="text-muted-blue">Professional</span> the<br/>
						World Is <span class="text-muted-blue">Looking For!</span>
					</h2>
					<div class="pro-badges">
						<img src="/src/Assets/CMA-gold-1-e1762840636945.png" alt="Gold CMA Course Provider" class="pro-badge gold" />
						<img src="/src/Assets/courses/Silver-CMA.png" alt="IMA" class="pro-badge ima" />
					</div>
				</div>
				<div class="pro-right">
					<div class="pro-check-item">
						<span class="pro-check-icon"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#3b9fe8" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg></span>
						<span>Recognition in over 160 countries world-wide.</span>
					</div>
					<div class="pro-check-item">
						<span class="pro-check-icon"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#3b9fe8" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg></span>
						<span>Join a network of influential finance professionals.</span>
					</div>
					<div class="pro-check-item">
						<span class="pro-check-icon"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#3b9fe8" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg></span>
						<span>Stay in demand with skills valued internationally.</span>
					</div>
					<div class="pro-check-item">
						<span class="pro-check-icon"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#3b9fe8" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg></span>
						<span>Upskill your way to a leadership role in the finance industry.</span>
					</div>
					<div class="pro-check-item">
						<span class="pro-check-icon"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#3b9fe8" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg></span>
						<span>High earning potential from ₹4 LPA to ₹20LPA.</span>
					</div>
				</div>
			</div>
		</section>

		<!-- ===================== OUR STUDENTS MADE IT ===================== -->
		<section class="made-it-section">
			<div class="made-it-container">
				<h2 class="made-it-title">Our Students Made It – <span class="text-blue">Now It's Your Turn!</span></h2>
				<div class="placement-logos-grid">
					<div class="logo-cell"><span class="logo-txt bakertilly-txt">&#10022; bakertilly</span></div>
					<div class="logo-cell"><span class="logo-txt rsm-txt"><span style="color:#8bc34a;font-weight:900">▪▪▪</span> RSM</span></div>
					<div class="logo-cell"><span class="logo-txt bdo-txt"><span style="color:#c00;font-weight:900">|</span>BDO</span></div>
					<div class="logo-cell"><span class="logo-txt gt-txt">&#9898; Grant Thornton</span></div>
					<div class="logo-cell"><span class="logo-txt deloitte-txt">Deloitte.</span></div>
					<div class="logo-cell"><span class="logo-txt kpmg-txt">KPMG</span></div>
					<div class="logo-cell"><span class="logo-txt ey-txt">EY</span></div>
					<div class="logo-cell"><img src="/src/Assets/pwc.png" alt="PwC" class="cell-logo-img" /></div>
					<div class="logo-cell"><span class="logo-txt citi-txt"><span style="color:#003b8e">citi</span>bank</span></div>
					<div class="logo-cell"><span class="logo-txt acc-txt">accenture<span style="color:#a100ff">›</span></span></div>
				</div>
			</div>
		</section>

		<!-- ===================== LAND YOUR DREAM CAREER ===================== -->
		<section class="dream-section">
			<div class="dream-container">
				<div class="dream-left">
					<h2 class="dream-title">Land your <span class="text-blue">Dream Career</span></h2>
					<div class="dream-accordion">
						<div class="dream-item active">
							<button class="dream-header">
								<span class="dream-icon"><svg class="d-minus" viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2.5" fill="none"><line x1="5" y1="12" x2="19" y2="12"></line></svg><svg class="d-plus" viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2.5" fill="none"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg></span>
								<span class="dream-label">Financial Controller</span>
							</button>
							<div class="dream-content"><p>As a financial controller, CMA graduates oversee financial reporting, budgeting, and strategic planning, ensuring the financial health and compliance of an organization while providing key insights for decision-making.</p></div>
						</div>
						<div class="dream-item">
							<button class="dream-header">
								<span class="dream-icon"><svg class="d-minus" viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2.5" fill="none"><line x1="5" y1="12" x2="19" y2="12"></line></svg><svg class="d-plus" viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2.5" fill="none"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg></span>
								<span class="dream-label">Audit Manager</span>
							</button>
							<div class="dream-content"><p>CMA professionals serve as audit managers, leading audit teams in assessing financial controls, compliance, and risk management to ensure organizational integrity.</p></div>
						</div>
						<div class="dream-item">
							<button class="dream-header">
								<span class="dream-icon"><svg class="d-minus" viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2.5" fill="none"><line x1="5" y1="12" x2="19" y2="12"></line></svg><svg class="d-plus" viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2.5" fill="none"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg></span>
								<span class="dream-label">Tax Consultant</span>
							</button>
							<div class="dream-content"><p>CMA holders work as tax consultants, advising businesses and individuals on tax strategy and compliance to minimize liabilities while maximizing financial efficiency.</p></div>
						</div>
						<div class="dream-item">
							<button class="dream-header">
								<span class="dream-icon"><svg class="d-minus" viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2.5" fill="none"><line x1="5" y1="12" x2="19" y2="12"></line></svg><svg class="d-plus" viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2.5" fill="none"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg></span>
								<span class="dream-label">Management Accountant</span>
							</button>
							<div class="dream-content"><p>As management accountants, CMA professionals analyze financial data, prepare reports, and support strategic decisions to drive organizational performance and profitability.</p></div>
						</div>
						<div class="dream-item">
							<button class="dream-header">
								<span class="dream-icon"><svg class="d-minus" viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2.5" fill="none"><line x1="5" y1="12" x2="19" y2="12"></line></svg><svg class="d-plus" viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2.5" fill="none"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg></span>
								<span class="dream-label">Financial Analyst</span>
							</button>
							<div class="dream-content"><p>Financial analysts with a CMA credential evaluate investment opportunities, forecast performance, and guide capital allocation decisions for businesses and investors alike.</p></div>
						</div>
						<div class="dream-item">
							<button class="dream-header">
								<span class="dream-icon"><svg class="d-minus" viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2.5" fill="none"><line x1="5" y1="12" x2="19" y2="12"></line></svg><svg class="d-plus" viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2.5" fill="none"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg></span>
								<span class="dream-label">Corporate Treasurer</span>
							</button>
							<div class="dream-content"><p>Corporate treasurers manage a company's liquidity, funding, and financial risk, drawing on CMA training to make sound decisions about cash flow and capital structure.</p></div>
						</div>
						<div class="dream-item">
							<button class="dream-header">
								<span class="dream-icon"><svg class="d-minus" viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2.5" fill="none"><line x1="5" y1="12" x2="19" y2="12"></line></svg><svg class="d-plus" viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2.5" fill="none"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg></span>
								<span class="dream-label">Budget Analyst</span>
							</button>
							<div class="dream-content"><p>Budget analysts use CMA-level expertise to build, review, and manage organizational budgets, helping leadership plan spending and track performance against targets.</p></div>
						</div>
						<div class="dream-item">
							<button class="dream-header">
								<span class="dream-icon"><svg class="d-minus" viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2.5" fill="none"><line x1="5" y1="12" x2="19" y2="12"></line></svg><svg class="d-plus" viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2.5" fill="none"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg></span>
								<span class="dream-label">Internal Auditor</span>
							</button>
							<div class="dream-content"><p>Internal auditors with a CMA background review internal controls and processes, identifying risks and recommending improvements to protect organizational assets.</p></div>
						</div>
						<div class="dream-item">
							<button class="dream-header">
								<span class="dream-icon"><svg class="d-minus" viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2.5" fill="none"><line x1="5" y1="12" x2="19" y2="12"></line></svg><svg class="d-plus" viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2.5" fill="none"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg></span>
								<span class="dream-label">Risk & Compliance Manager</span>
							</button>
							<div class="dream-content"><p>Risk & compliance managers apply CMA skills to identify financial risks and ensure the organization meets regulatory and reporting requirements.</p></div>
						</div>
						<div class="dream-item">
							<button class="dream-header">
								<span class="dream-icon"><svg class="d-minus" viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2.5" fill="none"><line x1="5" y1="12" x2="19" y2="12"></line></svg><svg class="d-plus" viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2.5" fill="none"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg></span>
								<span class="dream-label">Financial Consultant</span>
							</button>
							<div class="dream-content"><p>Financial consultants advise organizations and individuals on financial strategy, planning, and investment decisions, backed by CMA-level analytical training.</p></div>
						</div>
						<div class="dream-item">
							<button class="dream-header">
								<span class="dream-icon"><svg class="d-minus" viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2.5" fill="none"><line x1="5" y1="12" x2="19" y2="12"></line></svg><svg class="d-plus" viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2.5" fill="none"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg></span>
								<span class="dream-label">Chief Financial Officer (CFO)</span>
							</button>
							<div class="dream-content"><p>Many CMA graduates rise to become CFOs, leading the overall financial strategy, reporting, and governance of an organization at the executive level.</p></div>
						</div>
					</div>
				</div>

				<div class="dream-right">
					<div class="contact-form-box">
						<div class="form-field">
							<label class="form-label">Full Name</label>
							<input type="text" class="form-input" id="cma-name" />
						</div>
						<div class="form-field">
							<label class="form-label">Email</label>
							<input type="email" class="form-input" id="cma-email" />
						</div>
						<div class="form-field">
							<label class="form-label">Mobile</label>
							<input type="tel" class="form-input" id="cma-mobile" />
						</div>
						<div class="form-field">
							<label class="form-label">Message</label>
							<textarea class="form-input form-textarea" id="cma-message" rows="4"></textarea>
						</div>
						<div class="form-consent">
							<input type="checkbox" id="cma-consent" class="consent-checkbox" />
							<label for="cma-consent" class="consent-label">I authorise Elance Learning and its representatives to contact me with updates and notifications via Email, SMS, WhatsApp, and phone calls. This consent overrides DND/NDNC preferences. I have read and agree to the Terms &amp; Conditions and Privacy Policy.</label>
						</div>
						<button class="form-submit-btn">Submit</button>
					</div>

					<button class="download-brochure-btn">Download Brochure</button>

					<div class="why-elance-box">
						<h3 class="why-elance-title">Why Elance?</h3>
						<ul class="why-elance-list">
							<li><span class="why-arrow">&rsaquo;</span>Exceptional Faculty Standards With 8+ Years of Experience</li>
							<li><span class="why-arrow">&rsaquo;</span>Outstanding Track Record of Achievements</li>
							<li><span class="why-arrow">&rsaquo;</span>Gold Approved Learning Partner of IMA</li>
							<li><span class="why-arrow">&rsaquo;</span>Approved Partner of Hock International</li>
							<li><span class="why-arrow">&rsaquo;</span>Guaranteed Placement Assistance</li>
							<li><span class="why-arrow">&rsaquo;</span>Comprehensive Support from Faculties, Mentors & Coordinators</li>
							<li><span class="why-arrow">&rsaquo;</span>Offline, Online & Hybrid Classes</li>
							<li><span class="why-arrow">&rsaquo;</span>24/7 Access to Elance Learning App</li>
							<li><span class="why-arrow">&rsaquo;</span>Prime & Prime + Programs for Advanced Learning</li>
							<li><span class="why-arrow">&rsaquo;</span>Hassle-free Hostel Facility and Safe Transportation Service</li>
						</ul>
					</div>
				</div>
			</div>
		</section>

		<script>
			document.querySelectorAll('.dream-header').forEach(header => {
				header.addEventListener('click', () => {
					const item = header.parentElement;
					const isActive = item?.classList.contains('active');
					document.querySelectorAll('.dream-item').forEach(el => el.classList.remove('active'));
					if (!isActive && item) item.classList.add('active');
				});
			});
		</script>

		<Footer />
	</body>
</html>


<style>
	/* ── RESET & FONTS ── */
	* {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	body {
		font-family: "Outfit", "Inter", sans-serif;
		background-color: #ffffff;
		color: #1e293b;
	}

	.text-blue {
		color: #3b9fe8;
	}
	.text-muted-blue {
		color: #7a93ab;
	}
	.highlight-blue {
		color: #3b9fe8;
	}

	/* ── ENROLLMENT BANNER ── */
	.enrollment-banner {
		background: #e0f2fe;
		padding: 12px 20px;
		text-align: center;
	}
	.banner-badge {
		font-size: 0.95rem;
		font-weight: 600;
		color: #1e293b;
		letter-spacing: 0.2px;
	}

	/* ─────────────────────────────────────────
	   CMA HERO SECTION — Sticky-scroll layout
	───────────────────────────────────────── */
	.cma-hero-section {
		width: 100%;
		background: #ffffff;
		padding: 0;
	}

	.cma-hero-inner {
		max-width: 1200px;
		margin: 0 auto;
		padding: 60px 40px 0;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 60px;
		align-items: start;
		position: relative;
	}

	/* LEFT column — sticky while user scrolls right panels */
	.cma-hero-left {
		position: sticky;
		top: 80px;
		padding-bottom: 80px;
		align-self: start;
	}

	.cma-hero-title {
		font-size: clamp(2rem, 4vw, 3.2rem);
		font-weight: 800;
		color: #1e293b;
		line-height: 1.18;
		margin-bottom: 40px;
		font-family: "Outfit", sans-serif;
	}

	/* Badges (Gold CMA + HOCK) */
	.cma-badges-row {
		display: flex;
		align-items: center;
		gap: 16px;
		margin-bottom: 10px;
