---
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Transform your career with CMA USA | Elance</title>
		<meta
			name="description"
			content="Elance – Gold CMA Course Provider. Transform your career with CMA USA. HOCK International partner, IMA authorized, 25000+ students globally."
		/>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,600&family=Outfit:wght@300;400;500;600;700;800;900&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<Nav />

		<!-- ===================== TOP BANNER ===================== -->
		<div class="enrollment-banner">
			<div class="banner-badge">Enrollment closes soon</div>
		</div>

		<!-- ===================== CMA HERO – STICKY SCROLL ===================== -->
		<section class="cma-hero-section">
			<div class="cma-hero-inner">
				<!-- LEFT: Sticky content -->
				<div class="cma-hero-left">
					<h1 class="cma-hero-title">
						Transform your<br />
						career and lead the<br />
						finance world with<br />
						<span class="text-blue">CMA USA.</span>
					</h1>

					<!-- Badges row -->
					<div class="cma-badges-row">
						<img
							src="/src/Assets/CMA-gold-1-e1762840636945.png"
							alt="Gold CMA Course Provider – IMA"
							class="cma-badge-img gold-badge"
						/>
						<img
							src="/src/Assets/courses/Hock.png"
							alt="HOCK International"
							class="cma-badge-img hock-badge"
						/>
						<img
							src="/src/Assets/aswathi-CMA.jpg"
							alt="IMA"
							class="cma-badge-img ima-badge"
							style="display:none"
						/>
					</div>

					<!-- IMA logo separate row -->
					<div class="cma-ima-row">
						<img
							src="/src/Assets/courses/Silver-CMA.png"
							alt="IMA Authorized Partner"
							class="ima-logo"
						/>
					</div>

					<!-- Trusted by students -->
					<div class="student-proof">
						<p class="proof-label">
							TRUSTED BY OVER <span class="highlight-blue"
								>25000</span
							><br />
							STUDENTS GLOBALLY FOR EXCELLENCE!
						</p>
						<div class="avatar-stack">
							<img
								src="/src/Assets/Ajsal-E.webp"
								alt="Student"
								class="avatar-img"
							/>
							<img
								src="/src/Assets/Anuradha.webp"
								alt="Student"
								class="avatar-img"
							/>
							<img
								src="/src/Assets/Bijini-Koshi.webp"
								alt="Student"
								class="avatar-img"
							/>
							<img
								src="/src/Assets/Jishana-T.webp"
								alt="Student"
								class="avatar-img"
							/>
							<img
								src="/src/Assets/Kashinath.webp"
								alt="Student"
								class="avatar-img"
							/>
							<img
								src="/src/Assets/Thanha-Kadeeja-K.webp"
								alt="Student"
								class="avatar-img"
							/>
						</div>
					</div>

					<!-- Corporate logos -->
					<div class="corporate-logos-row">
						<span class="corp-logo-text corp-ey-logo">e.</span>
						<img
							src="/src/Assets/pwc.png"
							alt="PwC"
							class="corp-logo"
						/>
						<span class="corp-logo-text infosys-text">Infosys</span>
						<span class="corp-logo-text kpmg-text">KPMG</span>
						<img
							src="/src/Assets/deloitte.png"
							alt="Deloitte"
							class="corp-logo"
						/>
					</div>
				</div>

				<!-- RIGHT: Hero Visual -->
				<div class="cma-hero-right">
					<div class="cma-img-frame circle-frame">
						<iframe
							src="https://www.youtube.com/embed/fSmpRKXSJS0?autoplay=1&mute=1&loop=1&playlist=fSmpRKXSJS0&start=5"
							title="CMA USA – Elance"
							frameborder="0"
							allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
							allowfullscreen
							class="scroll-iframe"></iframe>
					</div>
				</div>
			</div>
		</section>

		<!-- ===================== STATS SECTION ===================== -->
		<section class="cma-stats-section">
			<div class="cma-stats-container">
				<div class="stat-card">
					<span class="stat-num"
						>25<span class="stat-plus">K+</span></span
					>
					<span class="stat-label">Students Enrolled</span>
				</div>
				<div class="stat-divider"></div>
				<div class="stat-card">
					<span class="stat-num"
						>13<span class="stat-plus">+</span></span
					>
					<span class="stat-label">Years of Excellence</span>
				</div>
				<div class="stat-divider"></div>
				<div class="stat-card">
					<span class="stat-num"
						>98<span class="stat-plus">%</span></span
					>
					<span class="stat-label">Pass Rate</span>
				</div>
				<div class="stat-divider"></div>
				<div class="stat-card">
					<span class="stat-num"
						>500<span class="stat-plus">+</span></span
					>
					<span class="stat-label">CMA Qualified</span>
				</div>
			</div>
		</section>

		<Footer />
	</body>
</html>

<style>
	/* ── RESET & FONTS ── */
	* {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	body {
		font-family: "Outfit", "Inter", sans-serif;
		background-color: #ffffff;
		color: #1e293b;
	}

	.text-blue {
		color: #3b9fe8;
	}
	.highlight-blue {
		color: #3b9fe8;
	}

	/* ── ENROLLMENT BANNER ── */
	.enrollment-banner {
		background: #e0f2fe;
		padding: 12px 20px;
		text-align: center;
	}
	.banner-badge {
		font-size: 0.95rem;
		font-weight: 600;
		color: #1e293b;
		letter-spacing: 0.2px;
	}

	/* ─────────────────────────────────────────
	   CMA HERO SECTION — Sticky-scroll layout
	───────────────────────────────────────── */
	.cma-hero-section {
		width: 100%;
		background: #ffffff;
		padding: 0;
	}

	.cma-hero-inner {
		max-width: 1200px;
		margin: 0 auto;
		padding: 60px 40px 0;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 60px;
		align-items: start;
		position: relative;
	}

	/* LEFT column — sticky while user scrolls right panels */
	.cma-hero-left {
		position: sticky;
		top: 80px;
		padding-bottom: 80px;
		align-self: start;
	}

	.cma-hero-title {
		font-size: clamp(2rem, 4vw, 3.2rem);
		font-weight: 800;
		color: #1e293b;
		line-height: 1.18;
		margin-bottom: 40px;
		font-family: "Outfit", sans-serif;
	}

	/* Badges (Gold CMA + HOCK) */
	.cma-badges-row {
		display: flex;
		align-items: center;
		gap: 16px;
		margin-bottom: 10px;
		flex-wrap: wrap;
	}

	.cma-badge-img {
		object-fit: contain;
	}

	.gold-badge {
		height: 64px;
		width: auto;
	}

	.hock-badge {
		height: 48px;
		width: auto;
	}

	/* IMA logo row */
	.cma-ima-row {
		margin-bottom: 28px;
	}

	.ima-logo {
		height: 48px;
		width: auto;
		object-fit: contain;
		border: 1.5px solid #e2e8f0;
		border-radius: 6px;
		padding: 4px 10px;
		background: #fff;
	}

	/* Student proof */
	.student-proof {
		display: flex;
		align-items: center;
		gap: 16px;
		margin-bottom: 28px;
	}

	.proof-label {
		font-size: 0.8rem;
		font-weight: 700;
		color: #1e293b;
		text-transform: uppercase;
		letter-spacing: 0.3px;
		line-height: 1.5;
	}

	.avatar-stack {
		display: flex;
		align-items: center;
	}

	.avatar-img {
		width: 36px;
		height: 36px;
		border-radius: 50%;
		border: 2px solid #fff;
		object-fit: cover;
		margin-left: -10px;
		box-shadow: 0 1px 4px rgba(0, 0, 0, 0.12);
	}

	.avatar-img:first-child {
		margin-left: 0;
	}

	/* Corporate logos */
	.corporate-logos-row {
		display: flex;
		align-items: center;
		gap: 20px;
		flex-wrap: wrap;
	}

	.corp-logo {
		height: 22px;
		width: auto;
		object-fit: contain;
		opacity: 0.7;
	}

	.corp-logo-text {
		font-size: 1rem;
		font-weight: 700;
		color: #64748b;
	}

	.corp-ey-logo {
		font-style: italic;
		font-size: 1.2rem;
		font-weight: 900;
		color: #f5a623;
	}

	.infosys-text {
		color: #1e293b;
	}

	.kpmg-text {
		color: #0066cc;
		font-weight: 800;
	}

	/* ── RIGHT COLUMN ── */
	.cma-hero-right {
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 40px 0;
	}

	/* Individual image frame — just show it directly */
	.cma-img-frame {
		display: flex;
		align-items: center;
		justify-content: center;
	}

	/* Circle frame */
	.circle-frame {
		border-radius: 50%;
		overflow: hidden;
		width: 420px;
		height: 420px;
		flex-shrink: 0;
		box-shadow: 0 20px 60px rgba(0, 0, 0, 0.14);
	}

	/* Rounded rect */
	.rect-frame {
		border-radius: 40px;
		overflow: hidden;
		width: 480px;
		height: 420px;
		flex-shrink: 0;
		box-shadow: 0 20px 60px rgba(0, 0, 0, 0.14);
	}

	/* Wide full image */
	.wide-frame {
		border-radius: 24px;
		overflow: hidden;
		width: 100%;
		max-width: 560px;
		height: 360px;
		border: 3px solid #1e293b;
		box-shadow: 0 20px 60px rgba(0, 0, 0, 0.14);
	}

	.scroll-img,
	.scroll-video {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.scroll-iframe {
		width: 100%;
		height: 100%;
		border: none;
		display: block;
		/* YouTube iframe needs extra scale to hide black bars */
		transform: scale(1.05);
	}

	/* Invisible spacer panels driving the scroll */
	.scroll-panel {
		height: 100vh;
		width: 100%;
	}

	/* ── STATS SECTION ── */
	.cma-stats-section {
		padding: 64px 0;
		background: #f8fafc;
		border-top: 1px solid #e2e8f0;
		border-bottom: 1px solid #e2e8f0;
	}

	.cma-stats-container {
		max-width: 1000px;
		margin: 0 auto;
		padding: 0 40px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 32px;
	}

	.stat-card {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 6px;
		text-align: center;
	}

	.stat-num {
		font-size: clamp(2.2rem, 4vw, 3rem);
		font-weight: 800;
		color: #1e293b;
		font-family: "Outfit", sans-serif;
		line-height: 1;
	}

	.stat-plus {
		font-size: 1.6rem;
		color: #3b9fe8;
	}

	.stat-label {
		font-size: 0.9rem;
		font-weight: 600;
		color: #64748b;
		text-transform: uppercase;
		letter-spacing: 0.5px;
	}

	.stat-divider {
		width: 1px;
		height: 60px;
		background: #e2e8f0;
		flex-shrink: 0;
	}

	/* ── RESPONSIVE ── */
	@media (max-width: 1024px) {
		.cma-hero-inner {
			grid-template-columns: 1fr;
			padding: 40px 24px 0;
		}

		.cma-hero-left {
			position: static;
			padding-bottom: 0;
		}

		.cma-hero-right {
			min-height: auto;
		}

		.cma-scroll-sticky {
			position: static;
			height: auto;
			margin-top: 40px;
		}

		.cma-image-display {
			position: relative;
			height: 340px;
		}

		.cma-img-frame {
			position: absolute;
		}

		.circle-frame,
		.rect-frame {
			width: 100%;
			max-width: 360px;
			height: 340px;
		}

		.wide-frame {
			height: 280px;
		}

		.scroll-panel {
			display: none;
		}
	}

	@media (max-width: 600px) {
		.cma-hero-title {
			font-size: 2rem;
		}

		.cma-stats-container {
			flex-wrap: wrap;
			justify-content: center;
			gap: 24px;
		}

		.stat-divider {
			display: none;
		}

		.corporate-logos-row {
			gap: 12px;
		}
	}
</style>
