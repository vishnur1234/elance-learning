---
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import StudentPlacements from "../components/StudentPlacements.astro";
import CareerAndWhyElance from "../components/CareerAndWhyElance.astro";
import CmaFaculties from "../components/CmaFaculties.astro";
import CmaLearningAndSyllabus from "../components/CmaLearningAndSyllabus.astro";
import { getEmDashEntry } from "../lib/cms.js";

// Fetch the CMA page's dynamic content from EmDash CMS (same "pages"
// collection the home/acca pages use, with slug "cma").
const { entry: cmaPage } = await getEmDashEntry("pages", "cma").catch(() => ({
	entry: null,
}));
const cmaData = (cmaPage?.data as Record<string, any>) || {};
const edit = cmaPage?.edit || ({} as Record<string, any>);

const bannerText = String(cmaData.banner_text || "Enrollment closes soon");
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Transform your career with CMA USA | Elance</title>
		<meta
			name="description"
			content="Elance – Gold CMA Course Provider. Transform your career with CMA USA. HOCK International partner, IMA authorized, 25000+ students globally."
		/>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,600&family=Outfit:wght@300;400;500;600;700;800;900&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<Nav />

		<!-- ===================== TOP BANNER ===================== -->
		<div class="enrollment-banner">
			<div class="banner-badge" {...edit.banner_text}>{bannerText}</div>
		</div>

		<!-- ===================== CMA HERO – STICKY SCROLL (MORPHING VIDEO) ===================== -->
		<div class="morphing-wrapper">
			<section class="cma-hero-section">
				<div class="cma-hero-inner">
					<!-- LEFT: Sticky content -->
					<div class="cma-hero-left">
						<h1 class="cma-hero-title">
							Transform your<br />
							career and lead the<br />
							finance world with<br />
							<span class="text-blue">CMA USA.</span>
						</h1>

						<!-- Badges row -->
						<div class="cma-badges-row">
							<img
								src="/images/CMA-gold-1-e1762840636945.png"
								alt="Gold CMA Course Provider – IMA"
								class="cma-badge-img gold-badge"
							/>
							<img
								src="/images/courses/Hock.png"
								alt="HOCK International"
								class="cma-badge-img hock-badge"
							/>
							<img
								src="/images/aswathi-CMA.jpg"
								alt="IMA"
								class="cma-badge-img ima-badge"
								style="display:none"
							/>
						</div>

						<!-- IMA logo separate row -->
						<div class="cma-ima-row">
							<img
								src="/images/courses/Silver-CMA.png"
								alt="IMA Authorized Partner"
								class="ima-logo"
							/>
						</div>

						<!-- Trusted by students -->
						<div class="student-proof">
							<p class="proof-label">
								TRUSTED BY OVER <span class="highlight-blue"
									>25000</span
								><br />
								STUDENTS GLOBALLY FOR EXCELLENCE!
							</p>
							<div class="avatar-stack">
								<img
									src="/images/Ajsal-E.webp"
									alt="Student"
									class="avatar-img"
								/>
								<img
									src="/images/Anuradha.webp"
									alt="Student"
									class="avatar-img"
								/>
								<img
									src="/images/Bijini-Koshi.webp"
									alt="Student"
									class="avatar-img"
								/>
								<img
									src="/images/Jishana-T.webp"
									alt="Student"
									class="avatar-img"
								/>
								<img
									src="/images/Kashinath.webp"
									alt="Student"
									class="avatar-img"
								/>
								<img
									src="/images/Thanha-Kadeeja-K.webp"
									alt="Student"
									class="avatar-img"
								/>
							</div>
						</div>

						<!-- Corporate logos -->
						<div class="corporate-logos-row">
							<span class="corp-logo-text corp-ey-logo">e.</span>
							<img
								src="/images/pwc.png"
								alt="PwC"
								class="corp-logo"
							/>
							<span class="corp-logo-text infosys-text"
								>Infosys</span
							>
							<span class="corp-logo-text kpmg-text">KPMG</span>
							<img
								src="/images/deloitte.png"
								alt="Deloitte"
								class="corp-logo"
							/>
						</div>
					</div>

					<!-- RIGHT: Hero Visual (morph start point — stays invisible, just holds the starting size/position) -->
					<div class="cma-hero-right">
						<div class="video-placeholder"></div>
					</div>
				</div>
			</section>

			<!-- Target area the circle morphs into as the user scrolls -->
			<section class="video-expanded-section">
				<div class="video-expanded-inner">
					<div class="expanded-video-target"></div>
				</div>
			</section>

			<!-- The actual video element — absolutely positioned and animated between the two targets above -->
			<div class="video-circle-wrapper">
				<iframe
					src="https://www.youtube.com/embed/fSmpRKXSJS0?autoplay=1&mute=1&loop=1&playlist=fSmpRKXSJS0&start=5"
					title="CMA USA – Elance"
					allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
					allowfullscreen
					class="youtube-circle-iframe"></iframe>
			</div>
		</div>
		<!-- /morphing-wrapper -->

		<!-- Script for Scroll Morphing (circle → full-width video) -->
		<script>
			const wrapper =
				document.querySelector<HTMLElement>(".morphing-wrapper");
			const placeholder =
				document.querySelector<HTMLElement>(".video-placeholder");
			const target = document.querySelector<HTMLElement>(
				".expanded-video-target",
			);
			const video = document.querySelector<HTMLElement>(
				".video-circle-wrapper",
			);
			const iframe = document.querySelector<HTMLIFrameElement>(
				".youtube-circle-iframe",
			);
			const leftCol =
				document.querySelector<HTMLElement>(".cma-hero-left");

			// Cached document-relative metrics. Re-measured on load/resize
			// and whenever images finish loading (badges/avatars/logos can
			// shift the layout height after the first paint).
			interface Metrics {
				wrapperDocTop: number;
				startLeft: number;
				startTop: number;
				startWidth: number;
				startHeight: number;
				endLeft: number;
				endTop: number;
				endWidth: number;
				endHeight: number;
				targetDocTop: number;
			}
			let metrics: Metrics | null = null;
			let isMobileLayout = false;

			function measure() {
				if (!wrapper || !placeholder || !target) return;

				const scrollY = window.scrollY || window.pageYOffset;
				const wrapperRect = wrapper.getBoundingClientRect();
				const placeholderRect = placeholder.getBoundingClientRect();
				const targetRect = target.getBoundingClientRect();

				metrics = {
					// Document-relative top of the morph wrapper.
					wrapperDocTop: wrapperRect.top + scrollY,
					// Circle start position/size, relative to the wrapper.
					startLeft: placeholderRect.left - wrapperRect.left,
					startTop: placeholderRect.top - wrapperRect.top,
					startWidth: placeholderRect.width,
					startHeight: placeholderRect.height,
					// Full-width end position/size, relative to the wrapper.
					endLeft: targetRect.left - wrapperRect.left,
					endTop: targetRect.top - wrapperRect.top,
					endWidth: targetRect.width,
					endHeight: targetRect.height,
					// Document-relative top of the expanded target — this is
					// the scroll distance we animate across.
					targetDocTop: targetRect.top + scrollY,
				};
			}

			function updateMorph() {
				if (!wrapper || !placeholder || !target || !video || !iframe)
					return;

				isMobileLayout = window.innerWidth <= 1024;

				if (isMobileLayout) {
					// Reset inline styles so the CSS media-query fallback
					// (simple static circle) takes over on tablet/mobile.
					video.style.position = "";
					video.style.left = "";
					video.style.top = "";
					video.style.width = "";
					video.style.height = "";
					video.style.borderRadius = "";
					video.style.transform = "";
					iframe.style.width = "";
					iframe.style.height = "";
					iframe.style.borderRadius = "";
					if (leftCol) {
						leftCol.style.opacity = "";
						leftCol.style.transform = "";
					}
					return;
				}

				if (!metrics) measure();
				if (!metrics) return;

				const scrollY = window.scrollY || window.pageYOffset;

				// How far we've scrolled since the wrapper reached the top
				// of the viewport (offset by a small header buffer).
				const headerOffset = 140;
				const scrollStart = metrics.wrapperDocTop;
				const scrollEnd = metrics.targetDocTop - headerOffset;
				const totalScroll = Math.max(scrollEnd - scrollStart, 1);

				let progress = (scrollY - scrollStart) / totalScroll;
				progress = Math.min(Math.max(progress, 0), 1);

				// Enable absolute positioning relative to morphing-wrapper
				video.style.position = "absolute";

				// 1. Interpolate left, top, width, height
				const currentLeft =
					metrics.startLeft +
					(metrics.endLeft - metrics.startLeft) * progress;
				const currentTop =
					metrics.startTop +
					(metrics.endTop - metrics.startTop) * progress;
				const currentWidth =
					metrics.startWidth +
					(metrics.endWidth - metrics.startWidth) * progress;
				const currentHeight =
					metrics.startHeight +
					(metrics.endHeight - metrics.startHeight) * progress;

				video.style.left = `${currentLeft}px`;
				video.style.top = `${currentTop}px`;
				video.style.width = `${currentWidth}px`;
				video.style.height = `${currentHeight}px`;

				// 2. Morph border radius: stay a capsule/pill (height / 2)
				// for longer, then ease into the rounded-rect corner.
				const currentCapsuleRadius = currentHeight / 2;
				const endRadius = 40; // matches this page's .rect-frame corner radius
				const radiusProgress = Math.pow(progress, 2.5);
				const currentRadius =
					currentCapsuleRadius +
					(endRadius - currentCapsuleRadius) * radiusProgress;

				video.style.borderRadius = `${currentRadius}px`;
				iframe.style.borderRadius = `${currentRadius}px`;

				// 3. Keep the video centered and cropping like
				// object-fit: cover for a 16:9 ratio, no black bars.
				const containerRatio = currentWidth / currentHeight;
				const targetRatio = 16 / 9;
				if (containerRatio > targetRatio) {
					iframe.style.width = "100%";
					iframe.style.height = `${(containerRatio / targetRatio) * 100}%`;
				} else {
					iframe.style.width = `${(targetRatio / containerRatio) * 100}%`;
					iframe.style.height = "100%";
				}

				// 4. Fade the hero copy out slightly as the video takes over.
				if (leftCol) {
					const fadeProgress = Math.min(progress / 0.6, 1);
					leftCol.style.opacity = `${1 - fadeProgress * 0.35}`;
					leftCol.style.transform = `translateY(${fadeProgress * -12}px)`;
				}
			}

			let ticking = false;
			function onScroll() {
				if (!ticking) {
					window.requestAnimationFrame(() => {
						updateMorph();
						ticking = false;
					});
					ticking = true;
				}
			}

			function onResize() {
				measure();
				updateMorph();
			}

			// Re-measure once every image inside the wrapper has finished
			// loading, since late-loading badges/avatars/logos shift the
			// hero's height and therefore the circle's start position.
			function watchImages() {
				const imgs = wrapper
					? Array.from(wrapper.querySelectorAll("img"))
					: [];
				imgs.forEach((img) => {
					if (img.complete) return;
					img.addEventListener(
						"load",
						() => {
							measure();
							updateMorph();
						},
						{ once: true },
					);
				});
			}

			window.addEventListener("scroll", onScroll, { passive: true });
			window.addEventListener("resize", onResize, { passive: true });
			window.addEventListener("load", () => {
				measure();
				updateMorph();
				watchImages();
			});

			// Initial measurement/paint as soon as the DOM is ready, so
			// there's no flash of the circle in the wrong spot.
			measure();
			updateMorph();
			window.addEventListener("DOMContentLoaded", () => {
				measure();
				updateMorph();
			});

			// A couple of safety re-measures shortly after load, in case
			// web fonts or late layout shifts change element positions.
			setTimeout(() => {
				measure();
				updateMorph();
			}, 200);
			setTimeout(() => {
				measure();
				updateMorph();
			}, 800);
		</script>

		<!-- ===================== ACHIEVEMENTS STATS CARDS ===================== -->
		<section class="cma-achievements-cards-section">
			<div class="cma-achievements-cards-container">
				<div class="cma-ach-card">
					<span class="cma-ach-num">5</span>
					<span class="cma-ach-label">Years</span>
				</div>
				<div class="cma-ach-card">
					<span class="cma-ach-num">49</span>
					<span class="cma-ach-label">World Ranks</span>
				</div>
				<div class="cma-ach-card">
					<span class="cma-ach-num">76</span>
					<span class="cma-ach-label">National Ranks</span>
				</div>
				<div class="cma-ach-card">
					<span class="cma-ach-num">5000+</span>
					<span class="cma-ach-label">Affiliates</span>
				</div>
				<div class="cma-ach-card">
					<span class="cma-ach-num">25,000</span>
					<span class="cma-ach-label">Students</span>
				</div>
			</div>
		</section>

		<!-- ===================== BE THE PROFESSIONAL THE WORLD IS LOOKING FOR ===================== -->
		<section class="cma-professional-section">
			<div class="cma-professional-container">
				<!-- Left: Heading and Badges -->
				<div class="cma-prof-left">
					<h2 class="cma-prof-title">
						Be the <span class="text-slate">Professional</span> the<br
						/>
						World Is <span class="text-slate">Looking For!</span>
					</h2>
					<div class="cma-prof-badges">
						<img
							src="/images/CMA-gold-1-e1762840636945.png"
							alt="Gold CMA Course Provider"
							class="cma-prof-badge-img gold-badge-img"
						/>
						<img
							src="/images/courses/Silver-CMA.png"
							alt="IMA Logo"
							class="cma-prof-badge-img ima-badge-img"
						/>
					</div>
				</div>
				<!-- Right: Bullet checklist -->
				<div class="cma-prof-right">
					<div class="cma-bullet-item">
						<div class="cma-bullet-icon">
							<svg
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="3"
							>
								<polyline points="20 6 9 17 4 12"></polyline>
							</svg>
						</div>
						<p class="cma-bullet-text">
							Recognition in over 160 countries world-wide.
						</p>
					</div>
					<div class="cma-bullet-item">
						<div class="cma-bullet-icon">
							<svg
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="3"
							>
								<polyline points="20 6 9 17 4 12"></polyline>
							</svg>
						</div>
						<p class="cma-bullet-text">
							Join a network of influential finance professionals.
						</p>
					</div>
					<div class="cma-bullet-item">
						<div class="cma-bullet-icon">
							<svg
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="3"
							>
								<polyline points="20 6 9 17 4 12"></polyline>
							</svg>
						</div>
						<p class="cma-bullet-text">
							Stay in demand with skills valued internationally.
						</p>
					</div>
					<div class="cma-bullet-item">
						<div class="cma-bullet-icon">
							<svg
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="3"
							>
								<polyline points="20 6 9 17 4 12"></polyline>
							</svg>
						</div>
						<p class="cma-bullet-text">
							Upskill your way to a leadership role in the finance
							industry.
						</p>
					</div>
					<div class="cma-bullet-item">
						<div class="cma-bullet-icon">
							<svg
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="3"
							>
								<polyline points="20 6 9 17 4 12"></polyline>
							</svg>
						</div>
						<p class="cma-bullet-text">
							High earning potential from ₹4 LPA to ₹20LPA.
						</p>
					</div>
				</div>
			</div>
		</section>

		<StudentPlacements />

		<CareerAndWhyElance />

		<CmaFaculties />

		<CmaLearningAndSyllabus />

		<Footer />
	</body>
</html>

<style>
	/* ── RESET & FONTS ── */
	* {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	body {
		font-family: "Outfit", "Inter", sans-serif;
		background-color: #ffffff;
		color: #1e293b;
	}

	.text-blue {
		color: #3b9fe8;
	}
	.highlight-blue {
		color: #3b9fe8;
	}

	/* ── ENROLLMENT BANNER ── */
	.enrollment-banner {
		background: #e0f2fe;
		padding: 12px 20px;
		text-align: center;
	}
	.banner-badge {
		font-size: 0.95rem;
		font-weight: 600;
		color: #1e293b;
		letter-spacing: 0.2px;
	}

	/* ─────────────────────────────────────────
	   MORPHING WRAPPER — circle grows into full-width video
	───────────────────────────────────────── */
	.morphing-wrapper {
		position: relative;
		width: 100%;
	}

	/* Invisible stand-in that marks the circle's start position/size */
	.video-placeholder {
		width: 420px;
		height: 420px;
		border-radius: 50%;
		visibility: hidden;
	}

	.video-expanded-section {
		padding: 60px 0 100px;
		background-color: #ffffff;
		display: flex;
		justify-content: center;
	}

	.video-expanded-inner {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 40px;
		width: 100%;
	}

	/* Invisible stand-in that marks the video's full-width end position/size */
	.expanded-video-target {
		width: 100%;
		height: 675px; /* 16:9 at 1200px wide */
		border-radius: 40px; /* matches .rect-frame's corner radius */
		visibility: hidden;
	}

	/* The real video element, absolutely positioned and animated on scroll */
	.video-circle-wrapper {
		width: 420px;
		height: 420px;
		border-radius: 50%;
		overflow: hidden;
		position: absolute;
		box-shadow: 0 20px 60px rgba(0, 0, 0, 0.14);
		background-color: #000000;
		z-index: 50;
		-webkit-mask-image: -webkit-radial-gradient(white, black);
		transform: translate3d(0, 0, 0);
		-webkit-transform: translate3d(0, 0, 0);
		will-change: border-radius, width, height, left, top;
	}

	.youtube-circle-iframe {
		position: absolute;
		top: 50%;
		left: 50%;
		width: 177.77777778%; /* cover 16:9 ratio in a 1:1 wrapper */
		height: 100%;
		transform: translate(-50%, -50%);
		border: none;
	}

	/* ─────────────────────────────────────────
	   CMA HERO SECTION — Sticky-scroll layout
	───────────────────────────────────────── */
	.cma-hero-section {
		width: 100%;
		background: #ffffff;
		padding: 0;
	}

	.cma-hero-inner {
		max-width: 1200px;
		margin: 0 auto;
		padding: 60px 40px 0;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 60px;
		align-items: start;
		position: relative;
	}

	/* LEFT column — sticky while user scrolls right panels */
	.cma-hero-left {
		position: sticky;
		top: 80px;
		padding-bottom: 80px;
		align-self: start;
	}

	.cma-hero-title {
		font-size: clamp(2rem, 4vw, 3.2rem);
		font-weight: 800;
		color: #1e293b;
		line-height: 1.18;
		margin-bottom: 40px;
		font-family: "Outfit", sans-serif;
	}

	/* Badges (Gold CMA + HOCK) */
	.cma-badges-row {
		display: flex;
		align-items: center;
		gap: 16px;
		margin-bottom: 10px;
		flex-wrap: wrap;
	}

	.cma-badge-img {
		object-fit: contain;
	}

	.gold-badge {
		height: 64px;
		width: auto;
	}

	.hock-badge {
		height: 48px;
		width: auto;
	}

	/* IMA logo row */
	.cma-ima-row {
		margin-bottom: 28px;
	}

	.ima-logo {
		height: 48px;
		width: auto;
		object-fit: contain;
		border: 1.5px solid #e2e8f0;
		border-radius: 6px;
		padding: 4px 10px;
		background: #fff;
	}

	/* Student proof */
	.student-proof {
		display: flex;
		align-items: center;
		gap: 16px;
		margin-bottom: 28px;
	}

	.proof-label {
		font-size: 0.8rem;
		font-weight: 700;
		color: #1e293b;
		text-transform: uppercase;
		letter-spacing: 0.3px;
		line-height: 1.5;
	}

	.avatar-stack {
		display: flex;
		align-items: center;
	}

	.avatar-img {
		width: 36px;
		height: 36px;
		border-radius: 50%;
		border: 2px solid #fff;
		object-fit: cover;
		margin-left: -10px;
		box-shadow: 0 1px 4px rgba(0, 0, 0, 0.12);
	}

	.avatar-img:first-child {
		margin-left: 0;
	}

	/* Corporate logos */
	.corporate-logos-row {
		display: flex;
		align-items: center;
		gap: 20px;
		flex-wrap: wrap;
	}

	.corp-logo {
		height: 22px;
		width: auto;
		object-fit: contain;
		opacity: 0.7;
	}

	.corp-logo-text {
		font-size: 1rem;
		font-weight: 700;
		color: #64748b;
	}

