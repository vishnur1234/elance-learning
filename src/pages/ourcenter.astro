---
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import FeaturedOn from "../components/FeaturedOn.astro";
import { getEmDashEntry } from "../lib/cms.js";
import { getCmsImageUrl } from "../utils/media.js";

// Fetch the "Our Centers" page's dynamic content from EmDash CMS (same
// "pages" collection the home/ACCA pages use, with slug "ourcenter").
const { entry: pageEntry } = await getEmDashEntry("pages", "ourcenter").catch(
	() => ({ entry: null }),
);
const data = (pageEntry?.data as Record<string, any>) || {};
const edit = (pageEntry?.edit as Record<string, any>) || {};

// ── Hero ──
const heroEyebrow = String(data.hero_eyebrow || "Welcome to");
const heroTitle = String(
	data.hero_title ||
		"India's Most Trusted<br />Commerce Institute",
);
const heroDesc = String(
	data.hero_desc ||
		"Begin your journey in a space alive with ambition, connection, and opportunity. Whether you're at our vibrant Calicut campus or the dynamic Kochi campus, every moment at Elance invites you to grow your skills, build meaningful relationships, and enjoy the spirited pulse of campus life. Here, education goes beyond the classroom— offering professional commerce qualifications that empowers your career while creating memories that last a lifetime.",
);
const heroCtaText = String(data.hero_cta_text || "Begin your career now");
const heroImg = getCmsImageUrl(
	data.hero_img,
	"/images/ourcenter/Our-Center-BIG-M-Banner.png",
);

// ── Campus cards (Kochi, Calicut) ──
const CAMPUS_DEFAULTS = [
	{
		title: "Elance Kochi Campus",
		desc: "Our Kochi campus blends focus with freshness! A space where ambition excels alongside friendly faces, coffee breaks, and real-world learning. From expert-led sessions to campus moments you'll always remember, it's where growth feels good.",
		cta: "Know more",
		video: "https://www.youtube.com/embed/cGtbeaH_x88",
	},
	{
		title: "Elance Calicut Campus",
		desc: "At our Calicut campus, learning is just one part of the experience. It's a space filled with energy, connection, and the kind of support that helps you grow inside the classroom and beyond. Here, every day brings new ideas and memorable moments.",
		cta: "Know more",
		video: "https://www.youtube.com/embed/TWKK0uhj_QY",
	},
];
const campuses = CAMPUS_DEFAULTS.map((fallback, i) => {
	const n = i + 1;
	return {
		title: String(data[`campus_${n}_title`] || fallback.title),
		desc: String(data[`campus_${n}_desc`] || fallback.desc),
		cta: String(data[`campus_${n}_cta_text`] || fallback.cta),
		video: String(data[`campus_${n}_video`] || fallback.video),
		editTitle: edit[`campus_${n}_title`],
		editDesc: edit[`campus_${n}_desc`],
		editCta: edit[`campus_${n}_cta_text`],
		editVideo: edit[`campus_${n}_video`],
	};
});

// ── Features grid (6 icon+text cards) ──
const FEATURE_DEFAULTS = [
	{
		icon: "/images/ourcenter/Classroom.svg",
		text: "Modern, well-equipped classrooms",
	},
	{
		icon: "/images/ourcenter/Discussion.svg",
		text: "Tech-enabled learning spaces with high-speed internet",
	},
	{
		icon: "/images/ourcenter/Environment.svg",
		text: "Student-friendly common areas for discussions and collaboration",
	},
	{
		icon: "/images/ourcenter/Mentor-Support.svg",
		text: "Easy access to faculty and mentors for academic support",
	},
	{
		icon: "/images/ourcenter/Meeting-room.svg",
		text: "Space for events, celebrations, and student-led initiatives",
	},
	{
		icon: "/images/ourcenter/Tech-Enabled-Space.svg",
		text: "Calm, clean environment designed to keep students focused",
	},
];
const features = FEATURE_DEFAULTS.map((fallback, i) => {
	const n = i + 1;
	return {
		icon: getCmsImageUrl(data[`feature_${n}_icon`], fallback.icon),
		text: String(data[`feature_${n}_text`] || fallback.text),
		editIcon: edit[`feature_${n}_icon`],
		editText: edit[`feature_${n}_text`],
	};
});

// ── Celebrations banner ──
const celebrationsTitle = String(
	data.celebrations_title || "Celebrations, Culture & Campus Spirit",
);
const celebrationsDesc = String(
	data.celebrations_desc ||
		"At Elance, achievement and celebration go hand in hand. Our campuses come alive with vibrant cultural fests, spirited events, and thrilling sports moments that leave a lasting impact.",
);
const celebrationsDetail = String(
	data.celebrations_detail ||
		"From festive gatherings and talent showcases to high-energy sports competitions and our flagship annual event Elan Festa, every occasion brings students together to connect, express, and celebrate. Both Kochi and Calicut campuses offer a dynamic space where culture, creativity, and campus spirit thrive.",
);

// ── Excellence grid (2 title+text cards) ──
const EXCELLENCE_DEFAULTS = [
	{
		title: "Academic Excellence with Personalised Support",
		text: "At Elance, learning is not limited to textbooks. We foster a well-rounded environment where students grow intellectually, emotionally, and personally. Our distinctive 4-tier support system—including expert faculty, dedicated mentors, approachable coordinators, and trained psychological counsellors—ensures every student receives the right guidance at every stage of their journey through our commerce professional courses and beyond.",
	},
	{
		title: "Career-Focused Student Journey",
		text: "We combine strong academic foundations with hands-on exposure to prepare students for success beyond the classroom. Designed to provide the best commerce courses in India, our programs are enriched with initiatives like the Prime+ Program, leadership development platforms, and industry-aligned experiences—such as the EDGE '24 pitching challenge, LEAP '25, a case study collaboration with IIM Mumbai, and the Excel Hackathon. Students gain real-world skills and confidence to become industry-ready global commerce professionals.",
	},
];
const excellenceCards = EXCELLENCE_DEFAULTS.map((fallback, i) => {
	const n = i + 1;
	return {
		title: String(data[`excellence_${n}_title`] || fallback.title),
		text: String(data[`excellence_${n}_text`] || fallback.text),
		editTitle: edit[`excellence_${n}_title`],
		editText: edit[`excellence_${n}_text`],
	};
});

// ── Featured On section ──
const featuredTitle = String(
	data.featured_title || 'We\'re <span class="text-blue">Featured</span> On',
);
const featuredSubtitle = String(
	data.featured_subtitle ||
		"Recognized by leading media houses for our commitment to quality education and student success.",
);
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Our Centers | Elance</title>
		<meta
			name="description"
			content="India's Most Trusted Commerce Institute. Explore Elance's Kochi and Calicut campuses."
		/>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,600&family=Outfit:wght@300;400;500;600;700;800;900&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<Nav />

		<!-- ===================== HERO ===================== -->
		<section class="oc-hero-section">
			<div class="oc-hero-card">
				<div class="oc-hero-left">
					<p class="oc-eyebrow" {...edit.hero_eyebrow}>{heroEyebrow}</p>
					<h1 class="oc-hero-title" set:html={heroTitle} {...edit.hero_title} />
					<p class="oc-hero-desc" {...edit.hero_desc}>{heroDesc}</p>
					<a href="#" class="oc-btn-primary" {...edit.hero_cta_text}>{heroCtaText}</a>
				</div>
				<div class="oc-hero-right">
					<img
						src={heroImg}
						alt="Elance campus with brand ambassador"
						class="oc-hero-img"
						{...edit.hero_img}
					/>
				</div>
			</div>
		</section>

		<!-- ===================== CAMPUS CARDS ===================== -->
		<section class="oc-campus-section">
			<div class="oc-campus-grid">
				{campuses.map((c) => (
					<div class="oc-campus-card">
						<h2 class="oc-campus-title" {...c.editTitle}>{c.title}</h2>
						<p class="oc-campus-desc" {...c.editDesc}>{c.desc}</p>
						<a href="#" class="oc-btn-outline" {...c.editCta}>{c.cta}</a>

						<div class="oc-video-thumb">
							<iframe
								src={c.video}
								title={c.title}
								allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
								allowfullscreen
								class="oc-video-iframe"
								{...c.editVideo}></iframe>
						</div>
					</div>
				))}
			</div>
		</section>

		<!-- ===================== CAMPUS FEATURES GRID ===================== -->
		<section class="oc-features-section">
			<div class="oc-features-grid">
				{features.map((f) => (
					<div class="oc-feature-card">
						<img
							src={f.icon}
							alt=""
							class="oc-feature-icon oc-feature-icon--original"
							{...f.editIcon}
						/>
						<p class="oc-feature-text" {...f.editText}>
							{f.text}
						</p>
					</div>
				))}
			</div>
		</section>

		<!-- ===================== CELEBRATIONS SECTION ===================== -->
		<section class="oc-celebrations-section">
			<div class="oc-celebrations-content">
				<h2 class="oc-celebrations-title" {...edit.celebrations_title}>
					{celebrationsTitle}
				</h2>
				<p class="oc-celebrations-desc" {...edit.celebrations_desc}>
					{celebrationsDesc}
				</p>
				<p class="oc-celebrations-detail" {...edit.celebrations_detail}>
					{celebrationsDetail}
				</p>
			</div>
		</section>

		<!-- ===================== EXCELLENCE SECTION ===================== -->
		<section class="oc-excellence-section">
			<div class="oc-excellence-grid">
				{excellenceCards.map((ex) => (
					<div class="oc-excellence-card">
						<h3 class="oc-excellence-title" {...ex.editTitle}>
							{ex.title}
						</h3>
						<p class="oc-excellence-text" {...ex.editText}>
							{ex.text}
						</p>
					</div>
				))}
			</div>
		</section>

		<FeaturedOn
			title={featuredTitle}
			subtitle={featuredSubtitle}
			editTitle={edit.featured_title}
			editSubtitle={edit.featured_subtitle}
		/>

		<Footer />
	</body>
</html>

<style>
	* {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	body {
		font-family: "Outfit", "Inter", sans-serif;
		background-color: #f8fafc;
		color: #1e293b;
	}

	a {
		text-decoration: none;
	}

	/* ─────────────────────────────────────────
	   HERO
	───────────────────────────────────────── */
	.oc-hero-section {
		padding: 40px 40px 0;
		max-width: 1400px;
		margin: 0 auto;
	}

	.oc-hero-card {
		background: linear-gradient(135deg, #e2effa 0%, #dbe9f6 100%);
		border-radius: 28px;
		display: grid;
		grid-template-columns: 1.05fr 0.95fr;
		align-items: center;
		overflow: hidden;
		min-height: 460px;
	}

	.oc-hero-left {
		padding: 56px 20px 56px 64px;
	}

	.oc-eyebrow {
		font-size: 1.1rem;
		font-weight: 600;
		color: #1e293b;
		margin-bottom: 10px;
	}

	.oc-hero-title {
		font-size: clamp(2.2rem, 3.4vw, 3rem);
		font-weight: 800;
		line-height: 1.2;
		color: #1c4e8f;
		font-family: "Outfit", sans-serif;
		margin-bottom: 24px;
	}

	.oc-hero-desc {
		font-size: 1.05rem;
		line-height: 1.7;
		color: #334155;
		max-width: 520px;
		margin-bottom: 32px;
	}

	.oc-btn-primary {
		display: inline-block;
		background: #123a72;
		color: #fff;
		font-weight: 700;
		font-size: 1.05rem;
		padding: 16px 32px;
		border-radius: 999px;
		font-family: "Outfit", sans-serif;
	}

	.oc-btn-primary:hover {
		background: #0d2c57;
	}

	.oc-hero-right {
		height: 100%;
		display: flex;
		align-items: flex-end;
		justify-content: center;
		position: relative;
		align-self: stretch;
	}

	.oc-hero-img {
		width: 100%;
		height: 100%;
		max-height: 460px;
		object-fit: contain;
		object-position: bottom;
		display: block;
	}

	/* ─────────────────────────────────────────
	   CAMPUS CARDS
	───────────────────────────────────────── */
	.oc-campus-section {
		padding: 60px 40px 100px;
		max-width: 1400px;
		margin: 0 auto;
	}

	.oc-campus-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 32px;
	}

	.oc-campus-card {
		background: #f1f5f9;
		border-radius: 24px;
		padding: 48px;
	}

	.oc-campus-title {
		font-size: 2rem;
		font-weight: 800;
		color: #1e293b;
		font-family: "Outfit", sans-serif;
		margin-bottom: 20px;
	}

	.oc-campus-desc {
		font-size: 1.05rem;
		line-height: 1.7;
		color: #334155;
		margin-bottom: 28px;
	}

	.oc-btn-outline {
		display: inline-block;
		border: 1.5px solid #123a72;
		color: #123a72;
		font-weight: 700;
		font-size: 1.05rem;
		padding: 14px 30px;
		border-radius: 999px;
		font-family: "Outfit", sans-serif;
		margin-bottom: 36px;
	}

	.oc-btn-outline:hover {
		background: #123a72;
		color: #fff;
	}

	.oc-video-thumb {
		position: relative;
		border-radius: 18px;
		overflow: hidden;
		aspect-ratio: 16 / 9;
		background: #0f172a;
	}

	.oc-video-iframe {
		width: 100%;
		height: 100%;
		border: none;
		display: block;
	}

	/* ─────────────────────────────────────────
	   FEATURES
	───────────────────────────────────────── */
	.oc-features-section {
		padding: 60px 40px 100px;
		max-width: 1400px;
		margin: 0 auto;
	}

	.oc-features-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 32px;
	}

	.oc-feature-card {
		background: #f1f5f9;
		border: 1px solid #e2e8f0;
		border-radius: 20px;
		padding: 48px 32px;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 20px;
		transition: all 0.3s ease;
	}

	.oc-feature-card:hover {
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
		border-color: #cbd5e1;
	}

	.oc-feature-icon {
		width: 64px;
		height: 64px;
		object-fit: contain;
		filter: hue-rotate(200deg) saturate(1.2);
	}

	.oc-feature-icon--original {
		filter: none;
	}

	.oc-feature-text {
		font-size: 1.2rem;
		font-weight: 700;
		color: #1e293b;
		line-height: 1.5;
		font-family: "Outfit", sans-serif;
	}

	/* ── RESPONSIVE ── */
	@media (max-width: 1024px) {
		.oc-hero-card {
			grid-template-columns: 1fr;
			min-height: auto;
		}

		.oc-hero-left {
			padding: 40px 32px;
		}

		.oc-hero-right {
			min-height: 320px;
		}

		.oc-campus-grid {
			grid-template-columns: 1fr;
		}

		.oc-features-grid {
			grid-template-columns: repeat(2, 1fr);
			gap: 24px;
		}
	}

	@media (max-width: 600px) {
		.oc-hero-section,
		.oc-campus-section,
		.oc-features-section {
			padding-left: 20px;
			padding-right: 20px;
		}

		.oc-hero-left {
			padding: 32px 24px;
		}

		.oc-campus-card {
			padding: 32px 24px;
		}

		.oc-hero-title {
			font-size: 1.9rem;
		}

		.oc-features-grid {
			grid-template-columns: 1fr;
			gap: 20px;
		}

		.oc-feature-card {
			padding: 32px 24px;
		}

		.oc-feature-text {
			font-size: 1.1rem;
		}
	}

	/* ─────────────────────────────────────────
	   CELEBRATIONS
	───────────────────────────────────────── */
	.oc-celebrations-section {
		background:
			linear-gradient(
				135deg,
				rgba(30, 58, 112, 0.75) 0%,
				rgba(68, 97, 140, 0.75) 100%
			),
			url("/images/ourcenter/DSC09965.jpg") center/cover no-repeat;
		padding: 100px 40px;
		max-width: 100%;
		margin: 60px 0 0 0;
	}

	.oc-celebrations-content {
		max-width: 1400px;
		margin: 0 auto;
		max-width: 700px;
	}

	.oc-celebrations-title {
		font-size: clamp(2rem, 4vw, 3.5rem);
		font-weight: 800;
		color: #fff;
		font-family: "Outfit", sans-serif;
		line-height: 1.2;
		margin-bottom: 24px;
		font-style: italic;
	}

	.oc-celebrations-desc {
		font-size: 1.1rem;
		line-height: 1.7;
		color: #e2e8f0;
		margin-bottom: 28px;
		font-family: "Outfit", sans-serif;
	}

	.oc-celebrations-detail {
		font-size: 1rem;
		line-height: 1.7;
		color: #e2e8f0;
		font-family: "Outfit", sans-serif;
	}

	/* ── RESPONSIVE ── */
	@media (max-width: 1024px) {
		.oc-celebrations-section {
			padding: 80px 32px;
		}

		.oc-celebrations-content {
			max-width: 600px;
		}

		.oc-celebrations-title {
			font-size: 2.5rem;
		}
	}

	@media (max-width: 600px) {
		.oc-celebrations-section {
			padding: 60px 20px;
			margin: 40px 0 0 0;
		}

		.oc-celebrations-content {
			max-width: 100%;
		}

		.oc-celebrations-title {
			font-size: 1.8rem;
			margin-bottom: 20px;
		}

		.oc-celebrations-desc {
			font-size: 1rem;
			margin-bottom: 20px;
		}

		.oc-celebrations-detail {
			font-size: 0.95rem;
			padding: 0;
		}
	}

	/* ─────────────────────────────────────────
	   EXCELLENCE
	───────────────────────────────────────── */
	.oc-excellence-section {
		padding: 80px 40px;
		max-width: 1400px;
		margin: 0 auto;
	}

	.oc-excellence-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 48px;
	}

	.oc-excellence-card {
		background: #dbeafe;
		border-radius: 0;
		padding: 48px;
		display: flex;
		flex-direction: column;
		gap: 20px;
	}

	.oc-excellence-title {
		font-size: 1.8rem;
		font-weight: 800;
		color: #1e293b;
		font-family: "Outfit", sans-serif;
		line-height: 1.3;
	}

	.oc-excellence-text {
		font-size: 1rem;
		line-height: 1.7;
		color: #334155;
		font-family: "Outfit", sans-serif;
	}

	/* ── RESPONSIVE ── */
	@media (max-width: 1024px) {
		.oc-excellence-section {
			padding: 60px 32px;
		}

		.oc-excellence-grid {
			grid-template-columns: 1fr;
			gap: 32px;
		}

		.oc-excellence-title {
			font-size: 1.5rem;
		}
	}

	@media (max-width: 600px) {
		.oc-excellence-section {
			padding: 40px 20px;
		}

		.oc-excellence-card {
			padding: 32px 24px;
		}

		.oc-excellence-title {
			font-size: 1.3rem;
		}

		.oc-excellence-text {
			font-size: 0.95rem;
		}
	}
</style>
