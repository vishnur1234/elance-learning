		font-weight: 500;
		opacity: 0.95;
		margin-right: 4px;
		font-family: "Outfit", sans-serif;
	}

	/* ── CARD TOGGLE & HOVER SELECTORS (USING :has) ── */

	/* Default state: Students is active, Professionals is normal/faint */
	.students-card .audience-info-box {
		opacity: 1;
		visibility: visible;
		transform: translateY(0);
		transition:
			opacity 0.3s ease,
			transform 0.3s ease,
			visibility 0.3s ease;
	}
	.students-card .audience-overlay {
		opacity: 0;
		visibility: hidden;
		transform: translateY(15px);
		transition:
			opacity 0.3s ease,
			transform 0.3s ease,
			visibility 0.3s ease;
	}
	.students-card::after {
		opacity: 0.3;
	}

	.professionals-card .audience-info-box {
		opacity: 0;
		visibility: hidden;
		transform: translateY(15px);
		transition:
			opacity 0.3s ease,
			transform 0.3s ease,
			visibility 0.3s ease;
	}
	.professionals-card .audience-overlay {
		opacity: 1;
		visibility: visible;
		transform: translateY(0);
		transition:
			opacity 0.3s ease,
			transform 0.3s ease,
			visibility 0.3s ease;
	}
	.professionals-card::after {
		opacity: 1;
	}

	/* When hovering Professionals card:
	   1. Professionals becomes active.
	   2. Students becomes normal/faint. */
	.audience-grid:has(.professionals-card:hover)
		.professionals-card
		.audience-info-box {
		opacity: 1;
		visibility: visible;
		transform: translateY(0);
	}
	.audience-grid:has(.professionals-card:hover)
		.professionals-card
		.audience-overlay {
		opacity: 0;
		visibility: hidden;
		transform: translateY(15px);
	}
	.audience-grid:has(.professionals-card:hover) .professionals-card::after {
		opacity: 0.3;
	}

	.audience-grid:has(.professionals-card:hover)
		.students-card
		.audience-info-box {
		opacity: 0;
		visibility: hidden;
		transform: translateY(15px);
	}
	.audience-grid:has(.professionals-card:hover)
		.students-card
		.audience-overlay {
		opacity: 1;
		visibility: visible;
		transform: translateY(0);
	}
	.audience-grid:has(.professionals-card:hover) .students-card::after {
		opacity: 1;
	}

	/* Explicit hovering on Students card ensures it stays active even if grid has mouseenter */
	.students-card:hover .audience-info-box {
		opacity: 1 !important;
		visibility: visible !important;
		transform: translateY(0) !important;
	}
	.students-card:hover .audience-overlay {
		opacity: 0 !important;
		visibility: hidden !important;
		transform: translateY(15px) !important;
	}
	.students-card:hover::after {
		opacity: 0.3 !important;
	}

