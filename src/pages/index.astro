---
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import FeaturedOn from "../components/FeaturedOn.astro";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>Elance – India's Most Trusted Commerce Institute</title>
		<meta
			name="description"
			content="From Learner to Leader. Build your career with globally recognized programs in CMA (US) and ACCA – designed for future commerce leaders."
		/>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,600&family=Outfit:wght@300;400;500;600;700;800;900&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<Nav />

		<!-- ===================== HERO ===================== -->
		<section class="hero">
			<div class="hero-container">
				<div class="hero-content">
					<p class="hero-eyebrow">
						From Learner to Leader Starts Here
					</p>
					<h1 class="hero-heading">
						India's Most Trusted<br />
						<span class="hero-blue">Commerce Institute</span>
					</h1>
					<div class="hero-btns">
						<a href="#courses" class="btn-blue-pill"
							>Explore Courses</a
						>
						<a href="#" class="btn-outline-pill"
							>Speak to a Counsellor</a
						>
					</div>
					<div class="alumni-section">
						<p class="alumni-text">
							Our <span class="alumni-word">alumni</span> work at
						</p>
						<div class="alumni-ticker-wrap">
							<div class="alumni-ticker">
								<!-- Set 1 -->
								<img
									src="/src/Assets/deloitte.png"
									alt="Deloitte"
									class="alumni-logo alumni-logo-deloitte"
								/>
								<img
									src="/src/Assets/ey.png"
									alt="EY"
									class="alumni-logo alumni-logo-ey"
								/>
								<img
									src="/src/Assets/pwc.png"
									alt="PwC"
									class="alumni-logo alumni-logo-pwc"
								/>
								<img
									src="/src/Assets/223x53-16.png"
									alt="Grant Thornton"
									class="alumni-logo alumni-logo-gt"
								/>
								<!-- Set 2 – duplicate for seamless loop -->
								<img
									src="/src/Assets/deloitte.png"
									alt="Deloitte"
									class="alumni-logo alumni-logo-deloitte"
									aria-hidden="true"
								/>
								<img
									src="/src/Assets/ey.png"
									alt="EY"
									class="alumni-logo alumni-logo-ey"
									aria-hidden="true"
								/>
								<img
									src="/src/Assets/pwc.png"
									alt="PwC"
									class="alumni-logo alumni-logo-pwc"
									aria-hidden="true"
								/>
								<img
									src="/src/Assets/223x53-16.png"
									alt="Grant Thornton"
									class="alumni-logo alumni-logo-gt"
									aria-hidden="true"
								/>
							</div>
						</div>
					</div>
				</div>
				<div class="hero-visual">
					<img
						src="/src/Assets/hero-bg-shape-big.png"
						alt=""
						class="hero-shape-big"
						aria-hidden="true"
					/>
					<img
						src="/src/Assets/hero-bg-shape-small.webp"
						alt=""
						class="hero-shape-small"
						aria-hidden="true"
					/>
					<img
						src="/src/Assets/mammooty-new7.webp"
						alt="Brand Ambassador"
						class="hero-person"
					/>
				</div>
			</div>
		</section>

		<!-- ===================== COURSES ===================== -->
		<section class="courses" id="courses">
			<div class="section-container">
				<h2 class="section-title">
					Pick the <span class="text-blue">Course</span> That Fits Your
					Dream
				</h2>
				<p class="section-subtitle">
					Build your career with globally recognized programs in CMA
					(US),<br />
					and ACCA — designed for future commerce leaders.
				</p>
				<div class="courses-wrap">
					<div class="funnel-bg"></div>
					<div class="courses-grid">
						<!-- ACCA -->
						<div class="course-card">
							<img
								src="/src/Assets/accaimage-300x300.png"
								alt="ACCA"
								class="course-logo-img"
							/>
							<h3 class="course-card-title-plain">ACCA</h3>
							<p class="course-desc">
								Qualify for ACCA and get access to the world of
								professional accounting which gives an offer to
								work globally across 180+ countries with high
								demand and good remuneration.
							</p>
							<div class="course-btns">
								<a href="#" class="btn-blue-pill">Brochure</a>
								<a href="#" class="btn-outline-pill"
									>Know more</a
								>
							</div>
						</div>

						<!-- CMA USA -->
						<div class="course-card">
							<img
								src="/src/Assets/cmaimage-300x300.png"
								alt="CMA USA"
								class="course-logo-img"
							/>
							<div class="course-name-badge">CMA USA</div>
							<p class="course-desc">
								Skill up your current working career by becoming
								a Certified Management Accountant and feel the
								advancement of professional accounting.
							</p>
							<div class="course-btns">
								<a href="#" class="btn-blue-pill">Brochure</a>
								<a href="#" class="btn-outline-pill"
									>Know more</a
								>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- ===================== COMMERCE CAREER STEPS ===================== -->
		<section class="steps-section">
			<div class="section-container">
				<h2 class="section-title">
					Your <span class="text-blue">Commerce Career</span> Starts Here
				</h2>
				<div class="steps-grid">
					<div class="step-item">
						<span class="step-number">01</span>
						<div class="step-icon-wrap">
							<img
								src="/src/Assets/home-cta-icon1.webp"
								alt="Learn"
								class="step-icon"
							/>
						</div>
						<p class="step-label">Learn</p>
					</div>
					<div class="step-dots"></div>
					<div class="step-item">
						<span class="step-number">02</span>
						<div class="step-icon-wrap">
							<img
								src="/src/Assets/home-cta-icon2.webp"
								alt="Perform"
								class="step-icon"
							/>
						</div>
						<p class="step-label">Perform</p>
					</div>
					<div class="step-dots"></div>
					<div class="step-item">
						<span class="step-number">03</span>
						<div class="step-icon-wrap">
							<img
								src="/src/Assets/home-cta-icon3.webp"
								alt="Get A Job"
								class="step-icon"
							/>
						</div>
						<p class="step-label">Get A Job</p>
					</div>
				</div>
				<div class="steps-cta">
					<a href="#" class="btn-blue-pill">Reach Us Anytime</a>
				</div>
			</div>
		</section>

		<!-- ===================== TESTIMONIALS ===================== -->
		<section class="testimonials-section">
			<div class="section-container testimonials-layout">
				<!-- Left -->
				<div class="testimonials-left">
					<div class="quote-bg-decor">“</div>
					<p class="testimonials-eyebrow">Testimonials</p>
					<h2 class="testimonials-title">
						<span class="text-blue">Hear From</span> Our<br />
						Previous <span class="text-blue">Students</span>
					</h2>
					<p class="testimonials-desc">
						Elance envisions the courses for everyone to fuel the
						advancement of skills and make you capable of conquering
						your dream career
					</p>
					<a href="#" class="btn-blue-pill">View More</a>
				</div>
				<!-- Right – Testimonial Cards -->
				<div class="testimonials-right">
					<!-- Card 1 -->
					<div class="testimonial-card">
						<span class="testimonial-badge">ACCA</span>
						<p class="testimonial-quote">
							"We always believed in our son, and with the support
							of the Elance's faculty, he made his ACCA dream come
							true."
						</p>
						<div class="testimonial-author">
							<img
								src="/src/Assets/Abhiram-testi.jpg"
								alt="Jiyas V H"
								class="testimonial-avatar"
							/>
							<div>
								<p class="testimonial-name">Jiyas V H</p>
								<p class="testimonial-course">
									Analytics Arabia
								</p>
							</div>
						</div>
					</div>

					<!-- Card 2 -->
					<div class="testimonial-card">
						<span class="testimonial-badge">CA</span>
						<p class="testimonial-quote">
							"All my papers were done online at Elance, with
							wonderful support from the faculty and staff. "
						</p>
						<div class="testimonial-author">
							<img
								src="/src/Assets/Anagha-Anand-150x150.webp"
								alt="Anagha Anand"
								class="testimonial-avatar"
							/>
							<div>
								<p class="testimonial-name">Anagha Anand</p>
								<p class="testimonial-course">
									Elance CA Student
								</p>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- ===================== FOR STUDENTS / PROFESSIONALS ===================== -->
		<section class="audience-section">
			<div class="audience-grid">
				<!-- Left Card: Students -->
				<div class="audience-card students-card">
					<img
						src="/src/Assets/Studentsai1.jpg"
						alt="For Students"
						class="audience-img"
					/>
					<div class="audience-info-box">
						<h3 class="audience-info-title">For Students</h3>
						<p class="audience-info-desc">
							Offering top-tier commerce professional courses like
							ACCA and CMA to propel you into the future of
							finance with high-paying global career opportunities
						</p>
						<a href="#" class="btn-blue-pill-small">Get Started</a>
					</div>
				</div>

				<!-- Right Card: Professionals -->
				<div class="audience-card professionals-card">
					<img
						src="/src/Assets/WorkingProfessionalsai.jpg"
						alt="For Working Professionals"
						class="audience-img"
					/>
					<div class="audience-overlay">
						<p class="audience-overlay-text">
							<span class="label-light">For</span> Working<br
							/>Professionals
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- ===================== PROMO CTA BANNER ===================== -->
		<section class="promo-cta-section">
			<div class="section-container">
				<div class="promo-card">
					<div class="promo-card-decor-1"></div>
					<div class="promo-card-decor-2"></div>
					<h2 class="promo-title">
						Make the Smart Move for a<br />
						Commerce Career<br />
						That Matters!
					</h2>
					<a href="#" class="btn-white-pill">Download Brochure</a>
				</div>
			</div>
		</section>

		<!-- ===================== STUDENT FEEDBACK ===================== -->
		<section class="feedback-section">
			<div class="section-container feedback-layout">
				<!-- Left -->
				<div class="feedback-left">
					<h2 class="feedback-title">
						Our Students <span class="text-blue">Feedback</span>
					</h2>
					<p class="feedback-desc">
						Hear from our students as they share their incredible
						journeys of growth, success, and accomplishments with
						Elance!
					</p>
					<div class="feedback-arrows">
						<button class="arrow-btn" aria-label="Previous">
							<svg
								viewBox="0 0 24 24"
								fill="none"
								xmlns="http://www.w3.org/2000/svg"
							>
								<path
									d="M15 19l-7-7 7-7"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"></path>
							</svg>
						</button>
						<button class="arrow-btn" aria-label="Next">
							<svg
								viewBox="0 0 24 24"
								fill="none"
								xmlns="http://www.w3.org/2000/svg"
							>
								<path
									d="M9 5l7 7-7 7"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"></path>
							</svg>
						</button>
					</div>
				</div>
				<!-- Right – Feedback Image -->
				<div class="feedback-right">
					<div class="feedback-img-wrap">
						<img
							src="/src/Assets/Jahana-Sherin.webp"
							alt="Jahana Sherin – Student Feedback"
							class="feedback-img"
						/>
						<button class="play-btn" aria-label="Play video">
							<svg
								viewBox="0 0 24 24"
								fill="white"
								xmlns="http://www.w3.org/2000/svg"
							>
								<path d="M8 5v14l11-7L8 5z"></path>
							</svg>
						</button>
					</div>
				</div>
			</div>

			<!-- What our Students think about us Banner -->
			<div class="section-container">
				<div class="think-banner">
					<div class="think-banner-left">
						<h2 class="think-title">
							What our<br />
							<span class="text-blue">Students think</span><br />
							about us?
						</h2>
					</div>
					<div class="think-banner-right">
						<div class="think-avatars">
							<img
								src="/src/Assets/i1.jpg"
								alt="Student 1"
								class="think-avatar"
							/>
							<img
								src="/src/Assets/i2.jpg"
								alt="Student 2"
								class="think-avatar"
							/>
							<img
								src="/src/Assets/Abhiram-testi.jpg"
								alt="Student 3"
								class="think-avatar"
							/>
						</div>
						<div class="think-arrows">
							<button
								class="arrow-btn-small"
								aria-label="Previous"
							>
								<svg
									viewBox="0 0 24 24"
									fill="none"
									xmlns="http://www.w3.org/2000/svg"
								>
									<path
										d="M15 19l-7-7 7-7"
										stroke="currentColor"
										stroke-width="2.5"
										stroke-linecap="round"
										stroke-linejoin="round"></path>
								</svg>
							</button>
							<button class="arrow-btn-small" aria-label="Next">
								<svg
									viewBox="0 0 24 24"
									fill="none"
									xmlns="http://www.w3.org/2000/svg"
								>
									<path
										d="M9 5l7 7-7 7"
										stroke="currentColor"
										stroke-width="2.5"
										stroke-linecap="round"
										stroke-linejoin="round"></path>
								</svg>
							</button>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- ===================== ACHIEVEMENTS ===================== -->
		<section class="achievements-section">
			<div class="section-container">
				<h2 class="achievements-title">Achievements</h2>
				<p class="achievements-subtitle">
					With immense pride, we underscore our outstanding results, a
					testament to Elance's legacy since its inception. In just
					four years, Elance has consistently delivered unmatched
					results, guiding students towards their dream careers as
					top-class commerce professionals. These achievements aren't
					just milestones; they represent our unwavering dedication to
					nurturing the future leaders of the industry.
				</p>
				<div class="achievements-grid">
					<!-- Left Card -->
					<div class="achievement-card blue-grad-1">
						<div class="achievement-shine"></div>
						<div class="achievement-num">53</div>
						<div class="achievement-label">World Ranks</div>
					</div>
					<!-- Right Card -->
					<div class="achievement-card blue-grad-2">
						<div class="achievement-shine"></div>
						<div class="achievement-num">80</div>
						<div class="achievement-label">National Ranks</div>
					</div>
				</div>
			</div>
		</section>

		<!-- ===================== PARTNERS / CAREER ===================== -->
		<section class="career-section">
			<div class="section-container">
				<h2 class="career-title">
					Begin Your <span class="text-blue">Dream Career</span><br
					/>with Us
				</h2>
				<div class="career-layout">
					<!-- Left: Ambassador -->
					<div class="career-left">
						<div class="career-shape-bg"></div>
						<img
							src="/src/Assets/mamu-sec.webp"
							alt="Brand Ambassador"
							class="career-person-img"
						/>
					</div>
					<!-- Right: Listings -->
					<div class="career-right">
						<!-- Item 1 -->
						<div class="partner-item">
							<div class="partner-logo-wrap">
								<img
									src="/src/Assets/ACCA-Platinum.png"
									alt="Platinum Approved Partner of ACCA"
									class="partner-logo"
								/>
							</div>
							<div class="partner-content">
								<h3 class="partner-name">
									Platinum Approved Partner of ACCA
								</h3>
								<p class="partner-desc">
									Elance Proudly stands as one of the top
									Platinum Approved Partners of ACCA, a
									testament to our exceptional commitment to
									top-tier accounting education and excellent
									academic standards.
								</p>
							</div>
						</div>
						<!-- Item 2 -->
						<div class="partner-item">
							<div class="partner-logo-wrap">
								<img
									src="/src/Assets/CMA-gold-1-e1762840636945.png"
									alt="Gold CMA Course Provider approved by IMA"
									class="partner-logo"
								/>
							</div>
							<div class="partner-content">
								<h3 class="partner-name">
									Gold CMA Course Provider approved by IMA
								</h3>
								<p class="partner-desc">
									Highlighting a commitment to excellence in
									management accounting education, Elance is
									being recognised as a Gold CMA Course
									Provider approved by IMA.
								</p>
							</div>
						</div>
						<!-- Item 3 -->
						<div class="partner-item">
							<div class="partner-logo-wrap">
								<img
									src="/src/Assets/CBE-Center.png"
									alt="ACCA Approved CBE Centre"
									class="partner-logo"
								/>
							</div>
							<div class="partner-content">
								<h3 class="partner-name">
									ACCA Approved CBE Centre
								</h3>
								<p class="partner-desc">
									Elance is an ACCA-approved CBE Centre. This
									license grants our campus the authorization
									to conduct ACCA fundamentals at our Calicut
									campus itself..
								</p>
							</div>
						</div>
						<!-- Item 4 -->
						<div class="partner-item">
							<div class="partner-logo-wrap">
								<img
									src="/src/Assets/Hock.png"
									alt="Approved Partner of HOCK INTERNATIONAL"
									class="partner-logo"
								/>
							</div>
							<div class="partner-content">
								<h3 class="partner-name">
									Approved Partner of HOCK INTERNATIONAL
								</h3>
								<p class="partner-desc">
									Hock International for CMA USA collaborates
									closely with Elance, ensuring top-notch
									instruction using authentic learning
									materials supporting guidance to conquer
									doubts, master the syllabus, and excel in
									certification exams.
								</p>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- ===================== LIFE AT ELANCE ===================== -->
		<section class="life-section">
			<div class="section-container">
				<h2 class="life-title">
					Life at <span class="text-blue">Elance</span>
				</h2>
				<div class="life-slider-wrap">
					<!-- Left Navigation Arrow -->
					<button
						class="life-arrow-btn prev-btn"
						aria-label="Previous"
					>
						<svg
							viewBox="0 0 24 24"
							fill="none"
							xmlns="http://www.w3.org/2000/svg"
						>
							<path
								d="M15 19l-7-7 7-7"
								stroke="currentColor"
								stroke-width="2.5"
								stroke-linecap="round"
								stroke-linejoin="round"></path>
						</svg>
					</button>

					<!-- Cards Container -->
					<div class="life-grid" id="life-grid">
						<!-- Card 1: Orientation Day -->
						<div class="life-card">
							<img
								src="/src/Assets/Resize-09.jpg"
								alt="Elance Orientation Day"
								class="life-card-img"
							/>
							<div class="life-card-overlay">
								<h3 class="life-card-title">
									Elance Orientation Day
								</h3>
								<p class="life-card-desc">
									A warm welcome for new students with
									inspiring sessions and shared experiences to
									kickstart their journey at Elance.
								</p>
							</div>
						</div>

						<!-- Card 2: Health Camps -->
						<div class="life-card">
							<img
								src="/src/Assets/ReSize-03.jpg"
								alt="Health Camps and Check Up at Elance"
								class="life-card-img"
							/>
							<div class="life-card-overlay">
								<h3 class="life-card-title">
									Health Camps and Check Up
								</h3>
								<p class="life-card-desc">
									In addition to academic excellence, we try
									to support students by organizing health
									checkups and placing focus on their
									well-being.
								</p>
							</div>
						</div>
					</div>

					<!-- Right Navigation Arrow -->
					<button class="life-arrow-btn next-btn" aria-label="Next">
						<svg
							viewBox="0 0 24 24"
							fill="none"
							xmlns="http://www.w3.org/2000/svg"
						>
							<path
								d="M9 5l7 7-7 7"
								stroke="currentColor"
								stroke-width="2.5"
								stroke-linecap="round"
								stroke-linejoin="round"></path>
						</svg>
					</button>
				</div>
			</div>
		</section>

		<script>
			const grid = document.getElementById("life-grid");
			const prevBtn = document.querySelector(
				".life-slider-wrap .prev-btn",
			);
			const nextBtn = document.querySelector(
