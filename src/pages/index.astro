	.partner-name {
		font-size: 1.2rem;
		font-weight: 800;
		color: #111827;
		margin-bottom: 8px;
		line-height: 1.3;
	}

	.partner-desc {
		font-size: 0.875rem;
		color: #4b5563;
		line-height: 1.65;
	}

	/* ── LIFE AT ELANCE ── */
	.life-section {
		padding: 80px 0 100px;
		background: #ffffff;
		position: relative;
	}

	.life-title {
		font-size: 2.5rem;
		font-weight: 800;
		text-align: center;
		color: #111827;
		margin-bottom: 56px;
		line-height: 1.25;
