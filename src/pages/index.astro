		font-size: 1.05rem;
		font-weight: 600;
		color: #4b5563;
	}

	.feedback-arrows {
		display: flex;
		gap: 16px;
		margin-top: 24px;
	}

	.feedback-arrows-mobile {
		display: none;
	}

	.arrow-btn {
		width: 48px;
		height: 48px;
		border-radius: 50%;
		border: none;
		background: #50b5ff; /* Sky blue background matching screenshot */
		color: #111827; /* Dark arrow icons */
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
		box-shadow: 0 4px 14px rgba(80, 181, 255, 0.25);
		transition:
			background-color 0.2s,
			transform 0.2s;
	}

	.arrow-btn:hover {
		background: #35a4ee;
		transform: scale(1.05);
	}

	.arrow-btn svg {
		width: 18px;
		height: 18px;
	}

	.feedback-right {
		display: flex;
		justify-content: center;
		align-items: center;
		height: 440px;
		position: relative;
	}

	.feedback-stack-container {
		position: relative;
		width: 320px;
		height: 420px; /* Increased from 380px to show more of the image's height */
	}

	.feedback-card {
		position: absolute;
		width: 100%;
		height: 100%;
		border-radius: 24px;
		overflow: hidden;
		box-shadow: 0 15px 35px rgba(0, 0, 0, 0.08);
		transition:
			transform 0.4s cubic-bezier(0.25, 0.8, 0.25, 1),
			opacity 0.4s ease,
			z-index 0.4s ease;
		background: #fff;
	}

	.feedback-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		pointer-events: none;
		border-radius: 24px; /* Ensure images themselves are rounded in all browsers */
	}

	/* Stack states (shifted left and slightly up) */
	.feedback-card.card-0 {
		transform: translate(0, 0) scale(1);
		z-index: 5;
		opacity: 1;
		pointer-events: auto;
	}

	.feedback-card.card-1 {
		transform: translate(-16px, -12px) scale(0.96);
		z-index: 4;
		opacity: 0.95;
		pointer-events: none;
	}

	.feedback-card.card-2 {
		transform: translate(-32px, -24px) scale(0.92);
		z-index: 3;
		opacity: 0.9;
		pointer-events: none;
	}

	.feedback-card.card-3 {
		transform: translate(-48px, -36px) scale(0.88);
		z-index: 2;
		opacity: 0.85;
		pointer-events: none;
	}

	.feedback-card.card-hidden {
		transform: translate(-64px, -48px) scale(0.84);
		z-index: 1;
		opacity: 0;
		pointer-events: none;
	}

	/* Play button */
	.play-btn {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		width: 60px;
		height: 60px;
		background: rgba(255, 255, 255, 0.45);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
		border-radius: 50%;
		border: 1px solid rgba(255, 255, 255, 0.6);
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		transition:
			transform 0.2s,
			background-color 0.2s;
		z-index: 12;
	}

	.play-btn:hover {
		transform: translate(-50%, -50%) scale(1.08);
		background: rgba(255, 255, 255, 0.6);
	}

	.play-btn svg {
		width: 24px;
		height: 24px;
		fill: #ffffff;
		margin-left: 2px;
	}

	.feedback-card:not(.card-0) .play-btn {
		opacity: 0;
		pointer-events: none;
	}

