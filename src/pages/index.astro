	.achievement-label {
		font-size: 1.25rem;
		font-weight: 700;
		color: #ffffff;
		opacity: 0.95;
		letter-spacing: 0.5px;
		position: relative;
		z-index: 2;
	}

	/* ── CAREER / PARTNERS ── */
	.career-section {
		padding: 80px 0 100px;
		background: #ffffff;
		position: relative;
	}

	.career-title {
		font-size: 2.5rem;
		font-weight: 800;
		text-align: center;
		color: #111827;
		margin-bottom: 56px;
		line-height: 1.25;
	}

	.career-layout {
		display: grid;
		grid-template-columns: 1fr 1.2fr;
		gap: 60px;
		align-items: center;
	}

	.career-left {
		position: relative;
		display: flex;
		justify-content: center;
		align-items: flex-end;
		min-height: 480px;
	}

	.career-shape-bg {
		position: absolute;
		bottom: 20px;
		left: 50%;
		transform: translateX(-50%);
		width: 90%;
		height: 80%;
		background: url("/images/hero-bg-shape-small.webp") no-repeat center
			bottom;
		background-size: contain;
		z-index: 0;
		pointer-events: none;
	}

	.career-person-img {
		position: relative;
		z-index: 1;
		width: 100%;
		max-width: 380px;
		object-fit: contain;
		display: block;
	}

	.career-right {
		display: flex;
		flex-direction: column;
	}

	.partner-item {
		display: flex;
		gap: 24px;
		padding: 24px 0;
		border-bottom: 1.5px solid #f3f4f6;
		align-items: flex-start;
