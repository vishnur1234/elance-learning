		box-shadow: 0 18px 40px rgba(0, 0, 0, 0.12);
	}

	.blue-grad-1 {
		background: linear-gradient(135deg, #4086bf 0%, #1e528b 100%);
	}

	.blue-grad-2 {
		background: linear-gradient(135deg, #1d4d80 0%, #5d97cc 100%);
	}

	.achievement-shine {
		position: absolute;
		width: 180px;
		height: 180px;
		background: url("/images/you-bg.png") no-repeat center center;
		background-size: contain;
		pointer-events: none;
		z-index: 1;
	}

	.blue-grad-1 .achievement-shine {
		top: -40px;
		right: -40px;
		transform: rotate(-20deg);
		opacity: 0.22;
	}

	.blue-grad-2 .achievement-shine {
		top: -40px;
		right: -40px;
		transform: rotate(155deg);
		opacity: 0.25;
	}

	.achievement-num {
