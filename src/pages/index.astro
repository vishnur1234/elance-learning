	.life-arrow-btn {
		width: 52px;
		height: 52px;
		border-radius: 50%;
		border: none;
		background: #eef5fb;
		color: #3b9fe8;
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
		transition:
			background 0.2s,
			color 0.2s,
			transform 0.2s;
