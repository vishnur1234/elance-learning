	/* ── ACHIEVEMENTS ── */
	.achievements-section {
		padding: 80px 0 100px;
		background: linear-gradient(180deg, #ffffff 0%, #eef5fb 100%);
		position: relative;
	}

	.achievements-title {
		font-size: 2.5rem;
		font-weight: 800;
		text-align: center;
		color: #111827;
		margin-bottom: 24px;
	}

	.achievements-subtitle {
		font-size: 0.95rem;
		line-height: 1.8;
		text-align: center;
		color: #4b5563;
		max-width: 900px;
		margin: 0 auto 56px;
	}

	.achievements-grid {
		display: flex;
		gap: 32px;
		justify-content: center;
		align-items: center;
		max-width: 720px;
		margin: 0 auto;
	}

	.achievement-card {
		position: relative;
		overflow: hidden;
		border-radius: 24px;
		padding: 48px 40px;
		text-align: center;
		flex: 1;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		min-height: 240px;
		box-shadow: 0 15px 35px rgba(0, 0, 0, 0.08);
