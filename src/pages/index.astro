function getImageUrl(imgData: any, defaultUrl: string): string {
	if (!imgData) return defaultUrl;
	if (typeof imgData === "string" && imgData.trim() !== "") return imgData;
	if (typeof imgData === "object") {
		return imgData.previewUrl || imgData.src || imgData.url || defaultUrl;
	}
	return defaultUrl;
}

