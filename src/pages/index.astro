		<script>
			// Life at Elance slider
			const grid = document.getElementById("life-grid");
			const prevBtns = document.querySelectorAll(
				".life-slider-wrap .prev-btn",
			);
			const nextBtns = document.querySelectorAll(
				".life-slider-wrap .next-btn",
			);

			if (grid && prevBtns.length > 0 && nextBtns.length > 0) {
				prevBtns.forEach((btn) => {
					btn.addEventListener("click", () => {
						grid.scrollBy({ left: -310, behavior: "smooth" });
					});
				});
				nextBtns.forEach((btn) => {
					btn.addEventListener("click", () => {
						grid.scrollBy({ left: 310, behavior: "smooth" });
					});
				});
			}

			// Student Feedback stack slider
			const feedbackCards = Array.from(
				document.querySelectorAll(".feedback-card"),
			);
			const feedbackName = document.getElementById("feedback-name");
			const feedbackRole = document.getElementById("feedback-role");
			const feedbackPrevs =
				document.querySelectorAll(".prev-feedback-btn");
			const feedbackNexts =
				document.querySelectorAll(".next-feedback-btn");

			if (feedbackCards.length > 0) {
				let activeIndex = 0;
				const total = feedbackCards.length;

				const updateStack = () => {
					feedbackCards.forEach((card, index) => {
						const relativeIndex =
							(index - activeIndex + total) % total;

						card.className = "feedback-card"; // Reset classes

						if (relativeIndex === 0) {
							card.classList.add("card-0");
							if (feedbackName && feedbackRole) {
								feedbackName.textContent =
									card.getAttribute("data-name") || "";
								feedbackRole.textContent =
									card.getAttribute("data-role") || "";
							}
						} else if (relativeIndex === 1) {
							card.classList.add("card-1");
						} else if (relativeIndex === 2) {
							card.classList.add("card-2");
						} else if (relativeIndex === 3) {
							card.classList.add("card-3");
						} else {
							card.classList.add("card-hidden");
						}
					});
				};

				if (feedbackPrevs.length > 0 && feedbackNexts.length > 0) {
					feedbackPrevs.forEach((btn) => {
						btn.addEventListener("click", () => {
							activeIndex = (activeIndex - 1 + total) % total;
							updateStack();
						});
					});
					feedbackNexts.forEach((btn) => {
						btn.addEventListener("click", () => {
							activeIndex = (activeIndex + 1) % total;
							updateStack();
						});
					});
				}

				// Init
				updateStack();
			}

			// Think Banner Testimonials Slider
			const thinkAvatars = Array.from(
				document.querySelectorAll(".think-avatar-container"),
			);
			const thinkQuoteText = document.getElementById("think-quote-text");
			const thinkQuoteName = document.getElementById("think-quote-name");
			const thinkQuoteCompany = document.getElementById(
				"think-quote-company",
			);
			const thinkPrevBtns = document.querySelectorAll(".prev-think-btn");
			const thinkNextBtns = document.querySelectorAll(".next-think-btn");

			const testimonials = [
				{
					quote: "\"With Elance, you won't feel like you're missing out on the college vibe.\"",
					name: "Shringa Surendran",
					company: "KPMG",
					avatarIndex: 0,
				},
				{
					quote: '"Flexible classes and amazing mock exams. Elance is the best choice for professional finance courses."',
					name: "Anagha Anand",
					company: "Deloitte",
					avatarIndex: 1,
				},
				{
					quote: '"The placement support and faculty mentoring at Elance are unmatched in professional coaching."',
					name: "Abhiram",
					company: "EY",
					avatarIndex: 2,
				},
			];

			if (thinkAvatars.length > 0) {
				let currentIndex = 0;

				const updateTestimonial = (index) => {
					currentIndex = index;

					// Update active class on avatars
					thinkAvatars.forEach((avatar, idx) => {
						if (idx === index) {
							avatar.classList.add("active");
						} else {
							avatar.classList.remove("active");
						}
					});

					// Update text content
					const item = testimonials[index];
					if (thinkQuoteText && thinkQuoteName && thinkQuoteCompany) {
						thinkQuoteText.textContent = item.quote;
						thinkQuoteName.textContent = item.name;
						thinkQuoteCompany.textContent = item.company;
					}
				};

				// Add click listeners to avatars
				thinkAvatars.forEach((avatar, idx) => {
					avatar.addEventListener("click", () => {
						updateTestimonial(idx);
					});
				});

				// Arrow buttons
				if (thinkPrevBtns.length > 0 && thinkNextBtns.length > 0) {
					thinkPrevBtns.forEach((btn) => {
						btn.addEventListener("click", () => {
							let prevIdx =
								(currentIndex - 1 + testimonials.length) %
								testimonials.length;
							updateTestimonial(prevIdx);
						});
					});
					thinkNextBtns.forEach((btn) => {
						btn.addEventListener("click", () => {
							let nextIdx =
								(currentIndex + 1) % testimonials.length;
							updateTestimonial(nextIdx);
						});
					});
				}

				// Init
				updateTestimonial(0);
			}

			// Hero Text Carousel & Word Animation
			{
				const eyebrowEl = document.getElementById("hero-eyebrow");
				const headingEl = document.getElementById("hero-heading");

				if (eyebrowEl && headingEl) {
					const slides = [
						{
							eyebrow: "Among the Highest in ACCA & CMA Results",
							heading:
								'Our Students Clear<br />Exams. <span class="hero-blue">Confidently.</span>',
						},
						{
							eyebrow: "From Learner to Leader Starts Here",
							heading:
								'India\'s Most Trusted<br /><span class="hero-blue">Commerce Institute</span>',
						},
					];

					let currentSlide = 0;

					const prepareWordAnimation = (container, htmlContent) => {
						const temp = document.createElement("div");
						temp.innerHTML = htmlContent;
						container.innerHTML = "";
						let wordIndex = 0;

						const processNode = (node) => {
							if (node.nodeType === Node.TEXT_NODE) {
								const words = node.textContent.split(/(\s+)/);
								const fragment =
									document.createDocumentFragment();
								words.forEach((word) => {
									if (word.trim() === "") {
										fragment.appendChild(
											document.createTextNode(word),
										);
									} else {
										const span =
											document.createElement("span");
										span.className = "animate-word";
										span.textContent = word;
										span.style.setProperty(
											"--word-index",
											wordIndex.toString(),
										);
										wordIndex++;
										fragment.appendChild(span);
									}
								});
								return fragment;
							} else if (node.nodeType === Node.ELEMENT_NODE) {
								const clone = node.cloneNode(false);
								Array.from(node.childNodes).forEach((child) => {
									clone.appendChild(processNode(child));
								});
								return clone;
							}
							return node.cloneNode(true);
						};

						Array.from(temp.childNodes).forEach((child) => {
							container.appendChild(processNode(child));
						});
					};

					const showSlide = (index) => {
						eyebrowEl.classList.add("fade-out");
						headingEl.classList.add("fade-out");

						setTimeout(() => {
							const slide = slides[index];
							prepareWordAnimation(eyebrowEl, slide.eyebrow);
							prepareWordAnimation(headingEl, slide.heading);

							eyebrowEl.classList.remove("fade-out");
							headingEl.classList.remove("fade-out");
						}, 400);
					};

					// Initial run
					prepareWordAnimation(eyebrowEl, slides[0].eyebrow);
					prepareWordAnimation(headingEl, slides[0].heading);

					// Make them visible now that they are prepared
					eyebrowEl.classList.add("js-animated");
					headingEl.classList.add("js-animated");

					// Cycle slides every 7 seconds
					setInterval(() => {
						currentSlide = (currentSlide + 1) % slides.length;
						showSlide(currentSlide);
					}, 7000);
				}
			}

			// Courses Slider Mobile Interactivity
			{
				const grid = document.getElementById("coursesGrid");
				const prevBtn = document.getElementById("prevCourseBtn");
				const nextBtn = document.getElementById("nextCourseBtn");

				if (grid && prevBtn && nextBtn) {
					const getScrollAmount = () => {
						const card = grid.querySelector(".course-card");
						return card ? card.clientWidth + 20 : 300; // card width + gap
					};

					prevBtn.addEventListener("click", () => {
						grid.scrollBy({
							left: -getScrollAmount(),
							behavior: "smooth",
						});
					});

					nextBtn.addEventListener("click", () => {
						grid.scrollBy({
							left: getScrollAmount(),
							behavior: "smooth",
						});
					});
				}
			}
		</script>

		<!-- ===================== WE'RE FEATURED ON ===================== -->
		<FeaturedOn />
		<Footer />
	</body>
</html>

