---
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import FeaturedOn from "../components/FeaturedOn.astro";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>Elance – India's Most Trusted Commerce Institute</title>
		<meta
			name="description"
			content="From Learner to Leader. Build your career with globally recognized programs in CMA (US) and ACCA – designed for future commerce leaders."
		/>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,600&family=Outfit:wght@300;400;500;600;700;800;900&display=swap"
			rel="stylesheet"
		/>
		<script is:inline>
			document.documentElement.classList.add("js-enabled");
		</script>
	</head>
	<body>
		<Nav />

		<!-- ===================== HERO ===================== -->
		<section class="hero">
			<div class="hero-container">
				<div class="hero-content">
					<p class="hero-eyebrow" id="hero-eyebrow">
						Among the Highest in ACCA & CMA Results
					</p>
					<h1 class="hero-heading" id="hero-heading">
						Our Students Clear<br />
						Exams. <span class="hero-blue">Confidently.</span>
					</h1>
					<div class="hero-btns">
						<a href="#courses" class="btn-blue-pill"
							>Explore Courses</a
						>
						<a href="contact" class="btn-outline-pill"
							>Speak to a Counsellor</a
						>
					</div>
					<div class="alumni-section">
						<p class="alumni-text">
							Our <span class="alumni-word">alumni</span> work at
						</p>
						<div class="alumni-ticker-wrap">
							<div class="alumni-ticker">
								<!-- Set 1 -->
								<img
									src="/images/deloitte.png"
									alt="Deloitte"
									class="alumni-logo alumni-logo-deloitte"
								/>
								<img
									src="/images/223x53-4.webp"
									alt="KPMG"
									class="alumni-logo alumni-logo-kpmg"
								/>
								<img
									src="/images/223x53-16.png"
									alt="Grant Thornton"
									class="alumni-logo alumni-logo-gt"
								/>
								<img
									src="/images/ey.png"
									alt="EY"
									class="alumni-logo alumni-logo-ey"
								/>
								<img
									src="/images/pwc.png"
									alt="PwC"
									class="alumni-logo alumni-logo-pwc"
								/>
								<!-- Set 2 – duplicate for seamless loop -->
								<img
									src="/images/deloitte.png"
									alt="Deloitte"
									class="alumni-logo alumni-logo-deloitte"
									aria-hidden="true"
								/>
								<img
									src="/images/223x53-4.webp"
									alt="KPMG"
									class="alumni-logo alumni-logo-kpmg"
									aria-hidden="true"
								/>
								<img
									src="/images/223x53-16.png"
									alt="Grant Thornton"
									class="alumni-logo alumni-logo-gt"
									aria-hidden="true"
								/>
								<img
									src="/images/ey.png"
									alt="EY"
									class="alumni-logo alumni-logo-ey"
									aria-hidden="true"
								/>
								<img
									src="/images/pwc.png"
									alt="PwC"
									class="alumni-logo alumni-logo-pwc"
									aria-hidden="true"
								/>
							</div>
						</div>
					</div>
				</div>
				<div class="hero-visual">
					<img
						src="/images/hero-bg-shape-big.png"
						alt=""
						class="hero-shape-big"
						aria-hidden="true"
					/>
					<img
						src="/images/hero-bg-shape-small.webp"
						alt=""
						class="hero-shape-small"
						aria-hidden="true"
					/>
					<img
						src="/images/mammooty-new7.webp"
						alt="Brand Ambassador"
						class="hero-person"
					/>
				</div>
			</div>
		</section>

		<!-- ===================== COURSES ===================== -->
		<section class="courses" id="courses">
			<div class="section-container">
				<h2 class="section-title">
					Pick the <span class="text-blue">Course</span> That Fits Your
					Dream
				</h2>
				<p class="section-subtitle">
					Build your career with globally recognized programs in CMA
					(US),<br />
					and ACCA — designed for future commerce leaders.
				</p>
				<div class="courses-wrap">
					<div class="funnel-bg"></div>
					<div class="courses-grid" id="coursesGrid">
						<!-- ACCA -->
						<div class="course-card">
							<img
								src="/images/accaimage-300x300.png"
								alt="ACCA"
								class="course-logo-img"
							/>
							<h3 class="course-card-title-plain">ACCA</h3>
							<p class="course-desc">
								Qualify for ACCA and get access to the world of
								professional accounting which gives an offer to
								work globally across 180+ countries with high
								demand and good remuneration.
							</p>
							<div class="course-btns">
								<a href="acca" class="btn-blue-pill">Brochure</a
								>
								<a href="acca" class="btn-outline-pill"
									>Know more</a
								>
							</div>
						</div>

						<!-- CMA USA -->
						<div class="course-card">
							<img
								src="/images/cmaimage-300x300.png"
								alt="CMA USA"
								class="course-logo-img"
							/>
							<h3 class="course-name-badge">CMA USA</h3>
							<p class="course-desc">
								Skill up your current working career by becoming
								a Certified Management Accountant and feel the
								advancement of professional accounting.
							</p>
							<div class="course-btns">
								<a href="cma" class="btn-blue-pill">Brochure</a>
								<a href="cma" class="btn-outline-pill"
									>Know more</a
								>
							</div>
						</div>
					</div>

					<!-- Mobile Navigation Arrows -->
					<div class="courses-arrows-mobile">
						<button
							class="course-arrow-btn prev-course-btn"
							id="prevCourseBtn"
							aria-label="Previous Course"
						>
							<svg
								viewBox="0 0 24 24"
								fill="none"
								xmlns="http://www.w3.org/2000/svg"
							>
								<path
									d="M15 19l-7-7 7-7"
									stroke="currentColor"
									stroke-width="2.5"
									stroke-linecap="round"
									stroke-linejoin="round"></path>
							</svg>
						</button>
						<button
							class="course-arrow-btn next-course-btn"
							id="nextCourseBtn"
							aria-label="Next Course"
						>
							<svg
								viewBox="0 0 24 24"
								fill="none"
								xmlns="http://www.w3.org/2000/svg"
							>
								<path
									d="M9 5l7 7-7 7"
									stroke="currentColor"
									stroke-width="2.5"
									stroke-linecap="round"
									stroke-linejoin="round"></path>
							</svg>
						</button>
					</div>
				</div>
			</div>
		</section>

		<!-- ===================== COMMERCE CAREER STEPS ===================== -->
		<section class="steps-section">
			<div class="section-container">
				<h2 class="section-title">
					Your <span class="text-blue">Commerce Career</span> Starts Here
				</h2>
				<div class="steps-grid">
					<div class="step-item">
						<span class="step-number">01</span>
						<div class="step-icon-wrap">
							<img
								src="/images/home-cta-icon1.webp"
								alt="Learn"
								class="step-icon"
							/>
						</div>
						<p class="step-label">Learn</p>
					</div>
					<div class="step-dots"></div>
					<div class="step-item">
						<span class="step-number">02</span>
						<div class="step-icon-wrap">
							<img
								src="/images/home-cta-icon2.webp"
								alt="Perform"
								class="step-icon"
							/>
						</div>
						<p class="step-label">Perform</p>
					</div>
					<div class="step-dots"></div>
					<div class="step-item">
						<span class="step-number">03</span>
						<div class="step-icon-wrap">
							<img
								src="/images/home-cta-icon3.webp"
								alt="Get A Job"
								class="step-icon"
							/>
						</div>
						<p class="step-label">Get A Job</p>
					</div>
				</div>
				<div class="steps-cta">
					<a href="#" class="btn-blue-pill">Reach Us Anytime</a>
				</div>
			</div>
		</section>

		<!-- ===================== TESTIMONIALS ===================== -->
		<section class="testimonials-section">
			<div class="section-container testimonials-layout">
				<!-- Left -->
				<div class="testimonials-left">
					<img
						src="/images/lowq-triangle.png"
						alt=""
						class="testimonials-triangle-bg"
						aria-hidden="true"
					/>
					<p class="testimonials-eyebrow">Testimonials</p>
					<h2 class="testimonials-title">
						<span class="text-blue">Hear From</span> Our<br />
						Previous <span class="text-blue">Students</span>
					</h2>
					<p class="testimonials-desc">
						Elance envisions the courses for everyone to fuel the
						advancement of skills and make you capable of conquering
						your dream career
					</p>
					<a href="#" class="btn-blue-pill">View More</a>
				</div>
				<!-- Right – Testimonial Cards -->
				<div class="testimonials-right">
					<!-- Card 1 -->
					<div class="testimonial-card">
						<span class="testimonial-badge">CA</span>
						<p class="testimonial-quote">
							"All my papers were done online at Elance, with
							wonderful support from the faculty and staff. "
						</p>
						<div class="testimonial-author">
							<img
								src="/images/Anagha-Anand-150x150.webp"
								alt="Anagha Anand"
								class="testimonial-avatar"
							/>
							<div>
								<p class="testimonial-name">Anagha Anand</p>
								<p class="testimonial-course">
									Elance CA Student
								</p>
							</div>
						</div>
					</div>

					<!-- Card 2 -->
					<div class="testimonial-card">
						<span class="testimonial-badge">ACCA</span>
						<p class="testimonial-quote">
							"Elance's online ACCA course and placement drive
							helped me get a job at EY."
						</p>
						<div class="testimonial-author">
							<img
								src="/images/Abhiram-testi.jpg"
								alt="Abhiram"
								class="testimonial-avatar"
							/>
							<div>
								<p class="testimonial-name">Abhiram</p>
								<p class="testimonial-course">ACCA</p>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- ===================== FOR STUDENTS / PROFESSIONALS ===================== -->
		<section class="audience-section">
			<div class="audience-grid">
				<!-- Left Card: Students -->
				<div class="audience-card students-card">
					<img
						src="/images/Studentsai1.jpg"
						alt="For Students"
						class="audience-img"
					/>
					<div class="audience-overlay">
						<p class="audience-overlay-text">
							<span class="label-light">For</span><br />Students
						</p>
					</div>
					<div class="audience-info-box">
						<h3 class="audience-info-title">For Students</h3>
						<p class="audience-info-desc">
							Offering top-tier commerce professional courses like
							ACCA and CMA to propel you into the future of
							finance with high-paying global career opportunities
						</p>
						<a href="#" class="btn-blue-pill-small">Get Started</a>
					</div>
				</div>

				<!-- Right Card: Professionals -->
				<div class="audience-card professionals-card">
					<img
						src="/images/WorkingProfessionalsai.jpg"
						alt="For Working Professionals"
						class="audience-img"
					/>
					<div class="audience-overlay">
						<p class="audience-overlay-text">
							<span class="label-light">For</span> Working<br
							/>Professionals
						</p>
					</div>
					<div class="audience-info-box">
						<h3 class="audience-info-title">
							For Working Professionals
						</h3>
						<p class="audience-info-desc">
							Our flexible learning solutions—online, offline, and
							hybrid, are designed for working professionals, to
							empower and enhance your knowledge and skills, and
							achieve new career heights.
						</p>
						<a href="#" class="btn-blue-pill-small">Get Started</a>
					</div>
				</div>
			</div>
		</section>

		<!-- ===================== PROMO CTA BANNER ===================== -->
		<section class="promo-cta-section">
			<div class="section-container">
				<div class="promo-card">
					<div class="promo-card-decor-1"></div>
					<div class="promo-card-decor-2"></div>
					<h2 class="promo-title">
						Make the Smart Move for a<br />
						Commerce Career<br />
						That Matters!
					</h2>
					<a href="#" class="btn-white-pill">Download Brochure</a>
				</div>
			</div>
		</section>

		<!-- ===================== STUDENT FEEDBACK ===================== -->
		<section class="feedback-section">
			<div class="section-container feedback-layout">
				<!-- Left -->
				<div class="feedback-left">
					<h2 class="feedback-title">
						Our Students <span class="text-blue">Feedback</span>
					</h2>
					<p class="feedback-desc">
						Hear from our students as they share their incredible
						journeys of growth, success, and accomplishments with
						Elance!
					</p>

					<!-- Active Student Info (Dynamic) -->
					<div class="feedback-info">
						<h3 class="feedback-student-name" id="feedback-name">
							Kasinath
						</h3>
						<p class="feedback-student-role" id="feedback-role">
							Elance CA Student
						</p>
					</div>

					<div class="feedback-arrows">
						<button
							class="arrow-btn prev-feedback-btn"
							aria-label="Previous"
						>
							<svg
								viewBox="0 0 24 24"
								fill="none"
								xmlns="http://www.w3.org/2000/svg"
							>
								<path
									d="M15 19l-7-7 7-7"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"></path>
							</svg>
						</button>
						<button
							class="arrow-btn next-feedback-btn"
							aria-label="Next"
						>
							<svg
								viewBox="0 0 24 24"
								fill="none"
								xmlns="http://www.w3.org/2000/svg"
							>
								<path
									d="M9 5l7 7-7 7"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"></path>
							</svg>
						</button>
					</div>
				</div>
				<!-- Right – Feedback Image Stack -->
				<div class="feedback-right">
					<div class="feedback-stack-container" id="feedback-stack">
						<!-- Card 1 -->
						<div
							class="feedback-card"
							data-name="Kasinath"
							data-role="Elance CA Student"
						>
							<img
								src="/images/Ajsal-E.webp"
								alt="Kasinath – Student Feedback"
								class="feedback-img"
							/>
							<button class="play-btn" aria-label="Play video">
								<svg
									viewBox="0 0 24 24"
									fill="white"
									xmlns="http://www.w3.org/2000/svg"
								>
									<path d="M8 5v14l11-7L8 5z"></path>
								</svg>
							</button>
						</div>
						<!-- Card 2 -->
						<div
							class="feedback-card"
							data-name="Anaam Abdul Salam"
							data-role="Elance ACCA Student"
						>
							<img
								src="/images/Anaam-Abdul-Salam.webp"
								alt="Anaam Abdul Salam – Student Feedback"
								class="feedback-img"
							/>
							<button class="play-btn" aria-label="Play video">
								<svg
									viewBox="0 0 24 24"
									fill="white"
									xmlns="http://www.w3.org/2000/svg"
								>
									<path d="M8 5v14l11-7L8 5z"></path>
								</svg>
							</button>
						</div>
						<!-- Card 3 -->
						<div
							class="feedback-card"
							data-name="Ann Mary"
							data-role="Elance CMA Student"
						>
							<img
								src="/images/Ann-Mary.webp"
								alt="Ann Mary – Student Feedback"
								class="feedback-img"
							/>
							<button class="play-btn" aria-label="Play video">
								<svg
									viewBox="0 0 24 24"
									fill="white"
									xmlns="http://www.w3.org/2000/svg"
								>
									<path d="M8 5v14l11-7L8 5z"></path>
								</svg>
							</button>
						</div>
						<!-- Card 4 -->
						<div
							class="feedback-card"
							data-name="Anuradha"
							data-role="Elance CA Student"
						>
							<img
								src="/images/Anuradha.webp"
								alt="Anuradha – Student Feedback"
								class="feedback-img"
							/>
							<button class="play-btn" aria-label="Play video">
								<svg
									viewBox="0 0 24 24"
									fill="white"
									xmlns="http://www.w3.org/2000/svg"
								>
									<path d="M8 5v14l11-7L8 5z"></path>
								</svg>
							</button>
						</div>
						<!-- Card 5 -->
						<div
							class="feedback-card"
							data-name="Ayshath Shahma"
							data-role="Elance ACCA Student"
						>
							<img
								src="/images/Ayshath-Shahma.webp"
								alt="Ayshath Shahma – Student Feedback"
								class="feedback-img"
							/>
							<button class="play-btn" aria-label="Play video">
								<svg
									viewBox="0 0 24 24"
									fill="white"
									xmlns="http://www.w3.org/2000/svg"
								>
									<path d="M8 5v14l11-7L8 5z"></path>
								</svg>
							</button>
						</div>
						<!-- Card 6 -->
						<div
							class="feedback-card"
							data-name="Bijini Koshi"
							data-role="Elance CMA Student"
						>
							<img
								src="/images/Bijini-Koshi.webp"
								alt="Bijini Koshi – Student Feedback"
								class="feedback-img"
							/>
							<button class="play-btn" aria-label="Play video">
								<svg
									viewBox="0 0 24 24"
									fill="white"
									xmlns="http://www.w3.org/2000/svg"
								>
									<path d="M8 5v14l11-7L8 5z"></path>
								</svg>
							</button>
						</div>
					</div>
					<!-- Mobile navigation arrows for feedback section stack -->
					<div class="feedback-arrows-mobile">
						<button
							class="arrow-btn prev-feedback-btn"
							aria-label="Previous"
						>
							<svg
								viewBox="0 0 24 24"
								fill="none"
								xmlns="http://www.w3.org/2000/svg"
							>
								<path
									d="M15 19l-7-7 7-7"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"></path>
							</svg>
						</button>
						<button
							class="arrow-btn next-feedback-btn"
							aria-label="Next"
						>
							<svg
								viewBox="0 0 24 24"
								fill="none"
								xmlns="http://www.w3.org/2000/svg"
							>
								<path
									d="M9 5l7 7-7 7"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"></path>
							</svg>
						</button>
					</div>
				</div>
			</div>

			<!-- What our Students think about us Banner -->
			<div class="section-container">
				<div class="think-banner">
					<!-- Decor shape behind left side using you-bg.png -->
					<div class="think-banner-decor"></div>

					<div class="think-banner-left">
						<h2 class="think-title">
							What our <span class="text-blue"
								>Students<br />think</span
							> about us?
						</h2>
					</div>

					<div class="think-banner-right">
						<div class="think-header-row">
							<div class="think-avatars-wrap">
								<!-- Avatar 1 -->
								<div
									class="think-avatar-container avatar-0 active"
									data-index="0"
								>
									<div class="avatar-backdrop bg-blue"></div>
									<img
										src="/images/i1.jpg"
										alt="Student 1"
										class="think-avatar-img"
									/>
								</div>
								<!-- Avatar 2 -->
								<div
									class="think-avatar-container avatar-1"
									data-index="1"
								>
									<div class="avatar-backdrop bg-purple">
									</div>
									<img
										src="/images/i2.jpg"
										alt="Student 2"
										class="think-avatar-img"
									/>
								</div>
								<!-- Avatar 3 -->
								<div
									class="think-avatar-container avatar-2"
									data-index="2"
								>
									<div class="avatar-backdrop bg-skyblue">
									</div>
									<img
										src="/images/Abhiram-testi.jpg"
										alt="Student 3"
										class="think-avatar-img"
									/>
								</div>
							</div>

							<div class="think-arrows">
								<button
									class="think-arrow-btn prev-think-btn"
									aria-label="Previous"
								>
									<svg
										viewBox="0 0 24 24"
										fill="none"
										xmlns="http://www.w3.org/2000/svg"
									>
										<path
											d="M15 19l-7-7 7-7"
											stroke="currentColor"
											stroke-width="2.5"
											stroke-linecap="round"
											stroke-linejoin="round"></path>
									</svg>
