	.partner-item:first-child {
		padding-top: 0;
	}

	.partner-item:last-child {
		border-bottom: none;
		padding-bottom: 0;
	}

	.partner-logo-wrap {
		flex: 0 0 64px;
		display: flex;
		justify-content: center;
		align-items: center;
		margin-top: 4px;
	}

	.partner-logo {
		width: 100%;
		max-height: 48px;
		object-fit: contain;
		display: block;
