function formatTitleWithBlueWords(
	text: string,
	keywords: string[],
	spanClass: string = "text-blue",
): string {
	if (!text) return "";
	if (text.includes("<span class=")) return text;
	let formatted = text;
	for (const keyword of keywords) {
		const escaped = keyword.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
		const regex = new RegExp(`\\b(${escaped})\\b`, "gi");
		formatted = formatted.replace(
			regex,
			`<span class="${spanClass}">$1</span>`,
		);
	}
	return formatted;
}

