	/* ── WHATSAPP ── */
	.wa-widget {
		position: fixed;
		bottom: 24px;
		right: 24px;
		z-index: 9999;
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 10px;
	}

