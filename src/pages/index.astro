	/* Buttons */
	.btn-blue-pill {
		display: inline-block;
		background: #3b9fe8;
		color: #fff;
		font-size: 0.875rem;
		font-weight: 600;
		padding: 11px 28px;
		border-radius: 100px;
		text-decoration: none;
		transition:
			background 0.2s,
			transform 0.15s;
		box-shadow: 0 4px 14px rgba(59, 159, 232, 0.25);
	}
	.btn-blue-pill:hover {
		background: #2486d0;
		transform: translateY(-1px);
	}

	.btn-outline-pill {
		display: inline-block;
		background: transparent;
		color: #374151;
		font-size: 0.875rem;
		font-weight: 600;
		padding: 10px 24px;
		border-radius: 100px;
		border: 1.5px solid #d1d5db;
