			border-color 0.2s,
			color 0.2s;
	}
	.btn-outline-pill:hover {
		border-color: #3b9fe8;
		color: #3b9fe8;
	}

	/* ── HERO ── */
	.hero {
		background: #ffffff;
		overflow: hidden;
		min-height: 70vh;
		display: flex;
		align-items: stretch;
	}

	.hero-container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 40px;
		display: flex;
		align-items: center;
		gap: 40px;
		width: 100%;
	}

	.hero-content {
		flex: 1;
		padding: 60px 0;
	}

	.hero-eyebrow {
		font-size: 30px;
		font-weight: 550;
		color: #3b9fe8;
		margin-bottom: 18px;
		font-family: "Outfit", sans-serif;
		transition: opacity 0.4s ease;
	}

	.hero-heading {
		font-family: "Outfit", sans-serif;
		font-size: clamp(2.4rem, 4.5vw, 3.6rem);
		font-weight: 900;
		color: #111827;
		line-height: 1.1;
		margin-bottom: 32px;
		transition: opacity 0.4s ease;
	}

	.hero-eyebrow.fade-out,
	.hero-heading.fade-out {
		opacity: 0;
	}

	.animate-word {
		display: inline-block;
		opacity: 0;
		transform: translateY(8px);
		animation: wordReveal 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
		animation-delay: calc(var(--word-index) * 0.05s);
	}

	@keyframes wordReveal {
		to {
			opacity: 1;
			transform: translateY(0);
		}
