---
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Best Commerce Institute in Kannur | Elance Kannur</title>
		<meta
			name="description"
			content="Elance Kannur – India's Most Trusted Commerce Institute. ACCA Platinum Learning Partner & Licensed CBE Centre. Join now at Elance Kannur campus."
		/>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,600&family=Outfit:wght@300;400;500;600;700;800;900&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<Nav />

		<!-- ===================== HERO ===================== -->
		<section class="cc-hero">
			<div class="cc-hero-overlay"></div>
			<video
				class="cc-hero-video"
				autoplay
				muted
				loop
				playsinline
				poster="/src/Assets/ourcenter/calicut/Rectangle-72-scaled.jpg"
			>
				<source src="/src/Assets/ourcenter/calicut/Elance-Calicut.mp4" type="video/mp4" />
			</video>
			<div class="cc-hero-content">
				<p class="cc-hero-eyebrow">WELCOME TO THE</p>
				<h1 class="cc-hero-title">Best Commerce Institute<br />in Kannur</h1>
				<a href="#" class="cc-learn-badge">Learn</a>
				<div class="cc-hero-btns">
					<a href="/acca" class="cc-hero-btn-outline" id="hero-acca-btn-kannur">ACCA</a>
					<a href="/cma" class="cc-hero-btn-outline" id="hero-cma-btn-kannur">CMA USA</a>
				</div>
				<p class="cc-hero-desc">
					Welcome to a world filled with energy, endless learning, and epic memories. At
					Elance Kannur, your career excels as you celebrate friendships, festivities, and
					every exciting moment in between!
				</p>
			</div>
		</section>

		<!-- ===================== LEARNING ECOSYSTEM ===================== -->
		<section class="cc-ecosystem">
			<div class="cc-ecosystem-grid">
				<div class="cc-ecosystem-left">
					<h2 class="cc-ecosystem-title">A Complete Learning<br />Ecosystem</h2>
					<p class="cc-ecosystem-desc">
						At Elance Kannur, education is an experience that goes beyond textbooks. We
						aim to create a supportive and inspiring space where students can
						learn, grow, and discover their full potential—both inside and outside
						the classroom.
					</p>
					<div class="cc-badges">
						<div class="cc-badge-item">
							<img
								src="/src/Assets/ourcenter/calicut/ACCA-Platinum.png"
								alt="ACCA Approved Learning Partner Platinum"
								class="cc-badge-img"
							/>
							<span class="cc-badge-label">Platinum</span>
						</div>
						<div class="cc-badge-item">
							<img
								src="/src/Assets/ourcenter/calicut/Silver-CMA.png"
								alt="Silver CMA Course Provider"
								class="cc-badge-img"
							/>
						</div>
						<div class="cc-badge-item">
							<img
								src="/src/Assets/ourcenter/calicut/CBE-Center.png"
								alt="Licensed ACCA CBE Centre"
								class="cc-badge-img"
							/>
						</div>
					</div>
				</div>
				<div class="cc-ecosystem-right">
					<div class="cc-mammootty-wrap">
						<img
							src="/src/Assets/ourcenter/calicut/Mammootty-2048x1184.jpg"
							alt="Mammootty – Elance Brand Ambassador"
							class="cc-mammootty-img"
						/>
					</div>
				</div>
			</div>
		</section>

		<!-- ===================== MAP + CONTACT ===================== -->
		<section class="cc-locations">
			<div class="cc-locations-inner">

				<!-- Location 1 – Elance Kannur Main Campus -->
				<div class="cc-location-block">
					<div class="cc-map-wrap">
						<iframe
							src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3905.0!2d75.3704!3d11.8745!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3ba42101a7e8e021%3A0xaabbccdd!2sKannur%2C%20Kerala!5e0!3m2!1sen!2sin!4v1720000000004!5m2!1sen!2sin"
							width="100%"
							height="100%"
							style="border:0;"
							allowfullscreen=""
							loading="lazy"
							referrerpolicy="no-referrer-when-downgrade"
							title="Elance Kannur Campus Map"
							class="cc-map-iframe"
						></iframe>
					</div>
					<div class="cc-contact-info">
						<div class="cc-contact-item">
							<div class="cc-contact-icon-wrap">
								<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
							</div>
							<div class="cc-contact-text">
								<h3 class="cc-contact-name">Elance Kannur Campus</h3>
								<p class="cc-contact-detail">Elance Knowledge Centre, SM Street, Kannur, Kerala 670001</p>
							</div>
						</div>
						<div class="cc-contact-item">
							<div class="cc-contact-icon-wrap">
								<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.41 2 2 0 0 1 3.6 1.22h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.79a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
							</div>
							<div class="cc-contact-text">
								<h3 class="cc-contact-name">Call us</h3>
								<p class="cc-contact-detail">+ 91 98950 97070</p>
							</div>
						</div>
						<div class="cc-contact-item">
							<div class="cc-contact-icon-wrap">
								<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
							</div>
							<div class="cc-contact-text">
								<h3 class="cc-contact-name">Connect us</h3>
								<p class="cc-contact-detail">info@elancelearning.com</p>
							</div>
						</div>
					</div>
				</div>

				<!-- Location 2 – Elance Kannur Study Centre -->
				<div class="cc-location-block cc-location-block--reversed">
					<div class="cc-contact-info">
						<div class="cc-contact-item">
							<div class="cc-contact-icon-wrap">
								<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
							</div>
							<div class="cc-contact-text">
								<h3 class="cc-contact-name">Elance Study Centre</h3>
								<p class="cc-contact-detail">Elance Tower, Near Kannur Railway Station, Kannur, Kerala 670002</p>
							</div>
						</div>
						<div class="cc-contact-item">
							<div class="cc-contact-icon-wrap">
								<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.41 2 2 0 0 1 3.6 1.22h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.79a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
							</div>
							<div class="cc-contact-text">
								<h3 class="cc-contact-name">Call us</h3>
								<p class="cc-contact-detail">+ 91 98950 97070</p>
							</div>
						</div>
						<div class="cc-contact-item">
							<div class="cc-contact-icon-wrap">
								<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
							</div>
							<div class="cc-contact-text">
								<h3 class="cc-contact-name">Connect us</h3>
								<p class="cc-contact-detail">info@elancelearning.com</p>
							</div>
						</div>
					</div>
					<div class="cc-map-wrap">
						<iframe
							src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3905.0!2d75.3804!3d11.8645!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3ba42101a7e8e021%3A0xaabbccee!2sKannur%20Railway%20Station!5e0!3m2!1sen!2sin!4v1720000000005!5m2!1sen!2sin"
							width="100%"
							height="100%"
							style="border:0;"
							allowfullscreen=""
							loading="lazy"
							referrerpolicy="no-referrer-when-downgrade"
							title="Elance Kannur Study Centre Map"
							class="cc-map-iframe"
						></iframe>
					</div>
				</div>

			</div>
		</section>

		<!-- ===================== CTA BANNER ===================== -->
		<section class="cc-cta-banner">
			<div class="cc-cta-inner">
				<div class="cc-cta-text">
					<h2 class="cc-cta-title">India's Most<br />Trusted Commerce Institute</h2>
					<p class="cc-cta-desc">
						With a commitment to excellence and industry-relevant training, we empower
						students with the knowledge, skills, and confidence to excel in global
						commerce. Join thousands of learners who trust us to shape their future.
					</p>
				</div>
				<a href="/contact" class="cc-cta-btn" id="cta-register-btn-kannur">Register Now</a>
			</div>
		</section>

		<!-- ===================== 4 PILLARS ===================== -->
		<section class="cc-pillars">
			<div class="cc-pillars-grid">
				<!-- Learn -->
				<div class="cc-pillar-card">
					<div class="cc-pillar-img-wrap">
						<img
							src="/src/Assets/ourcenter/calicut/Expert-mentors-300x200.jpg"
							alt="Learn from the Best"
							class="cc-pillar-img"
						/>
					</div>
					<div class="cc-pillar-body">
						<h3 class="cc-pillar-heading">
							<span class="cc-pillar-title">Learn</span><br />
							<span class="cc-pillar-sub">from the Best</span>
						</h3>
						<p class="cc-pillar-desc">
							Learning is built on strong academic structure, expert-led teaching, and
							continuous guidance here. With experienced faculty, personalised mentorship,
							regular assessments, and dedicated academic support, students develop the
							clarity, consistency, and confidence needed to excel. For students searching
							for the best commerce coaching in Kannur, Elance offers a focused and
							supportive academic environment.
						</p>
					</div>
				</div>

				<!-- Grow -->
				<div class="cc-pillar-card">
					<div class="cc-pillar-img-wrap">
						<img
							src="/src/Assets/ourcenter/calicut/image-11-300x200.jpg"
							alt="Grow with Confidence"
							class="cc-pillar-img"
						/>
					</div>
					<div class="cc-pillar-body">
						<h3 class="cc-pillar-heading">
							<span class="cc-pillar-title">Grow</span><br />
							<span class="cc-pillar-sub">with Confidence</span>
						</h3>
						<p class="cc-pillar-desc">
							We focus on shaping students into confident, career-ready professionals
							through leadership programs, communication training, corporate grooming, and
							industry-focused skill development. From resume building to interview
							preparation, every initiative is designed to strengthen both professional
							presence and career readiness.
						</p>
					</div>
				</div>

				<!-- Discover -->
				<div class="cc-pillar-card">
					<div class="cc-pillar-img-wrap">
						<div class="cc-pillar-img-blue"></div>
					</div>
					<div class="cc-pillar-body">
						<h3 class="cc-pillar-heading">
							<span class="cc-pillar-title">Discover</span><br />
							<span class="cc-pillar-sub">Your True Path</span>
						</h3>
						<p class="cc-pillar-desc">
							Students explore their strengths through immersive practical learning
							experiences through our industry-focused student clubs, competitions, industry
							exposure, and student-driven activities. Initiatives like LEAP, EDGE, Excel
							Hackathon, and AuditLab help learners apply knowledge in real-world scenarios
							while discovering their interests and future direction.
						</p>
					</div>
				</div>

				<!-- Experience -->
				<div class="cc-pillar-card">
					<div class="cc-pillar-img-wrap">
						<img
							src="/src/Assets/ourcenter/calicut/Elan-festa-300x200.jpg"
							alt="Experience the Journey"
							class="cc-pillar-img"
						/>
					</div>
					<div class="cc-pillar-body">
						<h3 class="cc-pillar-heading">
							<span class="cc-pillar-title">Experience</span><br />
							<span class="cc-pillar-sub">the Journey</span>
						</h3>
						<p class="cc-pillar-desc">
							Life at Elance Kannur goes beyond classrooms to create a complete student
							experience. Through events, vibrant celebrations, industry interaction,
							placements, and a supportive campus environment, students become part of a
							vibrant learning ecosystem that prepares them for real-world success.
						</p>
					</div>
				</div>
			</div>
		</section>

		<Footer />
	</body>
</html>

<style>
	* {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	body {
		font-family: "Outfit", "Inter", sans-serif;
		background-color: #ffffff;
		color: #1e293b;
	}

	a {
		text-decoration: none;
	}

	/* ─────────────────────────────────────────
	   HERO
	───────────────────────────────────────── */
	.cc-hero {
		position: relative;
		min-height: 520px;
		display: flex;
		align-items: center;
		overflow: hidden;
	}

	.cc-hero-video {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		z-index: 0;
	}

	.cc-hero-overlay {
		position: absolute;
		inset: 0;
		background: rgba(20, 50, 100, 0.55);
		z-index: 1;
	}

	.cc-hero-content {
		position: relative;
		z-index: 2;
		padding: 64px 80px;
		max-width: 700px;
		color: #fff;
	}

	.cc-hero-eyebrow {
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		color: #e2f0ff;
		margin-bottom: 10px;
		font-family: "Outfit", sans-serif;
		text-transform: uppercase;
	}

	.cc-hero-title {
		font-size: clamp(2.2rem, 4.5vw, 3rem);
		font-weight: 800;
		line-height: 1.18;
		color: #ffffff;
		font-family: "Outfit", sans-serif;
		margin-bottom: 18px;
	}

	.cc-learn-badge {
		display: inline-block;
		background: transparent;
		border: 1.5px solid #3b9fe8;
		color: #3b9fe8;
		font-size: 0.85rem;
		font-weight: 700;
		padding: 4px 18px;
		border-radius: 100px;
		margin-bottom: 18px;
		font-family: "Outfit", sans-serif;
		transition: all 0.2s ease;
	}

	.cc-learn-badge:hover {
		background: #3b9fe8;
		color: #fff;
	}

	.cc-hero-btns {
		display: flex;
		gap: 14px;
		margin-bottom: 24px;
		flex-wrap: wrap;
	}

	.cc-hero-btn-outline {
		display: inline-block;
		border: 2px solid #ffffff;
		color: #ffffff;
		font-size: 0.95rem;
		font-weight: 700;
		padding: 10px 28px;
		border-radius: 8px;
		font-family: "Outfit", sans-serif;
		transition: all 0.2s ease;
		letter-spacing: 0.02em;
	}

	.cc-hero-btn-outline:hover {
		background: #fff;
		color: #1c4e8f;
	}

	.cc-hero-desc {
		font-size: 0.98rem;
		line-height: 1.65;
		color: rgba(255, 255, 255, 0.9);
		max-width: 540px;
		font-family: "Outfit", sans-serif;
	}

	/* ─────────────────────────────────────────
	   LEARNING ECOSYSTEM
	───────────────────────────────────────── */
	.cc-ecosystem {
		padding: 80px 60px;
		max-width: 1300px;
		margin: 0 auto;
	}

	.cc-ecosystem-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 60px;
		align-items: center;
	}

	.cc-ecosystem-left {
		display: flex;
		flex-direction: column;
		gap: 24px;
	}

	.cc-ecosystem-title {
		font-size: clamp(1.9rem, 3vw, 2.6rem);
		font-weight: 800;
		color: #1e293b;
		font-family: "Outfit", sans-serif;
		line-height: 1.2;
	}

	.cc-ecosystem-desc {
		font-size: 1rem;
		line-height: 1.7;
		color: #475569;
		font-family: "Outfit", sans-serif;
		max-width: 480px;
	}

	.cc-badges {
		display: flex;
		align-items: center;
		gap: 20px;
		flex-wrap: wrap;
	}

	.cc-badge-item {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 4px;
	}

	.cc-badge-img {
		width: 72px;
		height: 72px;
		object-fit: contain;
	}

	.cc-badge-label {
		font-size: 0.72rem;
		font-weight: 700;
		color: #64748b;
		font-family: "Outfit", sans-serif;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.cc-ecosystem-right {
		display: flex;
		justify-content: flex-end;
	}

	.cc-mammootty-wrap {
		background: linear-gradient(135deg, #4db8e8 0%, #2196c8 60%, #cce8f8 100%);
		border-radius: 20px;
		overflow: hidden;
		width: 100%;
		max-width: 500px;
		aspect-ratio: 4 / 3;
	}

	.cc-mammootty-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top center;
		display: block;
	}

	/* ─────────────────────────────────────────
	   MAP + CONTACT
	───────────────────────────────────────── */
	.cc-locations {
		background: #f8fafc;
		padding: 60px 0 80px;
	}

	.cc-locations-inner {
		max-width: 1300px;
		margin: 0 auto;
		padding: 0 60px;
		display: flex;
		flex-direction: column;
		gap: 60px;
	}

	.cc-location-block {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 40px;
		align-items: start;
	}

	.cc-map-wrap {
		border-radius: 16px;
		overflow: hidden;
		height: 360px;
		box-shadow: 0 4px 24px rgba(0, 0, 0, 0.08);
	}

	.cc-map-iframe {
		width: 100%;
		height: 100%;
		border: none;
		display: block;
	}

	.cc-contact-info {
		background: #fff;
		border-radius: 16px;
		padding: 12px 28px;
		box-shadow: 0 2px 16px rgba(0, 0, 0, 0.06);
		display: flex;
		flex-direction: column;
	}

	.cc-contact-item {
		display: flex;
		align-items: flex-start;
		gap: 18px;
		padding: 22px 0;
		border-bottom: 1px solid #f1f5f9;
	}

	.cc-contact-item:last-child {
		border-bottom: none;
	}

	.cc-contact-icon-wrap {
		width: 48px;
		height: 48px;
		border-radius: 50%;
		border: 1.5px solid #e2e8f0;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		color: #334155;
	}

	.cc-contact-name {
		font-size: 1.05rem;
		font-weight: 700;
		color: #1e293b;
		font-family: "Outfit", sans-serif;
		margin-bottom: 4px;
	}

	.cc-contact-detail {
		font-size: 0.92rem;
		color: #64748b;
		font-family: "Outfit", sans-serif;
		line-height: 1.5;
	}

	/* ─────────────────────────────────────────
	   CTA BANNER
	───────────────────────────────────────── */
	.cc-cta-banner {
		background: linear-gradient(120deg, #2d8bc8 0%, #3ba3e0 40%, #5bc4f0 100%);
		padding: 64px 60px;
	}

	.cc-cta-inner {
		max-width: 1300px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 40px;
