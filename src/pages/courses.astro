---
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import FeaturedOn from "../components/FeaturedOn.astro";
import { getEmDashCollection } from "../lib/cms.js";
import { getMediaUrl } from "../utils/media.js";

// Fetch published courses from EmDash CMS
const { entries: courses = [] } = await getEmDashCollection('courses', {
	status: 'published',
}).catch(() => ({ entries: [] }));
---


<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>
			Your Learning Journey Starts Here | Courses by Elance Learning
		</title>
		<meta
			name="description"
			content="Looking to learn something new or grow your career? Elance Learning offers beginner-friendly, flexible courses designed to fit your life and goals."
		/>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,600&family=Outfit:wght@300;400;500;600;700;800;900&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<Nav />

		<!-- ===================== HERO SECTION ===================== -->
		<section class="courses-hero">
			<div class="section-container hero-inner">
				<h1 class="hero-title">
					Become a Globally Recognized <br />
					<span class="text-blue">Commerce Professional!</span>
				</h1>
				<p class="hero-desc">
					Gain the skills, credibility, and global recognition to
					excel in today's competitive business world with
					industry-relevant commerce professional courses.
				</p>

				<div class="hero-visual-wrap">
					<!-- Elance Logo Trigon Shape -->
					<img
						src="/images/3d-triangle.png"
						alt=""
						class="hero-trigon"
						aria-hidden="true"
					/>
					<!-- ACCA Pill -->
					<a href="#acca" class="course-pill-btn acca-pill">ACCA</a>
					<!-- CMA USA Pill -->
					<a href="#cma" class="course-pill-btn cma-pill">CMA USA</a>
					<!-- Brand Ambassador Centered -->
					<img
						src="/images/mammu2.png"
						alt="Brand Ambassador"
						class="hero-ambassador"
					/>
				</div>
			</div>
		</section>

		<!-- ===================== WHY CHOOSE CARD ===================== -->
		<section class="why-choose-section">
			<div class="section-container">
				<div class="choose-card">
					<div class="choose-left">
						<!-- Study Group Graphic -->
						<div class="classroom-img-wrap">
							<img
								src="/images/courses/Slider-Elance-2.jpg"
								alt="Students Studying"
								class="classroom-img"
							/>
						</div>
					</div>
					<div class="choose-right">
						<h2 class="choose-title">
							Why Choose Commerce <br />Professional Courses?
						</h2>
						<p class="choose-desc">
							The finance and business world are evolving faster
							than ever with new technologies, global standards,
							and rising industry expectations. Commerce
							professional courses are designed to equip you with
							the practical skills, strategic mindset, and
							prestigious global credentials required to excel in
							today's competitive business landscape.
						</p>
						<a href="#courses" class="btn-choose-outline"
							>Explore Programs</a
						>
					</div>
				</div>

				<!-- Area 1: Why Choose Cards (Dark Blue) -->
				<div class="why-choose-grid">
					<div class="why-card">
						<h3>Relevant in Today's <br />Job Market</h3>
						<p>These certifications are built around current industry demands, making you job-ready from day one.</p>
					</div>
					<div class="why-card">
						<h3>Practical & Global</h3>
						<p>They combine real-world applications with global recognition, opening doors across countries and industries.</p>
					</div>
					<div class="why-card">
						<h3>Trusted by <br />Employers</h3>
						<p>Top companies value professionals with specialised, updated skills —not just theoretical knowledge.</p>
					</div>
					<div class="why-card">
						<h3>Career-Focused</h3>
						<p>Designed for faster career progression, better roles, and leadership tracks.</p>
					</div>
				</div>
			</div>
		</section>

		<!-- ===================== OPPORTUNITIES SECTION ===================== -->
		<section class="opportunities-section">
			<div class="section-container opportunities-container">
				<div class="opportunities-left">
					<h2 class="opportunities-title">Opportunities with <br/>Commerce <br/>Professional <br/>Courses</h2>
					<p class="opportunities-desc">
						Commerce professional certifications are increasingly becoming the benchmark for hiring in finance, accounting, and business roles. Designed in line with global standards, these qualifications equip individuals with practical, up-to-date skills that meet the evolving needs of modern industries.
					</p>
					<div class="opportunities-logos">
						<img src="/images/courses/trust.svg" alt="ACCA Platinum Learning Partner" class="partner-logo" />
						<img src="/images/courses/Silver-CMA.png" alt="Silver CMA Course Provider IMA" class="partner-logo" />
						<img src="/images/courses/CBE-Center.png" alt="Licensed ACCA CBE Centre" class="partner-logo" />
					</div>
				</div>
				<div class="opportunities-right">
					<div class="opportunities-col">
						<div class="opportunity-card">
							<h3>Global <br/>Recognition</h3>
							<p>Commerce professional certifications like ACCA and CMA USA are recognised worldwide, giving professionals the flexibility to work abroad or with international firms operating in India.</p>
						</div>
						<div class="opportunity-card">
							<h3>Diverse Job <br/>Roles</h3>
							<p>The commerce professional courses open doors to roles like Financial Analyst, Auditor, Tax Consultant, Risk Manager, and even CFO across both national and international markets.</p>
						</div>
					</div>
					<div class="opportunities-col offset-col">
						<div class="opportunity-card">
							<h3>Higher Earning <br/>Potential</h3>
							<p>Certified commerce professionals in India typically earn 30-60% more than their non-certified peers. Entry-level salaries range from ₹6-10 LPA, with mid- to senior-level roles offering packages of ₹15-40 LPA and beyond, depending on the role and experience.</p>
						</div>
						<div class="opportunity-card">
							<h3>Career <br/>Versatility</h3>
							<p>Certified professionals are eligible for roles across various sectors including banking, consulting, fintech, corporate finance, and public practice.</p>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- ===================== COURSES WE OFFER SECTION ===================== -->
		<section class="courses-offer-section" id="courses">
			<div class="section-container">
				<h2 class="courses-offer-title">Courses we offer at Elance</h2>
				<div class="courses-offer-grid">
					<div class="course-offer-card" id="acca">
						<img src="/images/accaimage-300x300.png" alt="ACCA" class="course-offer-logo" />
						<p class="course-offer-desc">
							ACCA is one of the world's most respected accounting qualifications, recognised in 180+ countries and trusted by over 7,600 approved employers globally. With a curriculum built around international standards, ethics, and digital finance, ACCA prepares professionals for high-impact roles in auditing, taxation, risk management, and financial strategy.
						</p>
						<a href="#" class="course-offer-link">Learn More &rarr;</a>
					</div>
					
					<div class="course-offer-card" id="cma">
						<img src="/images/cmaimage-300x300.png" alt="CMA USA" class="course-offer-logo" />
						<p class="course-offer-desc">
							CMA USA is a globally recognised certification in management accounting, awarded by the Institute of Management Accountants (IMA). Recognised in 150+ countries and preferred by Fortune 500 companies, the CMA credential focuses on financial strategy, cost control, and performance analysis—making it ideal for professionals aiming for leadership roles in finance.
						</p>
						<a href="#" class="course-offer-link">Learn More &rarr;</a>
					</div>
				</div>
			</div>
		</section>

		<!-- ===================== VIDEO BANNER SECTION ===================== -->
		<section class="video-banner-section">
			<video autoplay loop muted playsinline class="video-banner-bg">
				<source src="/images/mp4/CALICUT.mp4" type="video/mp4" />
			</video>
			<div class="video-banner-overlay"></div>
			<div class="section-container video-banner-content">
				<h2 class="video-banner-title">
					Step Into a Future-Ready Finance <br />Career. <br />Choose Elance
				</h2>
				<p class="video-banner-subtitle">Begin your career now</p>
			</div>
		</section>

		<!-- ===================== ACCREDITATIONS & STATS SECTION ===================== -->
		<section class="stats-grid-section">
			<div class="section-container stats-grid-container">
				<div class="stats-card">
					<img src="/images/courses/trophy.svg" alt="Trophy Icon" class="stats-card-icon" />
					<p class="stats-card-text">44 World Ranks & 68 <br>National Ranks</p>
				</div>
				
				<div class="stats-card">
					<img src="/images/courses/trust.svg" alt="ACCA Platinum Logo" class="stats-card-icon" />
					<p class="stats-card-text">Platinum Approved <br>Partner of ACCA</p>
				</div>
				
				<div class="stats-card">
					<img src="/images/courses/Silver-CMA.png" alt="Silver CMA Logo" class="stats-card-icon" />
					<p class="stats-card-text">Silver CMA Course <br>Provider by IMA</p>
				</div>
				
				<div class="stats-card">
					<img src="/images/courses/CBE-Center.png" alt="ACCA CBE Centre" class="stats-card-icon" />
					<p class="stats-card-text">ACCA Approved <br>CBE Centre</p>
				</div>
				
				<div class="stats-card">
					<img src="/images/courses/Hock.png" alt="Hock International Logo" class="stats-card-icon hock-logo" />
					<p class="stats-card-text">Approved Partner of <br>HOCK International</p>
				</div>
				
				<div class="stats-card">
					<img src="/images/courses/faculty.svg" alt="Faculty Icon" class="stats-card-icon" />
					<p class="stats-card-text">India's No 1 <br>Faculty Line-Up</p>
				</div>
				
				<div class="stats-card">
					<img src="/images/courses/100.svg" alt="100 Percent Icon" class="stats-card-icon" />
					<p class="stats-card-text">100/100 in FR <br>(ACCA Dec ‘24 <br>Session)</p>
				</div>
				
				<div class="stats-card">
					<img src="/images/courses/pass.svg" alt="Pass Icon" class="stats-card-icon" />
					<p class="stats-card-text">5000+ Passes in the <br>Past 1 Year</p>
				</div>
			</div>
		</section>

		<!-- ===================== FAQ SECTION ===================== -->
		<section class="faq-section">
			<div class="section-container">
				<h2 class="faq-title">Frequently Asked Questions</h2>
				<div class="faq-accordion">
					<details class="faq-item">
						<summary class="faq-summary">
							<span class="faq-question">Is professional certification better than a degree?</span>
							<span class="faq-icon"></span>
						</summary>
						<div class="faq-content">
							<p>While a university degree provides a broad academic foundation, professional certifications like ACCA and CMA USA focus on specialized, practical knowledge that is directly applicable to the workplace. Many employers prefer certified professionals because they are job-ready from day one, often leading to better roles and faster career progression.</p>
						</div>
					</details>

					<details class="faq-item">
						<summary class="faq-summary">
							<span class="faq-question">Which certification is most suitable for a finance career?</span>
							<span class="faq-icon"></span>
						</summary>
						<div class="faq-content">
							<p>It depends on your career goals. If you want to specialize in global accounting, auditing, and taxation, ACCA is highly respected worldwide. If your focus is on management accounting, financial analysis, corporate finance, and strategic planning, CMA USA is the ideal choice.</p>
						</div>
					</details>

					<details class="faq-item">
						<summary class="faq-summary">
							<span class="faq-question">Will a certification impact my salary?</span>
							<span class="faq-icon"></span>
						</summary>
						<div class="faq-content">
							<p>Yes, certified commerce professionals typically earn significantly more than their non-certified peers. In India, entry-level salaries for ACCA or CMA professionals range from ₹6–10 LPA, while experienced senior roles can offer packages of ₹15–40 LPA and beyond.</p>
						</div>
					</details>

					<details class="faq-item">
						<summary class="faq-summary">
							<span class="faq-question">Can I pursue these certifications along with college or a job?</span>
							<span class="faq-icon"></span>
						</summary>
						<div class="faq-content">
							<p>Absolutely. Both ACCA and CMA USA offer flexible exam schedules and study options. You can prepare for the papers at your own pace, making it highly feasible to balance your study with college graduation (like B.Com) or full-time employment.</p>
						</div>
					</details>

					<details class="faq-item">
						<summary class="faq-summary">
							<span class="faq-question">Which is the Best Institute to study ACCA in Calicut?</span>
							<span class="faq-icon"></span>
						</summary>
						<div class="faq-content">
							<p>Elance Learning is recognized as one of the premier learning institutes for ACCA in Calicut. With platinum-approved learning partner status, expert faculty, and high pass rates, we provide comprehensive training and placement support to ensure your success.</p>
						</div>
					</details>

					<details class="faq-item">
						<summary class="faq-summary">
							<span class="faq-question">How long does it take to complete ACCA and CMA USA?</span>
							<span class="faq-icon"></span>
						</summary>
						<div class="faq-content">
							<p>CMA USA can typically be completed in 12 to 18 months as it consists of only 2 exam parts. ACCA, which has up to 13 papers depending on exemptions, generally takes 2 to 3 years to complete.</p>
						</div>
					</details>

					<details class="faq-item">
						<summary class="faq-summary">
							<span class="faq-question">What makes Elance a leading ACCA institute in Kochi?</span>
							<span class="faq-icon"></span>
						</summary>
						<div class="faq-content">
							<p>Elance's Kochi campus offers state-of-the-art classroom facilities, direct mentorship programs, industry-aligned course material, and an active placement cell. Our status as a Licensed CBE Centre also allows students to take exams locally and conveniently.</p>
						</div>
					</details>
				</div>
			</div>
		</section>

		<!-- ===================== WE'RE FEATURED ON ===================== -->
		<FeaturedOn />

		<Footer />
	</body>
</html>

<style>
	*,
	*::before,
	*::after {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	html,
	body {
		font-family: "Outfit", sans-serif;
		background: #ffffff;
		color: #212529;
		line-height: 1.6;
		overflow-x: hidden;
	}

	.section-container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 40px;
		width: 100%;
	}

	.text-blue {
		color: #1a9ee5;
	}

	/* ── HERO ── */
	.courses-hero {
		padding: 30px 0 0;
		background: #ffffff;
		position: relative;
		overflow: hidden;
	}

	.hero-inner {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
	}

	.hero-title {
		font-size: clamp(2.2rem, 4.5vw, 3.2rem);
		font-weight: 800;
		color: #1e293b;
		line-height: 1.2;
		margin-bottom: 20px;
	}

	.hero-desc {
		font-size: 1.05rem;
		color: #4b5563;
		line-height: 1.6;
		max-width: 780px;
		margin-bottom: 10px;
	}

	.hero-visual-wrap {
		position: relative;
		width: 100%;
		max-width: 720px;
		height: 520px;
		margin-top: -24px;
		display: flex;
		justify-content: center;
		align-items: flex-end;
		z-index: 10;
	}

	.hero-trigon {
		position: absolute;
		top: 7%;
		left: 50%;
		transform: translateX(-50%);
		width: 480px;
		height: auto;
		z-index: 0;
		opacity: 0.9;
	}

	.hero-ambassador {
		position: relative;
		z-index: 2;
		width: 100%;
		max-width: 650px;
		height: auto;
		object-fit: contain;
		display: block;
		margin-bottom: 40;
	}

	/* Course Pill Buttons */
	.course-pill-btn {
		position: absolute;
		z-index: 3;
		background: #ffffff;
		border: 1.5px solid #3b9fe8;
		border-radius: 100px;
		padding: 14px 44px;
		font-family: "Outfit", sans-serif;
		font-size: 16px;
		font-weight: 700;
		color: #1a9ee5;
		text-decoration: none;
		box-shadow: 0 10px 25px rgba(0, 0, 0, 0.05);
		transition: all 0.25s ease;
	}

	.course-pill-btn:hover {
		background: #1a9ee5;
		color: #ffffff;
		transform: translateY(-2px);
		box-shadow: 0 15px 30px rgba(26, 158, 229, 0.2);
	}

	.acca-pill {
		top: 42%;
		left: 4%;
	}

	.cma-pill {
		top: 45%;
		right: 4%;
	}

	/* ── WHY CHOOSE CARD ── */
	.why-choose-section {
		padding: 20px 0 80px;
		background: #ffffff;
		margin-top: -60px;
		z-index: 20;
	}

	.choose-card {
		background: url("/images/courses/Slider-Elance-2.jpg") no-repeat
			left center;
		background-size: cover;
		border-radius: 32px;
		overflow: hidden;
		display: grid;
		grid-template-columns: 1.15fr 0.85fr;
		position: relative;
		box-shadow: 0 20px 45px rgba(25, 160, 230, 0.15);
	}

	.choose-left {
		position: relative;
		display: block;
		width: 100%;
		height: 100%;
		min-height: 350px;
		overflow: hidden;
	}

	.classroom-img-wrap {
		width: 100%;
		height: 100%;
		position: relative;
		z-index: 2;
		display: none; /* Hide on desktop since background image covers card */
	}

	.classroom-img-wrap::after {
		content: "";
		position: absolute;
		top: 0;
		right: -1px;
		bottom: 0;
		width: 150px;
		background: linear-gradient(
			to right,
			rgba(25, 160, 230, 0) 0%,
			#19a0e6 100%
		);
		z-index: 3;
		pointer-events: none;
	}

	.classroom-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: left center;
		display: block;
	}

	.trigon-watermark-img {
		position: absolute;
		bottom: 0;
		left: 0;
		width: 230px;
		height: 180px;
		object-fit: cover;
		z-index: 3;
		clip-path: polygon(0 25%, 46% 25%, 95% 100%, 0 100%);
		pointer-events: none;
	}

	.choose-right {
		padding: 48px;
		display: flex;
		flex-direction: column;
		justify-content: center;
		color: #ffffff;
		z-index: 2;
	}

	.choose-title {
		font-size: 2rem;
		font-weight: 800;
		line-height: 1.25;
		margin-bottom: 16px;
	}

	.choose-desc {
		font-size: 0.95rem;
		line-height: 1.65;
		margin-bottom: 24px;
		opacity: 0.95;
	}

	.btn-choose-outline {
		text-decoration: none;
		color: #ffffff;
		border: 1.5px solid #ffffff;
		font-family: "Outfit", sans-serif;
		font-size: 14px;
		font-weight: 600;
		height: 46px;
		padding: 0 28px;
		border-radius: 100px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		transition: all 0.2s ease;
		align-self: flex-start;
	}

	.btn-choose-outline:hover {
		background: #ffffff;
		color: #19a0e6;
		transform: translateY(-2px);
	}

	/* ── WHY CHOOSE GRID (DARK BLUE CARDS) ── */
	.why-choose-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 24px;
		margin-top: 50px;
	}

	.why-card {
		background-color: #0b4a8f;
		border-radius: 24px;
		padding: 40px 32px;
		color: #ffffff;
		display: flex;
		flex-direction: column;
		gap: 16px;
		transition: transform 0.3s ease, box-shadow 0.3s ease;
	}

	.why-card:hover {
		transform: translateY(-6px);
		box-shadow: 0 12px 30px rgba(11, 74, 143, 0.25);
	}

	.why-card h3 {
		font-size: 1.35rem;
		font-weight: 700;
		line-height: 1.3;
		color: #ffffff;
	}

	.why-card p {
		font-size: 0.95rem;
		line-height: 1.6;
		color: rgba(255, 255, 255, 0.9);
	}

	/* ── OPPORTUNITIES SECTION ── */
	.opportunities-section {
		padding: 100px 0;
		background-color: #f7f9fb;
	}

	.opportunities-container {
		display: grid;
		grid-template-columns: 0.95fr 1.05fr;
		gap: 60px;
		align-items: center;
	}

	.opportunities-left {
		display: flex;
		flex-direction: column;
		gap: 24px;
	}

	.opportunities-title {
		font-size: clamp(2rem, 3.5vw, 2.75rem);
		font-weight: 800;
		color: #1e293b;
		line-height: 1.15;
	}

	.opportunities-desc {
		font-size: 1.05rem;
		color: #4b5563;
		line-height: 1.65;
	}

	.opportunities-logos {
		display: flex;
		gap: 24px;
		align-items: center;
		margin-top: 16px;
	}

	.partner-logo {
		height: 64px;
		width: auto;
		object-fit: contain;
	}

	.opportunities-right {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 24px;
		align-items: start;
	}

	.opportunities-col {
		display: flex;
		flex-direction: column;
		gap: 24px;
	}

	.opportunities-col.offset-col {
		margin-top: 40px;
	}

	.opportunity-card {
		background-color: #eef5fb;
		border-radius: 24px;
		padding: 32px;
		display: flex;
		flex-direction: column;
		gap: 12px;
		transition: transform 0.3s ease, box-shadow 0.3s ease;
	}

	.opportunity-card:hover {
		transform: translateY(-6px);
		box-shadow: 0 12px 30px rgba(59, 159, 232, 0.15);
	}

	.opportunity-card h3 {
		font-size: 1.25rem;
		font-weight: 700;
		color: #1e293b;
	}

	.opportunity-card p {
		font-size: 0.95rem;
		color: #4b5563;
		line-height: 1.6;
	}

