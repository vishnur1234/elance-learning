---
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>
			Your Learning Journey Starts Here | Courses by Elance Learning
		</title>
		<meta
			name="description"
			content="Looking to learn something new or grow your career? Elance Learning offers beginner-friendly, flexible courses designed to fit your life and goals."
		/>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,600&family=Outfit:wght@300;400;500;600;700;800;900&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<Nav />

		<!-- ===================== HERO SECTION ===================== -->
		<section class="courses-hero">
			<div class="section-container hero-inner">
				<h1 class="hero-title">
					Become a Globally Recognized <br />
					<span class="text-blue">Commerce Professional!</span>
				</h1>
				<p class="hero-desc">
					Gain the skills, credibility, and global recognition to
					excel in today's competitive business world with
					industry-relevant commerce professional courses.
				</p>

				<div class="hero-visual-wrap">
					<!-- Elance Logo Trigon Shape -->
					<img
						src="/src/Assets/3d-triangle.png"
						alt=""
						class="hero-trigon"
						aria-hidden="true"
					/>
					<!-- ACCA Pill -->
					<a href="#acca" class="course-pill-btn acca-pill">ACCA</a>
					<!-- CMA USA Pill -->
					<a href="#cma" class="course-pill-btn cma-pill">CMA USA</a>
					<!-- Brand Ambassador Centered -->
					<img
						src="/src/Assets/mammu2.png"
						alt="Brand Ambassador"
						class="hero-ambassador"
					/>
				</div>
			</div>
		</section>

		<!-- ===================== WHY CHOOSE CARD ===================== -->
		<section class="why-choose-section">
			<div class="section-container">
				<div class="choose-card">
					<div class="choose-left">
						<!-- Study Group Graphic -->
						<div class="classroom-img-wrap">
							<img
								src="/src/Assets/courses/Slider-Elance-2.jpg"
								alt="Students Studying"
								class="classroom-img"
							/>
						</div>
					</div>
					<div class="choose-right">
						<h2 class="choose-title">
							Why Choose Commerce <br />Professional Courses?
						</h2>
						<p class="choose-desc">
							The finance and business world are evolving faster
							than ever with new technologies, global standards,
							and rising industry expectations. Commerce
							professional courses are designed to equip you with
							the practical skills, strategic mindset, and
							prestigious global credentials required to excel in
							today's competitive business landscape.
						</p>
						<a href="#courses" class="btn-choose-outline"
							>Explore Programs</a
						>
					</div>
				</div>
			</div>
		</section>

		<Footer />
	</body>
</html>

<style>
	*,
	*::before,
	*::after {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	html,
	body {
		font-family: "Outfit", sans-serif;
		background: #ffffff;
		color: #212529;
		line-height: 1.6;
		overflow-x: hidden;
	}

	.section-container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 40px;
		width: 100%;
	}

	.text-blue {
		color: #1a9ee5;
	}

	/* ── HERO ── */
	.courses-hero {
		padding: 30px 0 0;
		background: #ffffff;
		position: relative;
		overflow: hidden;
	}

	.hero-inner {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
	}

	.hero-title {
		font-size: clamp(2.2rem, 4.5vw, 3.2rem);
		font-weight: 800;
		color: #1e293b;
		line-height: 1.2;
		margin-bottom: 20px;
	}

	.hero-desc {
		font-size: 1.05rem;
		color: #4b5563;
		line-height: 1.6;
		max-width: 780px;
		margin-bottom: 10px;
	}

	.hero-visual-wrap {
		position: relative;
		width: 100%;
		max-width: 720px;
		height: 520px;
		margin-top: -24px;
		display: flex;
		justify-content: center;
		align-items: flex-end;
		z-index: 10;
	}

	.hero-trigon {
		position: absolute;
		top: 7%;
		left: 50%;
		transform: translateX(-50%);
		width: 480px;
		height: auto;
		z-index: 0;
		opacity: 0.9;
	}

	.hero-ambassador {
		position: relative;
		z-index: 2;
		width: 100%;
		max-width: 650px;
		height: auto;
		object-fit: contain;
		display: block;
		margin-bottom: 40;
	}

	/* Course Pill Buttons */
	.course-pill-btn {
		position: absolute;
		z-index: 3;
		background: #ffffff;
		border: 1.5px solid #3b9fe8;
		border-radius: 100px;
		padding: 14px 44px;
		font-family: "Outfit", sans-serif;
		font-size: 16px;
		font-weight: 700;
		color: #1a9ee5;
		text-decoration: none;
		box-shadow: 0 10px 25px rgba(0, 0, 0, 0.05);
		transition: all 0.25s ease;
	}

	.course-pill-btn:hover {
		background: #1a9ee5;
		color: #ffffff;
		transform: translateY(-2px);
		box-shadow: 0 15px 30px rgba(26, 158, 229, 0.2);
	}

	.acca-pill {
		top: 42%;
		left: 4%;
	}

	.cma-pill {
		top: 45%;
		right: 4%;
	}

	/* ── WHY CHOOSE CARD ── */
	.why-choose-section {
		padding: 20px 0 80px;
		background: #ffffff;
	}

	.choose-card {
		background: url("/src/Assets/courses/Slider-Elance-2.jpg") no-repeat
			left center;
		background-size: cover;
		border-radius: 32px;
		overflow: hidden;
		display: grid;
		grid-template-columns: 1.15fr 0.85fr;
		position: relative;
		box-shadow: 0 20px 45px rgba(25, 160, 230, 0.15);
	}

	.choose-left {
		position: relative;
		display: block;
		width: 100%;
		height: 100%;
		min-height: 350px;
		overflow: hidden;
	}

	.classroom-img-wrap {
		width: 100%;
		height: 100%;
		position: relative;
		z-index: 2;
		display: none; /* Hide on desktop since background image covers card */
	}

	.classroom-img-wrap::after {
		content: "";
		position: absolute;
		top: 0;
		right: -1px;
		bottom: 0;
		width: 150px;
		background: linear-gradient(
			to right,
			rgba(25, 160, 230, 0) 0%,
			#19a0e6 100%
		);
		z-index: 3;
		pointer-events: none;
	}

	.classroom-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: left center;
		display: block;
	}

	.trigon-watermark-img {
		position: absolute;
		bottom: 0;
		left: 0;
		width: 230px;
		height: 180px;
		object-fit: cover;
		z-index: 3;
		clip-path: polygon(0 25%, 46% 25%, 95% 100%, 0 100%);
		pointer-events: none;
	}

	.choose-right {
		padding: 48px;
		display: flex;
		flex-direction: column;
		justify-content: center;
		color: #ffffff;
		z-index: 2;
	}

	.choose-title {
		font-size: 2rem;
		font-weight: 800;
		line-height: 1.25;
		margin-bottom: 16px;
	}

	.choose-desc {
		font-size: 0.95rem;
		line-height: 1.65;
		margin-bottom: 24px;
		opacity: 0.95;
	}

	.btn-choose-outline {
		text-decoration: none;
		color: #ffffff;
		border: 1.5px solid #ffffff;
		font-family: "Outfit", sans-serif;
		font-size: 14px;
		font-weight: 600;
		height: 46px;
		padding: 0 28px;
		border-radius: 100px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		transition: all 0.2s ease;
		align-self: flex-start;
	}

	.btn-choose-outline:hover {
		background: #ffffff;
		color: #19a0e6;
		transform: translateY(-2px);
	}

	/* ── RESPONSIVE ── */
	@media (max-width: 992px) {
		.courses-hero {
			padding-bottom: 40px;
		}

		.hero-visual-wrap {
			height: 390px;
			z-index: 10;
		}

		.hero-trigon {
			width: 300px;
		}

		.hero-ambassador {
			max-width: 420px;
		}

		.acca-pill {
			left: 5%;
			padding: 10px 30px;
			font-size: 14px;
		}

		.cma-pill {
			right: 5%;
			padding: 10px 30px;
			font-size: 14px;
		}

		.choose-card {
			background: linear-gradient(135deg, #19a0e6 0%, #0d82c2 100%);
			grid-template-columns: 1fr;
		}

		.choose-left {
			height: 240px;
			min-height: auto;
		}

		.classroom-img-wrap {
			display: block; /* Show on mobile stacked layout */
		}

		.classroom-img-wrap::after {
			width: 100%;
			height: 100px;
			top: auto;
			right: 0;
			bottom: 0;
			left: 0;
			background: linear-gradient(
				to bottom,
				rgba(25, 160, 230, 0) 0%,
				#19a0e6 100%
			);
		}

		.choose-right {
			padding: 32px 24px;
		}

		.choose-title {
			font-size: 1.5rem;
		}
	}
</style>
