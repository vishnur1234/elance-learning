<style>
	.section-container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 40px;
		width: 100%;
	}

	.text-blue {
		color: #1a9ee5;
	}

	.featured-section {
		padding: 80px 0;
		background: #ffffff;
		position: relative;
	}

	.featured-title {
		font-family: "Outfit", sans-serif;
		font-size: 2.5rem;
		font-weight: 800;
		text-align: center;
		color: #111827;
		margin-bottom: 16px;
		line-height: 1.25;
	}

	.featured-subtitle {
		font-size: 0.95rem;
		line-height: 1.6;
		text-align: center;
		color: #6b7280;
		max-width: 800px;
		margin: 0 auto 48px;
	}

	.featured-ticker-wrap {
		overflow: hidden;
		width: 100%;
		max-width: 100%;
		mask-image: linear-gradient(
			to right,
			transparent,
			black 15%,
			black 85%,
			transparent
		);
		-webkit-mask-image: linear-gradient(
			to right,
			transparent,
			black 15%,
			black 85%,
			transparent
		);
		margin-top: 20px;
	}

	.featured-ticker {
		display: flex;
		align-items: center;
		gap: 64px;
		width: max-content;
		animation: featured-ticker-scroll 25s linear infinite;
	}

	.featured-ticker:hover {
		animation-play-state: paused;
	}

	.featured-logo-item {
		display: flex;
		justify-content: center;
		align-items: center;
		filter: grayscale(100%);
		opacity: 0.55;
		transition:
			opacity 0.25s,
			filter 0.25s,
			transform 0.25s;
	}

	.featured-logo-item:hover {
		filter: grayscale(0%);
		opacity: 1;
		transform: translateY(-2px);
	}

	.featured-logo-img {
		max-height: 38px;
		max-width: 140px;
		object-fit: contain;
		display: block;
	}

	@keyframes featured-ticker-scroll {
		0% {
			transform: translateX(0);
		}
		100% {
			transform: translateX(-33.333%);
		}
	}

	@media (max-width: 768px) {
		.section-container {
			padding: 0 16px;
		}
		.featured-section {
			padding: 48px 0;
		}
		.featured-title {
			font-size: 1.85rem;
			margin: 0 auto 12px !important;
			text-align: center !important;
		}
		.featured-subtitle {
			font-size: 0.85rem;
			line-height: 1.5;
			margin: 0 auto 24px !important;
			padding: 0 8px;
			text-align: center !important;
			max-width: 320px !important;
		}
		.featured-ticker {
			gap: 40px;
		}
		.featured-logo-img {
			max-height: 28px;
			max-width: 110px;
		}
	}
</style>
