---
// CmaLearningAndSyllabus.astro
// Component containing the "Exceptional Elance Learning Experience" feature grid
// and the "Course Syllabus" accordion section for CMA USA.

interface Props {
	entry?: { data?: Record<string, any>; edit?: Record<string, any> } | null;
}
const { entry } = Astro.props as Props;
const data = entry?.data || {};
const edit = entry?.edit || ({} as Record<string, any>);

const learningTitle = String(
	data.learning_title ||
		'<strong>Exceptional</strong> <span class="text-blue">Elance Learning<br />Experience!</span>',
);

const FEATURE_DEFAULTS = [
	{ title: "World Class Faculties", desc: "Elance is distinguished by its exceptional faculty of experts, guaranteeing effective teaching methods. We take pride in providing exceptional guidance and support to our students through every aspect of their courses." },
	{ title: "Excellent Learning Experience", desc: "Elance offers a calm campus where students can learn peacefully from expert teachers. We also focus on co-curricular activities that support personal and social development." },
	{ title: "Holistic Guidance", desc: "At Elance, students don't have to rely solely on faculty. They also receive support from top-ranked mentors, coordinators, and a learning app, creating a complete ecosystem for comprehensive preparation." },
	{ title: "Hands on Approach", desc: "With a hands-on approach to learning, Elance provides opportunities for practical application, allowing you to reinforce your understanding and develop practical skills that employers value." },
	{ title: "Top-Tier Placement Assistance", desc: "Elance prepares students not just for the industry but equips them with essential skills for excellence. Our focus ensures they are ready for successful placements and stand out as professionals." },
	{ title: "Astonishing Infrastructure", desc: "At Elance, every student receives personalized attention to gain an edge in professional commerce exams. Our campuses offer an integrated learning approach supported by advanced technology and top-notch facilities." },
	{ title: "Accessibility from Anywhere Anytime", desc: "Our learning app allows students to study anytime, anywhere. By offering comprehensive resources for their courses, the Elance Learning App simplifies their educational experience." },
	{ title: "Hostel & Transportation Facility", desc: "We at Elance offers convenient hostel facilities and reliable transportation services, ensuring students enjoy a safe, comfortable, and hassle-free learning journey tailored to their needs." },
];
const features = FEATURE_DEFAULTS.map((fallback, i) => {
	const n = i + 1;
	return {
		title: String(data[`feature_${n}_title`] || fallback.title),
		desc: String(data[`feature_${n}_desc`] || fallback.desc),
		editTitle: edit[`feature_${n}_title`],
		editDesc: edit[`feature_${n}_desc`],
	};
});

const syllabusTitle = String(
	data.syllabus_title || '<span class="text-blue">Course</span> Syllabus',
);
const syllabusDesc = String(
	data.syllabus_desc ||
		"The US CMA certification consists of two exam parts, testing critical management accounting and financial planning skills. Each part is tested via a 4-hour exam containing 100 MCQs and 2 scenario-based essay questions.",
);

const SYLLABUS_DEFAULTS = [
	{
		label: "Part 1: Financial Planning, Performance, and Analytics",
		intro: "Part 1 of the US CMA program covers the critical internal operations of financial control, budgeting, forecasting, cost management, internal controls, and technology/analytics.",
		checklist: "Planning, Budgeting, and Forecasting (20%)\nPerformance Management (20%)\nExternal Financial Reporting Decisions (15%)\nCost Management (15%)\nInternal Controls (15%)\nTechnology and Analytics (15%)",
	},
	{
		label: "Part 2: Strategic Financial Management",
		intro: "Part 2 focuses on strategic corporate finance decisions, financial statement analysis, risk management, investment decisions, decision analysis, and professional ethics.",
		checklist: "Decision Analysis (25%)\nFinancial Statement Analysis (20%)\nCorporate Finance (20%)\nProfessional Ethics (15%)\nRisk Management (10%)\nInvestment Decisions (10%)",
	},
];
const syllabusItems = SYLLABUS_DEFAULTS.map((fallback, i) => {
	const n = i + 1;
	const checklistText = String(data[`syllabus_${n}_checklist`] || fallback.checklist);
	return {
		label: String(data[`syllabus_${n}_label`] || fallback.label),
		intro: String(data[`syllabus_${n}_intro`] || fallback.intro),
		checklist: checklistText.split("\n").map((s) => s.trim()).filter(Boolean),
		editLabel: edit[`syllabus_${n}_label`],
		editIntro: edit[`syllabus_${n}_intro`],
		editChecklist: edit[`syllabus_${n}_checklist`],
	};
});
---

<!-- ===================== EXCEPTIONAL LEARNING EXPERIENCE SECTION ===================== -->
<section class="learning-section">
	<div class="learning-container">
		<h2 class="learning-title" set:html={learningTitle} {...edit.learning_title} />

		<div class="features-grid">
			{features.map((f) => (
				<div class="feature-card">
					<h3 class="feature-title" {...f.editTitle}>{f.title}</h3>
					<p class="feature-desc" {...f.editDesc}>
						{f.desc}
					</p>
				</div>
			))}
		</div>
	</div>
</section>

<!-- ===================== COURSE SYLLABUS SECTION ===================== -->
<section class="syllabus-section">
	<div class="syllabus-container">
		<h2 class="syllabus-title" set:html={syllabusTitle} {...edit.syllabus_title} />
		<p class="syllabus-desc" {...edit.syllabus_desc}>
			{syllabusDesc}
		</p>

		<div class="syllabus-accordion">
			{syllabusItems.map((item, i) => (
				<div class:list={["syllabus-item", { active: i === 0 }]} id={`syllabus-${i + 1}`}>
					<button class="syllabus-header" aria-expanded={i === 0 ? "true" : "false"}>
						<span class="syllabus-icon">
							<svg class="icon-minus" viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2.5" fill="none">
								<line x1="5" y1="12" x2="19" y2="12"></line>
							</svg>
							<svg class="icon-plus" viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2.5" fill="none">
								<line x1="12" y1="5" x2="12" y2="19"></line>
								<line x1="5" y1="12" x2="19" y2="12"></line>
							</svg>
						</span>
						<span class="syllabus-label" {...item.editLabel}>{item.label}</span>
					</button>
					<div class="syllabus-content">
						<p {...item.editIntro}>
							{item.intro}
						</p>
						<ul class="syllabus-checklist" {...item.editChecklist}>
							{item.checklist.map((line) => (
								<li>
									<span class="check-icon">✔</span>
									{line}
								</li>
							))}
						</ul>
					</div>
				</div>
			))}
		</div>
	</div>
</section>

<script>
	const syllabusHeaders = document.querySelectorAll(".syllabus-header");

	syllabusHeaders.forEach((header) => {
		header.addEventListener("click", () => {
			const currentItem = header.parentElement;
			if (!currentItem) return;

			const isActive = currentItem.classList.contains("active");

			// Collapse all
			document.querySelectorAll(".syllabus-item").forEach((item) => {
				item.classList.remove("active");
				const h = item.querySelector(".syllabus-header");
				if (h) h.setAttribute("aria-expanded", "false");
			});

			// Expand clicked if it wasn't open
			if (!isActive) {
				currentItem.classList.add("active");
				header.setAttribute("aria-expanded", "true");
			}
		});
	});
</script>

<style>
	/* ── SHARED ── */
	.text-blue {
		color: #3b9fe8;
	}

	/* ── EXCEPTIONAL LEARNING EXPERIENCE ── */
	.learning-section {
		padding: 72px 0 80px;
		background-color: #ffffff; /* White background matching screenshots */
		width: 100%;
	}

	.learning-container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 40px;
		width: 100%;
		box-sizing: border-box;
	}

	.learning-title {
		font-size: clamp(1.8rem, 3.5vw, 2.8rem);
		font-weight: 400;
		color: #1e293b;
		margin: 0 0 48px 0;
		line-height: 1.2;
		font-family: "Outfit", sans-serif;
	}

	.learning-title strong {
		font-weight: 800;
		color: #1e293b;
	}

	/* 2-column feature card grid */
	.features-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 24px;
		max-width: 680px; /* cards sit left like screenshot */
	}

	.feature-card {
		background: #ffffff;
		border: 1px solid #bae6fd; /* light blue border matching contact form fields */
		border-radius: 16px;
		padding: 28px 28px 32px;
		text-align: left;
		transition: box-shadow 0.2s ease, transform 0.2s ease;
	}

	.feature-card:hover {
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
		transform: translateY(-2px);
	}

	.feature-title {
		font-size: 0.95rem;
		font-weight: 800;
		color: #0f172a;
		margin: 0 0 14px 0;
		font-family: "Outfit", sans-serif;
	}

	.feature-desc {
		font-size: 0.9rem;
		line-height: 1.65;
		color: #374151;
		margin: 0;
	}

	/* ── COURSE SYLLABUS ── */
	.syllabus-section {
		padding: 72px 0 100px;
		background-color: #ffffff; /* White background matching screenshots */
		width: 100%;
	}

	.syllabus-container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 40px;
		width: 100%;
		box-sizing: border-box;
	}

	.syllabus-title {
		font-size: clamp(2rem, 3.5vw, 3rem);
		font-weight: 800;
		color: #1e293b;
		margin: 0 0 20px 0;
		font-family: "Outfit", sans-serif;
	}

	.syllabus-desc {
		font-size: 0.95rem;
		line-height: 1.7;
		color: #374151;
		max-width: 640px;
		margin: 0 0 48px 0;
	}

	/* Accordion */
	.syllabus-accordion {
		max-width: 640px;
		display: flex;
		flex-direction: column;
	}

	.syllabus-item {
		border-bottom: 1px solid #e2e8f0;
		padding: 8px 0;
	}

	.syllabus-header {
		width: 100%;
		background: none;
		border: none;
		display: flex;
		align-items: center;
		gap: 20px;
		text-align: left;
		cursor: pointer;
		padding: 14px 0;
		color: #1e293b;
		transition: color 0.2s ease;
	}

	.syllabus-icon {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		border-radius: 50%;
		border: 1.5px solid #cbd5e1;
		color: #475569;
		flex-shrink: 0;
		transition: all 0.25s ease;
		background: #ffffff;
	}

	/* Plus/minus icon switch */
	.syllabus-icon .icon-minus {
		display: none;
	}
	.syllabus-icon .icon-plus {
		display: block;
	}

	.syllabus-item.active .syllabus-icon {
		background-color: #cbd5e1;
		border-color: #cbd5e1;
		color: #0f172a;
	}
	.syllabus-item.active .syllabus-icon .icon-minus {
		display: block;
	}
	.syllabus-item.active .syllabus-icon .icon-plus {
		display: none;
	}

	.syllabus-label {
		font-size: 1.05rem;
		font-weight: 700;
		font-family: "Outfit", sans-serif;
		color: #1e293b;
	}

	/* Accordion content */
	.syllabus-content {
		max-height: 0;
		overflow: hidden;
		transition: max-height 0.35s cubic-bezier(0, 1, 0, 1);
		padding-left: 56px;
	}

	.syllabus-item.active .syllabus-content {
		max-height: 800px;
		transition: max-height 0.4s cubic-bezier(0.85, 0, 0.15, 1);
	}

	.syllabus-content p {
		margin: 16px 0;
		font-size: 0.95rem;
		line-height: 1.7;
		color: #374151;
	}

	/* Checklist items with blue tick */
	.syllabus-checklist {
		list-style: none;
		padding: 0;
		margin: 8px 0 16px 0;
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.syllabus-checklist li {
		display: flex;
		align-items: flex-start;
		gap: 10px;
		font-size: 0.95rem;
		color: #374151;
		font-weight: 500;
	}

	.check-icon {
		color: #3b9fe8;
		font-size: 0.85rem;
		flex-shrink: 0;
		margin-top: 2px;
	}

	/* Responsive */
	@media (max-width: 768px) {
		.features-grid {
			grid-template-columns: 1fr;
			max-width: 100%;
		}
		.learning-title {
			margin-bottom: 36px;
		}
		.learning-section,
		.syllabus-section {
			padding: 56px 0;
		}
	}

	@media (max-width: 480px) {
		.learning-container,
		.syllabus-container {
			padding: 0 20px;
		}
		.feature-card {
			padding: 22px;
		}
		.syllabus-content {
			padding-left: 30px;
		}
	}
</style>
