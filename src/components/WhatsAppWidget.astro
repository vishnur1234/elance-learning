---
// WhatsAppWidget.astro
// Floating WhatsApp widget matching the screenshot layout exactly.
// Slide-in left-to-right on page load. Slide-out to the right offscreen when closed.
---

<div class="wa-widget-container" id="wa-widget">
	<!-- Close Button (Leftmost) -->
	<button class="wa-close-btn" id="wa-close" aria-label="Close widget">
		<svg
			viewBox="0 0 24 24"
			width="12"
			height="12"
			fill="none"
			stroke="#475569"
			stroke-width="3"
			stroke-linecap="round"
			stroke-linejoin="round"
		>
			<line x1="18" y1="6" x2="6" y2="18"></line>
			<line x1="6" y1="6" x2="18" y2="18"></line>
		</svg>
	</button>

	<!-- Chat Bubble (Middle) -->
	<div class="wa-chat-bubble" id="wa-bubble">
		<p class="wa-chat-text">
			Hey there! Got a question?<br />We're just a message away!
		</p>
		<div class="wa-bubble-arrow"></div>
	</div>

	<!-- WhatsApp Button (Rightmost, Square) -->
	<a
		href="https://wa.me/919895097070"
		target="_blank"
		rel="noopener noreferrer"
		class="wa-btn"
		id="wa-link"
		aria-label="Chat on WhatsApp"
	>
		<img
			src="/images/gallery/hero_noti_profile-150x150.png"
			alt="WhatsApp"
			class="wa-icon"
		/>
		<span class="wa-badge">3</span>
	</a>
</div>

<style>
	.wa-widget-container {
		position: fixed;
		bottom: 30px;
		right: 30px;
		z-index: 99999;
		display: flex;
		flex-direction: row;
		align-items: center;
		gap: 12px;
		font-family: "Outfit", "Inter", sans-serif;
		pointer-events: none;

		/* Initial state: Hidden and translated to the left (preparing left-to-right slide entry) */
		opacity: 0;
		transform: translateX(-150px);
		transition:
			transform 1.2s cubic-bezier(0.19, 1, 0.22, 1),
			opacity 1.2s cubic-bezier(0.19, 1, 0.22, 1);
	}

	.wa-close-btn,
	.wa-chat-bubble,
	.wa-btn {
		pointer-events: auto;
	}

	/* Show state: Slides in from left to right to its normal position */
	.wa-widget-container.show {
		opacity: 1;
		transform: translateX(0);
	}

	/* Hide state: Slides off-screen to the right side */
	.wa-widget-container.hide {
		opacity: 0;
		transform: translateX(450px) !important;
	}

	/* Close Button (Circular grey/blue button on left) */
	.wa-close-btn {
		width: 26px;
		height: 26px;
		border-radius: 50%;
		background: #e2e8f0;
		border: none;
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
		transition:
			background 0.2s,
			transform 0.15s;
		flex-shrink: 0;
	}

	.wa-close-btn:hover {
		background: #cbd5e1;
		transform: scale(1.08);
	}

	/* Chat Bubble */
	.wa-chat-bubble {
		position: relative;
		background: #ffffff;
		border-radius: 8px;
		padding: 12px 18px;
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
		border: 1px solid #f1f5f9;
	}

	.wa-chat-text {
		font-size: 14px;
		font-family: "Outfit", sans-serif;
		font-weight: 400;
		color: #111827;
		line-height: 1.45;
		margin: 0;
		white-space: nowrap;
	}

	/* Right-pointing arrow pointer on the bubble */
	.wa-bubble-arrow {
		position: absolute;
		top: 50%;
		right: -6px;
		transform: translateY(-50%);
		width: 0;
		height: 0;
		border-top: 6px solid transparent;
		border-bottom: 6px solid transparent;
		border-left: 6px solid #ffffff;
	}

	/* WhatsApp Button (Square with slight rounded corners) */
	.wa-btn {
		position: relative;
		width: 54px;
		height: 54px;
		border-radius: 6px;
		box-shadow: 0 4px 14px rgba(34, 197, 94, 0.2);
		transition: transform 0.2s;
		flex-shrink: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		background: #22c55e;
	}

	.wa-btn:hover {
		transform: scale(1.05);
	}

	.wa-icon {
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 6px;
		display: block;
	}

	/* Blue Badge with notification count */
	.wa-badge {
		position: absolute;
		top: -8px;
		right: -8px;
		background: #3b9fe8;
		color: #ffffff;
		font-size: 0.72rem;
		font-weight: 800;
		width: 20px;
		height: 20px;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		border: 2px solid #ffffff;
		box-shadow: 0 2px 6px rgba(59, 159, 232, 0.3);
	}

	@media (max-width: 600px) {
		.wa-widget-container {
			bottom: 20px;
			right: 20px;
			gap: 8px;
		}
		.wa-chat-bubble {
			padding: 10px 14px;
		}
		.wa-chat-text {
			font-size: 0.85rem;
		}
		.wa-btn {
			width: 48px;
			height: 48px;
		}
	}
</style>

<script>
	const widget = document.getElementById("wa-widget");
	const closeBtn = document.getElementById("wa-close");

	if (widget) {
		// Slides left to right into view on page load
		setTimeout(() => {
			widget.classList.add("show");
		}, 600);
	}

	// Close action slides out to the right, then completely hides
	if (closeBtn && widget) {
		closeBtn.addEventListener("click", (e) => {
			e.preventDefault();
			e.stopPropagation();

			// Slide out to the right
			widget.classList.add("hide");

			// Set display: none after transition finishes (1200ms)
			setTimeout(() => {
				widget.style.display = "none";
			}, 1200);
		});
	}
</script>
