---
// AccaFaculties.astro
// Component representing the "Our ACCA Faculties" carousel section.
---

<section class="faculties-section">
	<div class="faculties-container">
		<h2 class="faculties-title">
			Our <span class="text-blue">ACCA</span> Faculties
