</section>

<script>
	const track = document.getElementById("faculty-track");
	const prevBtn = document.getElementById("prev-faculty");
	const nextBtn = document.getElementById("next-faculty");

	if (track && prevBtn && nextBtn) {
		const cardWidth = 220 + 20; // card width + gap
		prevBtn.addEventListener("click", () => {
			track.scrollBy({ left: -cardWidth, behavior: "smooth" });
		});
		nextBtn.addEventListener("click", () => {
			track.scrollBy({ left: cardWidth, behavior: "smooth" });
		});
	}
</script>

<style>
	.faculties-section {
		padding: 60px 0 80px;
		background-color: #f0f4f8;
		width: 100%;
	}

	.faculties-container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 40px;
		width: 100%;
		box-sizing: border-box;
	}

	.faculties-title {
		font-size: clamp(1.8rem, 3vw, 2.6rem);
		font-weight: 800;
		color: #1e293b;
		margin: 0 0 36px 0;
		font-family: "Outfit", sans-serif;
	}

	.text-blue {
		color: #3b9fe8;
	}

	/* Carousel wrapper */
	.carousel-wrapper {
		position: relative;
		width: 100%;
	}

	.faculty-track-container {
		overflow: hidden;
		width: 100%;
		/* add side padding so cards near edges aren't fully cut */
		padding: 4px 0;
	}

	.faculty-track {
		display: flex;
		gap: 20px;
		overflow-x: auto;
		scroll-behavior: smooth;
		scroll-snap-type: x mandatory;
		padding-bottom: 8px;
		/* hide scrollbar */
		scrollbar-width: none;
		-ms-overflow-style: none;
	}

	.faculty-track::-webkit-scrollbar {
		display: none;
	}

	/* Faculty Card */
	.faculty-card {
		flex: 0 0 220px;
		scroll-snap-align: start;
		background: #ffffff;
		border-radius: 0;
		overflow: hidden;
		box-shadow:
			0 4px 16px rgba(0, 0, 0, 0.04),
			0 1px 4px rgba(0, 0, 0, 0.02);
		border: 1px solid rgba(0, 0, 0, 0.04);
		transition: transform 0.25s ease, box-shadow 0.25s ease;
	}

	.faculty-card:hover {
		transform: translateY(-4px);
		box-shadow: 0 14px 30px rgba(0, 0, 0, 0.08);
	}

	/* Photo area */
	.faculty-photo-wrap {
		width: 100%;
		height: 200px;
		overflow: hidden;
		position: relative;
		background: linear-gradient(135deg, #cce8fa 0%, #a0d4f5 100%);
	}

	.faculty-photo {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top center;
		display: block;
		transition: transform 0.3s ease;
	}

	.faculty-card:hover .faculty-photo {
		transform: scale(1.04);
	}

	/* Info section */
	.faculty-info {
		padding: 16px 18px 18px;
		position: relative;
		text-align: left;
	}

	/* LinkedIn icon badge - top-left of info section */
	.faculty-linkedin {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 32px;
		height: 32px;
		background: #e8f4fd;
		border-radius: 6px;
		margin-bottom: 10px;
		cursor: pointer;
		transition: background 0.2s ease;
	}

	.faculty-linkedin:hover {
		background: #bae6fd;
	}

	.faculty-name {
		font-size: 1.1rem;
		font-weight: 700;
		color: #0f172a;
		margin: 0 0 4px 0;
		font-family: "Outfit", sans-serif;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.faculty-qual {
		font-size: 0.85rem;
		font-weight: 600;
		color: #64748b;
		margin: 0;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	/* Arrow buttons - positioned at vertical center of photo area */
	.faculty-btn {
		position: absolute;
		top: calc(100px); /* middle of 200px photo */
		transform: translateY(-50%);
		width: 44px;
		height: 44px;
		border-radius: 50%;
		background: #3b9fe8;
		border: none;
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
		color: #ffffff;
		z-index: 10;
		box-shadow: 0 4px 14px rgba(59, 159, 232, 0.3);
		transition: all 0.25s ease;
	}

	.faculty-btn:hover {
		background: #2563eb;
		box-shadow: 0 6px 18px rgba(37, 99, 235, 0.35);
		transform: translateY(-50%) scale(1.06);
	}

	.btn-left {
		left: -22px;
	}

	.btn-right {
		right: -22px;
	}

	/* Responsive */
	@media (max-width: 992px) {
		.btn-left,
		.btn-right {
			display: none; /* native swipe on mobile */
		}
		.faculty-card {
			flex: 0 0 200px;
		}
	}

	@media (max-width: 600px) {
		.faculties-section {
			padding: 48px 0 60px;
		}
		.faculties-container {
			padding: 0 20px;
		}
		.faculty-card {
			flex: 0 0 180px;
		}
		.faculty-photo-wrap {
			height: 170px;
		}
	}
</style>
