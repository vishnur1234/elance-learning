					viewBox="0 0 24 24"
					width="18"
					height="18"
					stroke="currentColor"
					stroke-width="2.5"
					fill="none"
					stroke-linecap="round"
					stroke-linejoin="round"
				>
					<line x1="5" y1="12" x2="19" y2="12"></line>
