---
// CmaFaculties.astro
// Component representing the "Our CMA Faculties" carousel section.
import { getCmsImageUrl } from "../utils/media.js";

interface Props {
	entry?: { data?: Record<string, any>; edit?: Record<string, any> } | null;
}
const { entry } = Astro.props as Props;
const data = entry?.data || {};
const edit = entry?.edit || ({} as Record<string, any>);

const facultiesTitle = String(
	data.faculties_title || 'Our <span class="text-blue">CMA</span> Faculties',
);

const FACULTY_DEFAULTS = [
	{ name: "Hijas Hashim", qual: "CMA, M COM", photo: "/images/cmaFaculty/Faculty_CMA-USA-Website-Template-01-1024x768-1.jpg" },
	{ name: "Sangeetha Ajit", qual: "CFA, CMA", photo: "/images/cmaFaculty/Faculty_CMA-USA-Website-Template-02-1024x768-1.jpg" },
	{ name: "Mohamed safeeque Ali", qual: "CMA, M.com", photo: "/images/cmaFaculty/Faculty_CMA-USA-Website-Template-03-1024x768-1.jpg" },
	{ name: "Mithun Roy", qual: "CMA", photo: "/images/cmaFaculty/Faculty_CMA-USA-Website-Template-05-1024x768-1.jpg" },
	{ name: "M. Nihad Jaseen", qual: "CMA Qualified", photo: "/images/cmaFaculty/Faculty_CMA-USA-Website-Template-06-1024x768-1.jpg" },
	{ name: "Rahul RS", qual: "ACCA", photo: "/images/cmaFaculty/Faculty-Website-Template-11-1024x768-1.jpg" },
	{ name: "Junaid KP", qual: "CMA", photo: "/images/cmaFaculty/Junaid-KP-Faculty-Website-Template-16.jpg" },
];
const faculties = FACULTY_DEFAULTS.map((fallback, i) => {
	const n = i + 1;
	return {
		name: String(data[`faculty_${n}_name`] || fallback.name),
		qual: String(data[`faculty_${n}_qual`] || fallback.qual),
		photo: getCmsImageUrl(data[`faculty_${n}_photo`], fallback.photo),
		editName: edit[`faculty_${n}_name`],
		editQual: edit[`faculty_${n}_qual`],
		editPhoto: edit[`faculty_${n}_photo`],
	};
});
---

<section class="faculties-section">
	<div class="faculties-container">
		<h2 class="faculties-title" set:html={facultiesTitle} {...edit.faculties_title} />

		<div class="carousel-wrapper">
			<!-- Left Arrow Button -->
			<button
				class="faculty-btn btn-left"
				id="prev-cma-faculty"
				aria-label="Previous Faculty"
			>
				<svg
					viewBox="0 0 24 24"
					width="18"
					height="18"
					stroke="currentColor"
					stroke-width="2.5"
					fill="none"
					stroke-linecap="round"
					stroke-linejoin="round"
				>
					<line x1="19" y1="12" x2="5" y2="12"></line>
					<polyline points="12 19 5 12 12 5"></polyline>
				</svg>
			</button>

			<div class="faculty-track-container">
				<div class="faculty-track" id="cma-faculty-track">

					{faculties.map((f) => (
						<div class="faculty-card">
							<div class="faculty-photo-wrap">
								<img
									src={f.photo}
									alt={f.name}
									class="faculty-photo"
									{...f.editPhoto}
								/>
							</div>
							<div class="faculty-info">
								<div class="faculty-header-row">
									<h3 class="faculty-name" {...f.editName}>{f.name}</h3>
									<div class="faculty-linkedin">
										<svg
											viewBox="0 0 24 24"
											width="18"
											height="18"
											fill="#0a66c2"
										>
											<path
												d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
											></path>
										</svg>
									</div>
								</div>
								<p class="faculty-qual" {...f.editQual}>{f.qual}</p>
							</div>
						</div>
					))}

				</div>
			</div>

			<!-- Right Arrow Button -->
			<button
				class="faculty-btn btn-right"
				id="next-cma-faculty"
				aria-label="Next Faculty"
			>
				<svg
					viewBox="0 0 24 24"
					width="18"
					height="18"
					stroke="currentColor"
					stroke-width="2.5"
					fill="none"
					stroke-linecap="round"
					stroke-linejoin="round"
				>
					<line x1="5" y1="12" x2="19" y2="12"></line>
					<polyline points="12 5 19 12 12 19"></polyline>
				</svg>
			</button>
		</div>
	</div>
</section>

<script>
	const track = document.getElementById("cma-faculty-track");
	const prevBtn = document.getElementById("prev-cma-faculty");
	const nextBtn = document.getElementById("next-cma-faculty");

	if (track && prevBtn && nextBtn) {
		const cardWidth = 220 + 20; // card width + gap
		prevBtn.addEventListener("click", () => {
			track.scrollBy({ left: -cardWidth, behavior: "smooth" });
		});
		nextBtn.addEventListener("click", () => {
			track.scrollBy({ left: cardWidth, behavior: "smooth" });
		});
	}
</script>

<style>
	.faculties-section {
		padding: 60px 0 80px;
		background-color: #ffffff; /* White background matching screenshot */
		width: 100%;
	}

	.faculties-container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 40px;
		width: 100%;
		box-sizing: border-box;
	}

	.faculties-title {
		font-size: clamp(2rem, 3.8vw, 3rem);
		font-weight: 800;
		color: #1e293b;
		margin: 0 0 40px 0;
		font-family: "Outfit", sans-serif;
	}

	.text-blue {
		color: #3b9fe8;
	}

	/* Carousel wrapper */
	.carousel-wrapper {
		position: relative;
		width: 100%;
	}

	.faculty-track-container {
		overflow: hidden;
		width: 100%;
		padding: 4px 0;
	}

	.faculty-track {
		display: flex;
		gap: 20px;
		overflow-x: auto;
		scroll-behavior: smooth;
		scroll-snap-type: x mandatory;
		padding-bottom: 8px;
		/* hide scrollbar */
		scrollbar-width: none;
		-ms-overflow-style: none;
	}

	.faculty-track::-webkit-scrollbar {
		display: none;
	}

	/* Faculty Card */
	.faculty-card {
		flex: 0 0 220px;
		scroll-snap-align: start;
		background: #ffffff;
		border-radius: 8px;
		overflow: hidden;
		box-shadow:
			0 10px 30px rgba(0, 0, 0, 0.03),
			0 1px 4px rgba(0, 0, 0, 0.01);
		border: 1px solid rgba(0, 0, 0, 0.05);
		transition:
			transform 0.25s ease,
			box-shadow 0.25s ease;
	}

	.faculty-card:hover {
		transform: translateY(-4px);
		box-shadow: 0 14px 30px rgba(0, 0, 0, 0.08);
	}

	/* Photo area */
	.faculty-photo-wrap {
		width: 100%;
		height: 200px;
		overflow: hidden;
		position: relative;
		background: linear-gradient(135deg, #cce8fa 0%, #a0d4f5 100%);
	}

	.faculty-photo {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top center;
		display: block;
		transition: transform 0.3s ease;
	}

	.faculty-card:hover .faculty-photo {
		transform: scale(1.04);
	}

	/* Info section */
	.faculty-info {
		padding: 16px 18px 18px;
		position: relative;
		text-align: left;
		border-top: 1px solid rgba(0, 0, 0, 0.03);
	}

	.faculty-header-row {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 4px;
		gap: 8px;
	}

	.faculty-name {
		font-size: 1rem;
		font-weight: 800;
		color: #0f172a;
		margin: 0;
		font-family: "Outfit", sans-serif;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.faculty-linkedin {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 18px;
		height: 18px;
		cursor: pointer;
		flex-shrink: 0;
	}

	.faculty-qual {
		font-size: 0.85rem;
		font-weight: 600;
		color: #64748b;
		margin: 0;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	/* Arrow buttons - light blue circle with dark blue arrow icon */
	.faculty-btn {
		position: absolute;
		top: 50%;
		transform: translateY(-50%);
		width: 44px;
		height: 44px;
		border-radius: 50%;
		background: #bae6fd; /* light blue */
		border: none;
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
		color: #3b9fe8; /* blue icon color */
		z-index: 10;
		transition: all 0.25s ease;
		box-shadow: 0 4px 10px rgba(0, 0, 0, 0.05);
	}

	.faculty-btn:hover {
		background: #7dd3fc;
		color: #0284c7;
		transform: translateY(-50%) scale(1.06);
	}

	.btn-left {
		left: -22px;
	}

	.btn-right {
		right: -22px;
	}

	/* Responsive */
	@media (max-width: 992px) {
		.btn-left,
		.btn-right {
			display: none; /* native swipe on mobile */
		}
		.faculty-card {
			flex: 0 0 200px;
		}
	}

	@media (max-width: 600px) {
		.faculties-section {
			padding: 48px 0 60px;
		}
		.faculties-container {
			padding: 0 20px;
		}
		.faculty-card {
			flex: 0 0 180px;
		}
		.faculty-photo-wrap {
			height: 170px;
		}
	}
</style>
