                        <a href="/kannurcenter" class="dropdown-item">Kannur</a>
                    </div>
                </li>
                <li class="has-dropdown">
                    <a href="#" class="nav-link">
                        About Us
                        <svg
                            class="chevron"
                            viewBox="0 0 24 24"
                            fill="none"
                            xmlns="http://www.w3.org/2000/svg"
                        >
                            <path
                                d="M6 9l6 6 6-6"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"></path>
                        </svg>
                    </a>

                    <div class="dropdown-menu">
                        <a href="/about" class="dropdown-item">About</a>
                        <a href="/gallery" class="dropdown-item">Gallery</a>
                        <a href="/hiringpartners" class="dropdown-item"
                            >Our Hiring Partners</a
                        >
                    </div>
                </li>
                <li><a href="/contact" class="nav-link">Contact Us</a></li>
            </ul>
        </div>

        <!-- CTA -->
        <a
            href="https://api.whatsapp.com/send?phone=917025107070&text=Hi%20from%20website"
            target="_blank"
