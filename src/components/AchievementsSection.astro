---
// AchievementsSection.astro
// Component representing the Achievements section with the two blue gradient cards.

interface Props {
	entry?: { data?: Record<string, any>; edit?: Record<string, any> } | null;
}
const { entry } = Astro.props as Props;
const data = entry?.data || {};
const edit = entry?.edit || ({} as Record<string, any>);

const achievementsTitle = String(data.achievements_title || "Achievements");
const achievementsSubtitle = String(
	data.achievements_subtitle ||
		"With immense pride, we underscore our outstanding results, a testament to Elance's legacy since its inception. In just four years, Elance has consistently delivered unmatched results, guiding students towards their dream careers as top-class commerce professionals. These achievements aren't just milestones; they represent our unwavering dedication to nurturing the future leaders of the industry.",
);

const ACHIEVEMENT_DEFAULTS = [
	{ num: "53", label: "World Ranks" },
	{ num: "80", label: "National Ranks" },
];
const achievements = ACHIEVEMENT_DEFAULTS.map((fallback, i) => {
	const n = i + 1;
	return {
		num: String(data[`achievement_${n}_num`] || fallback.num),
		label: String(data[`achievement_${n}_label`] || fallback.label),
		editNum: edit[`achievement_${n}_num`],
		editLabel: edit[`achievement_${n}_label`],
	};
});
---

<section class="achievements-section">
	<div class="section-container">
		<h2 class="achievements-title" {...edit.achievements_title}>{achievementsTitle}</h2>
		<p class="achievements-subtitle" {...edit.achievements_subtitle}>
			{achievementsSubtitle}
		</p>
		<div class="achievements-grid">
			{achievements.map((a, i) => (
				<div class={`achievement-card ${i === 0 ? "blue-grad-1" : "blue-grad-2"}`}>
					<div class="achievement-shine"></div>
					<div class="achievement-num" {...a.editNum}>{a.num}</div>
					<div class="achievement-label" {...a.editLabel}>{a.label}</div>
				</div>
			))}
		</div>
	</div>
</section>

<style>
	.achievements-section {
		padding: 80px 0 100px;
		background-color: #e6f0fa; /* soft light blue matching the screenshot */
		position: relative;
		width: 100%;
	}

	.section-container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 40px;
		width: 100%;
		box-sizing: border-box;
	}

	.achievements-title {
		font-size: clamp(2rem, 3.5vw, 3rem);
		font-weight: 800;
		text-align: center;
		color: #1e293b;
		margin-bottom: 24px;
		font-family: "Outfit", sans-serif;
	}

	.achievements-subtitle {
		font-size: 0.95rem;
		line-height: 1.8;
		text-align: center;
		color: #4b5563;
		max-width: 900px;
		margin: 0 auto 56px;
	}

	.achievements-grid {
		display: flex;
		gap: 32px;
		justify-content: center;
		align-items: center;
		max-width: 720px;
		margin: 0 auto;
		width: 100%;
	}

	.achievement-card {
		position: relative;
		overflow: hidden;
		border-radius: 24px; /* rounded edges exactly like screenshot */
		padding: 48px 40px;
		text-align: center;
		flex: 1;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		min-height: 240px;
		box-shadow: 0 15px 35px rgba(0, 0, 0, 0.08);
		transition:
			transform 0.25s,
			box-shadow 0.25s;
	}

	.achievement-card:hover {
		transform: translateY(-3px);
		box-shadow: 0 18px 40px rgba(0, 0, 0, 0.12);
	}

	.blue-grad-1 {
		background: linear-gradient(135deg, #4086bf 0%, #1e528b 100%);
	}

	.blue-grad-2 {
		background: linear-gradient(135deg, #1d4d80 0%, #5d97cc 100%);
	}

	.achievement-shine {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: linear-gradient(
			135deg,
			rgba(255, 255, 255, 0.22) 0%,
			rgba(255, 255, 255, 0) 60%
		);
		pointer-events: none;
		z-index: 1;
	}

	.achievement-num {
		font-size: 5.5rem;
		font-weight: 800;
		color: #ffffff;
		line-height: 1.1;
		margin-bottom: 8px;
		font-family: "Inter", sans-serif;
		letter-spacing: -1px;
		position: relative;
		z-index: 2;
	}

	.achievement-label {
		font-size: 1.25rem;
		font-weight: 700;
		color: #ffffff;
		opacity: 0.95;
		letter-spacing: 0.5px;
		position: relative;
		z-index: 2;
		font-family: "Outfit", sans-serif;
	}

	/* Responsive overrides */
	@media (max-width: 768px) {
		.achievements-grid {
			flex-direction: column;
			gap: 20px;
		}
		.achievement-card {
			width: 100%;
			min-height: 200px;
			padding: 36px 20px;
		}
		.achievement-num {
			font-size: 4.5rem;
		}
		.achievements-section {
			padding: 60px 0;
		}
		.achievements-subtitle {
			margin-bottom: 36px;
		}
	}
</style>
